pub fn u_127() -> i64 {
    let Buf = std.arraybuf.ArrayBuf(S_127);
    let mut items = Buf.new();
    items.push(S_127 { a: 127, b: 2 });
    let head = items.get_or(0, S_127 { a: 0, b: 0 });
    return head.a + head.b;
}
