// Comprehensive runtime test
fn get_unit() -> () {
    // Function that returns unit
}

fn divide_safe(a: i64, b: i64) -> i64 {
    a / b  // Will exit with code 250 if b is 0
}

fn main() -> i64 {
    // Test all println functions
    println_i64(1234567890);
    let neg: i64 = 0;
    let one: i64 = 1;
    println_i64(neg - one); // -1
    
    let small: i32 = 42;
    println_i32(small);
    
    println_bool(true);
    println_bool(false);
    let five: i64 = 5;
    let three: i64 = 3;
    println_bool(five > three);
    
    let u: () = get_unit();
    println_unit(u);
    
    // Test division
    let ten: i64 = 10;
    let two: i64 = 2;
    let result: i64 = divide_safe(ten, two);
    println_i64(result); // Should print 5
    
    // Test exit
    exit(0);
    
    // This should never execute
    println_i64(9999);
    1
}