pub struct Payload {
    number: i32,
    text: StrBuf,

    fn score(borrow self) -> i32 {
        if self.text.len() > 0 { self.number + 11 } else { -1 }
    }
}

drop fn Payload(self) {
    @dbg(self.number + 1000);
}

pub fn make(value: i32) -> Payload {
    Payload {
        number: value,
        text: "left/shared::Payload",
    }
}
