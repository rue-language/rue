const std = @import("std");
const StrBuf = std.strbuf.StrBuf;

const shared = @import("../shared.rue");

struct Payload {
    value: i32,
    extra: i32,
    text: StrBuf,

    fn score(borrow self) -> i32 {
        shared.bump(self.value + self.extra)
    }
}

drop fn Payload(self) {
    @dbg("right-destructor");
    @dbg(self.extra);
}

enum Choice {
    Empty,
    Text(StrBuf),
    Many([StrBuf; 3]),
}

enum Clash {
    Empty,
    Text(StrBuf),
}

fn _right_entry(value: i32) -> i32 {
    let payload = Payload { value: value, extra: 2, text: "right-value" };
    payload.score()
}
