const std = @import("std");
const StrBuf = std.strbuf.StrBuf;

// No left/shared.rue exists: both reordered siblings name the one shared
// module by an explicit importer-relative path (ADR-0078 removed the
// root-directory fallback this used to lean on), so the pair still resolves
// to a single identity across FileId orderings. The compiler unit regression
// separately proves that the root need not have the lowest numeric FileId.
const shared = @import("../shared.rue");

struct Payload {
    value: i32,
    text: StrBuf,

    fn score(borrow self) -> i32 {
        shared.bump(self.value)
    }
}

drop fn Payload(self) {
    @dbg("left-destructor");
    @dbg(self.value);
}

enum Choice {
    Empty,
    Text(StrBuf),
    Many([StrBuf; 2]),
}

// Cross-kind collisions must occupy the same path-qualified glue namespace.
struct Clash {
    text: StrBuf,
}

fn left_entry(value: i32) -> i32 {
    let payload = Payload { value: value, text: "left-value" };
    payload.score()
}

// The program body: called by the root module's `main` (spec 6.1:38 moved the
// entry point into the designated root; this module keeps the semantic
// payload the gate asserts on).
pub fn run() -> i32 {
    let seed = shared.identity(i32, 38);
    let result = left_entry(seed);
    @dbg(result);
    result
}
