load(":defs.bzl", "ZIG_VERSION", "hermetic_zig_toolchain", "zig_c_static_archive", "zig_host_archive")
load("@root//:test_defs.bzl", "rue_sh_test")

zig_host_archive("linux-x86_64", "x86_64-linux")
zig_host_archive("linux-aarch64", "aarch64-linux")
zig_host_archive("macos-x86_64", "x86_64-macos")
zig_host_archive("macos-aarch64", "aarch64-macos")

hermetic_zig_toolchain(
    name = "hermetic-linux-x86_64",
    distribution = ":dist-linux-x86_64",
    host_platform = "x86_64-linux",
    visibility = ["PUBLIC"],
)

zig_c_static_archive(
    name = "archive-smoke",
    src = "archive_smoke.c",
    headers = ["include/archive_smoke.h"],
    include_directories = ["include"],
    compiler_flags = ["-O3"],
    target = select({
        "prelude//os:linux": select({
            "prelude//cpu:arm64": "aarch64-linux-gnu.2.17",
            "prelude//cpu:x86_64": "x86_64-linux-gnu.2.17",
        }),
        "prelude//os:macos": select({
            "prelude//cpu:arm64": "aarch64-macos",
            "prelude//cpu:x86_64": "x86_64-macos",
        }),
    }),
)

rue_sh_test(
    name = "archive-smoke-test",
    test = "archive_smoke_test.sh",
    args = ["$(location :archive-smoke)"],
)

