// An i64 -> i64 map over `std.hashmap.HashMap` (spec 6.7, `--preview
// interfaces`). The generic map takes any key conforming to
// `std.interfaces.Hashable + Equatable`; an integer cannot conform (it has no
// methods), so the key is a one-field struct that supplies `equals` and
// `hash` — the wrapper-type route spec 6.7:11 names. The open-addressing
// table, probing, tombstones, and rehash that used to live here are now the
// standard library's.
const std = @import("std");
const OptI64 = std.option.Option(i64);

pub struct Key is std.interfaces.Equatable + std.interfaces.Hashable {
    n: i64,

    fn equals(borrow self, borrow other: Key) -> bool { self.n == other.n }

    // Fibonacci-ish scramble of the two's-complement bits; the map folds the
    // hash into its table itself.
    fn hash(borrow self) -> u64 {
        let h = (self.n * 2654435761) % 9223372036854775807;
        let positive = if h < 0 { 0 - h } else { h };
        @intCast(positive)
    }
}

const Inner = std.hashmap.HashMap(Key, i64);

pub struct Map {
    inner: Inner,

    // The capacity hint is the map's own business now; the constructor keeps
    // its shape so `main.rue` reads as before.
    fn with_capacity(cap: u64) -> Self {
        let _hint = cap;
        Self { inner: Inner.new() }
    }

    fn insert(inout self, key: i64, val: i64) {
        self.inner.insert(Key { n: key }, val);
    }

    fn get(borrow self, key: i64) -> OptI64 {
        let k = Key { n: key };
        self.inner.get(borrow k)
    }

    fn get_or(borrow self, key: i64, default: i64) -> i64 {
        match self.get(key) {
            OptI64.Some(value) => value,
            OptI64.None => default,
        }
    }

    fn remove(inout self, key: i64) -> bool {
        let k = Key { n: key };
        self.inner.remove(borrow k)
    }

    fn len(borrow self) -> u64 { self.inner.len() }
}
