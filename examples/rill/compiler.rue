// Recursive-descent compiler from Rill tokens directly to stack bytecode.
// Variables become frame-relative slots; calls retain interned function names
// so forward references need no patch table. Structured control flow is lowered
// to patched absolute instruction indexes.
const std = @import("std");
const token = @import("token.rue");
const poolmod = @import("pool.rue");
const bytecode = @import("bytecode.rue");
const StrBuf = std.strbuf.StrBuf;
const U64s = std.arraybuf.ArrayBuf(u64);

pub struct CompileResult { program: bytecode.Program, errors: StrBuf }

struct Compiler {
    tokens: token.Tokens,
    at: u64,
    program: bytecode.Program,
    errors: StrBuf,
    locals: U64s,
    scopes: U64s,
    max_locals: u64,

    fn new(tokens: token.Tokens, pool: poolmod.Pool) -> Self {
        Self {
            tokens: tokens,
            at: 0,
            program: bytecode.Program.new(pool),
            errors: StrBuf.new(),
            locals: U64s.new(),
            scopes: U64s.new(),
            max_locals: 0,
        }
    }

    fn peek(borrow self) -> token.Token {
        self.tokens.get_or(self.at, token.Token { kind: token.EOF, start: 0, end: 0, value: 0 })
    }
    fn next(borrow self) -> token.Token {
        self.tokens.get_or(self.at + 1, token.Token { kind: token.EOF, start: 0, end: 0, value: 0 })
    }
    fn previous(borrow self) -> token.Token {
        if self.at == 0 { self.peek() }
        else { self.tokens.get_or(self.at - 1, token.Token { kind: token.EOF, start: 0, end: 0, value: 0 }) }
    }
    fn advance(inout self) -> token.Token {
        let t = self.peek();
        if t.kind != token.EOF { self.at += 1; }
        t
    }
    fn check(borrow self, kind: u64) -> bool { self.peek().kind == kind }
    fn take(inout self, kind: u64) -> bool {
        if self.check(kind) { let _ = self.advance(); true } else { false }
    }
    fn error_here(inout self, message: StrBuf) {
        self.errors.push_str("compile error at byte ");
        self.errors.push_str(@to_string(self.peek().start));
        self.errors.push_str(": ");
        self.errors.push_str(message);
        self.errors.push_str("\n");
    }
    fn expect(inout self, kind: u64, message: StrBuf) -> token.Token {
        if self.check(kind) { return self.advance(); }
        self.error_here(message);
        if !self.check(token.EOF) { return self.advance(); }
        self.peek()
    }
    fn emit(inout self, op: u64, a: i64, b: i64) -> u64 { self.program.emit(op, a, b) }

    fn local_slot(borrow self, symbol: u64) -> u64 {
        let mut i = self.locals.len();
        while i > 0 {
            i -= 1;
            if self.locals.get_or(i, 18446744073709551615) == symbol { return i; }
        }
        18446744073709551615
    }

    fn declare_local(inout self, symbol: u64) -> u64 {
        let scope_start = if self.scopes.len() == 0 {
            0
        } else {
            self.scopes.get_or(self.scopes.len() - 1, 0)
        };
        let mut i = self.locals.len();
        while i > scope_start {
            i -= 1;
            if self.locals.get_or(i, 18446744073709551615) == symbol {
                self.error_here("duplicate local binding in the same scope");
                return i;
            }
        }
        let slot = self.locals.len();
        self.locals.push(symbol);
        if self.locals.len() > self.max_locals { self.max_locals = self.locals.len(); }
        slot
    }

    fn begin_scope(inout self) { self.scopes.push(self.locals.len()); }
    fn end_scope(inout self) {
        let target = self.scopes.pop_or(0);
        while self.locals.len() > target { let _ = self.locals.pop(); }
    }

    fn primary(inout self) {
        let t = self.advance();
        if t.kind == token.INT {
            let _ = self.emit(bytecode.CONST_INT, @intCast(t.value), 0);
        } else if t.kind == token.STRING {
            let _ = self.emit(bytecode.CONST_STR, @intCast(t.value), 0);
        } else if t.kind == token.TRUE {
            let _ = self.emit(bytecode.CONST_BOOL, 1, 0);
        } else if t.kind == token.FALSE {
            let _ = self.emit(bytecode.CONST_BOOL, 0, 0);
        } else if t.kind == token.LBRACKET {
            let mut count: u64 = 0;
            if !self.check(token.RBRACKET) {
                loop {
                    self.expression();
                    count += 1;
                    if !self.take(token.COMMA) { break; }
                }
            }
            let _ = self.expect(token.RBRACKET, "expected ']' after list elements");
            let _ = self.emit(bytecode.LIST, @intCast(count), 0);
        } else if t.kind == token.LEN {
            let _ = self.expect(token.LPAREN, "expected '(' after len");
            self.expression();
            let _ = self.expect(token.RPAREN, "expected ')' after len argument");
            let _ = self.emit(bytecode.LIST_LEN, 0, 0);
        } else if t.kind == token.PUSH {
            let _ = self.expect(token.LPAREN, "expected '(' after push");
            self.expression();
            let _ = self.expect(token.COMMA, "expected ',' between push arguments");
            self.expression();
            let _ = self.expect(token.RPAREN, "expected ')' after push arguments");
            let _ = self.emit(bytecode.LIST_PUSH, 0, 0);
        } else if t.kind == token.GET {
            let _ = self.expect(token.LPAREN, "expected '(' after get");
            self.expression();
            let _ = self.expect(token.COMMA, "expected ',' between get arguments");
            self.expression();
            let _ = self.expect(token.RPAREN, "expected ')' after get arguments");
            let _ = self.emit(bytecode.LIST_GET, 0, 0);
        } else if t.kind == token.IDENT {
            if self.take(token.LPAREN) {
                let mut argc: u64 = 0;
                if !self.check(token.RPAREN) {
                    loop {
                        self.expression();
                        argc += 1;
                        if !self.take(token.COMMA) { break; }
                    }
                }
                let _ = self.expect(token.RPAREN, "expected ')' after arguments");
                let _ = self.emit(bytecode.CALL, @intCast(t.value), @intCast(argc));
            } else {
                let slot = self.local_slot(t.value);
                if slot == 18446744073709551615 {
                    let global = self.program.find_global(t.value);
                    if global == 18446744073709551615 {
                        self.error_here("unknown variable");
                        let _ = self.emit(bytecode.CONST_BOOL, 0, 0);
                    } else {
                        let _ = self.emit(bytecode.LOAD_GLOBAL, @intCast(global), 0);
                    }
                } else {
                    let _ = self.emit(bytecode.LOAD, @intCast(slot), 0);
                }
            }
        } else if t.kind == token.LPAREN {
            self.expression();
            let _ = self.expect(token.RPAREN, "expected ')' after expression");
        } else {
            self.error_here("expected expression");
            let _ = self.emit(bytecode.CONST_BOOL, 0, 0);
        }
    }

    fn unary(inout self) {
        if self.take(token.BANG) { self.unary(); let _ = self.emit(bytecode.NOT, 0, 0); }
        else if self.take(token.MINUS) { self.unary(); let _ = self.emit(bytecode.NEG, 0, 0); }
        else { self.primary(); }
    }

    fn factor(inout self) {
        self.unary();
        loop {
            if self.take(token.STAR) { self.unary(); let _ = self.emit(bytecode.MUL, 0, 0); }
            else if self.take(token.SLASH) { self.unary(); let _ = self.emit(bytecode.DIV, 0, 0); }
            else if self.take(token.PERCENT) { self.unary(); let _ = self.emit(bytecode.MOD, 0, 0); }
            else { break; }
        }
    }
    fn term(inout self) {
        self.factor();
        loop {
            if self.take(token.PLUS) { self.factor(); let _ = self.emit(bytecode.ADD, 0, 0); }
            else if self.take(token.MINUS) { self.factor(); let _ = self.emit(bytecode.SUB, 0, 0); }
            else { break; }
        }
    }
    fn comparison(inout self) {
        self.term();
        loop {
            if self.take(token.LT) { self.term(); let _ = self.emit(bytecode.LT, 0, 0); }
            else if self.take(token.LTEQ) { self.term(); let _ = self.emit(bytecode.LE, 0, 0); }
            else if self.take(token.GT) { self.term(); let _ = self.emit(bytecode.GT, 0, 0); }
            else if self.take(token.GTEQ) { self.term(); let _ = self.emit(bytecode.GE, 0, 0); }
            else { break; }
        }
    }
    fn equality(inout self) {
        self.comparison();
        loop {
            if self.take(token.EQEQ) { self.comparison(); let _ = self.emit(bytecode.EQ, 0, 0); }
            else if self.take(token.BANGEQ) { self.comparison(); let _ = self.emit(bytecode.NE, 0, 0); }
            else { break; }
        }
    }
    fn conjunction(inout self) {
        self.equality();
        while self.take(token.AMPAMP) {
            let false_jump = self.emit(bytecode.JUMP_FALSE, 0, 0);
            self.equality();
            let end_jump = self.emit(bytecode.JUMP, 0, 0);
            self.program.patch(false_jump, self.program.code.len());
            let _ = self.emit(bytecode.CONST_BOOL, 0, 0);
            self.program.patch(end_jump, self.program.code.len());
        }
    }
    fn expression(inout self) {
        self.conjunction();
        while self.take(token.PIPEPIPE) {
            let rhs_jump = self.emit(bytecode.JUMP_FALSE, 0, 0);
            let _ = self.emit(bytecode.CONST_BOOL, 1, 0);
            let end_jump = self.emit(bytecode.JUMP, 0, 0);
            self.program.patch(rhs_jump, self.program.code.len());
            self.conjunction();
            self.program.patch(end_jump, self.program.code.len());
        }
    }

    fn block(inout self) {
        let _ = self.expect(token.LBRACE, "expected '{'");
        self.begin_scope();
        while !self.check(token.RBRACE) && !self.check(token.EOF) { self.statement(); }
        let _ = self.expect(token.RBRACE, "expected '}'");
        self.end_scope();
    }

    fn let_statement(inout self) {
        let name = self.expect(token.IDENT, "expected binding name");
        let slot = self.declare_local(name.value);
        let _ = self.expect(token.EQ, "expected '=' after binding name");
        self.expression();
        let _ = self.expect(token.SEMI, "expected ';' after binding");
        let _ = self.emit(bytecode.STORE, @intCast(slot), 0);
    }

    fn assignment(inout self) {
        let name = self.advance();
        let _ = self.advance();
        self.expression();
        let _ = self.expect(token.SEMI, "expected ';' after assignment");
        let slot = self.local_slot(name.value);
        if slot == 18446744073709551615 {
            let global = self.program.find_global(name.value);
            if global == 18446744073709551615 {
                self.error_here("assignment to unknown variable");
                let _ = self.emit(bytecode.POP, 0, 0);
            } else {
                let _ = self.emit(bytecode.STORE_GLOBAL, @intCast(global), 0);
            }
        } else {
            let _ = self.emit(bytecode.STORE, @intCast(slot), 0);
        }
    }

    fn if_statement(inout self) {
        let _ = self.expect(token.LPAREN, "expected '(' after if");
        self.expression();
        let _ = self.expect(token.RPAREN, "expected ')' after condition");
        let false_jump = self.emit(bytecode.JUMP_FALSE, 0, 0);
        self.block();
        if self.take(token.ELSE) {
            let end_jump = self.emit(bytecode.JUMP, 0, 0);
            self.program.patch(false_jump, self.program.code.len());
            self.block();
            self.program.patch(end_jump, self.program.code.len());
        } else {
            self.program.patch(false_jump, self.program.code.len());
        }
    }

    fn while_statement(inout self) {
        let start = self.program.code.len();
        let _ = self.expect(token.LPAREN, "expected '(' after while");
        self.expression();
        let _ = self.expect(token.RPAREN, "expected ')' after condition");
        let exit = self.emit(bytecode.JUMP_FALSE, 0, 0);
        self.block();
        let _ = self.emit(bytecode.JUMP, @intCast(start), 0);
        self.program.patch(exit, self.program.code.len());
    }

    fn return_statement(inout self) {
        if self.check(token.SEMI) { let _ = self.emit(bytecode.CONST_BOOL, 0, 0); }
        else { self.expression(); }
        let _ = self.expect(token.SEMI, "expected ';' after return");
        let _ = self.emit(bytecode.RETURN, 0, 0);
    }

    fn print_statement(inout self) {
        let _ = self.expect(token.LPAREN, "expected '(' after print");
        self.expression();
        let _ = self.expect(token.RPAREN, "expected ')' after printed value");
        let _ = self.expect(token.SEMI, "expected ';' after print");
        let _ = self.emit(bytecode.PRINT, 0, 0);
    }

    fn statement(inout self) {
        if self.take(token.LET) { self.let_statement(); }
        else if self.take(token.IF) { self.if_statement(); }
        else if self.take(token.WHILE) { self.while_statement(); }
        else if self.take(token.RETURN) { self.return_statement(); }
        else if self.take(token.PRINT) { self.print_statement(); }
        else if self.check(token.LBRACE) { self.block(); }
        else if self.check(token.IDENT) && self.next().kind == token.EQ { self.assignment(); }
        else {
            self.expression();
            let _ = self.expect(token.SEMI, "expected ';' after expression");
            let _ = self.emit(bytecode.POP, 0, 0);
        }
    }

    fn function(inout self) {
        let name = self.expect(token.IDENT, "expected function name");
        let _ = self.expect(token.LPAREN, "expected '(' after function name");
        self.locals.clear();
        self.scopes.clear();
        self.max_locals = 0;
        let mut arity: u64 = 0;
        if !self.check(token.RPAREN) {
            loop {
                let param = self.expect(token.IDENT, "expected parameter name");
                let _ = self.declare_local(param.value);
                arity += 1;
                if !self.take(token.COMMA) { break; }
            }
        }
        let _ = self.expect(token.RPAREN, "expected ')' after parameters");
        let function_id = self.program.add_function(name.value, self.program.code.len(), arity);
        self.block();
        let _ = self.emit(bytecode.CONST_BOOL, 0, 0);
        let _ = self.emit(bytecode.RETURN, 0, 0);
        self.program.finish_function(function_id, self.max_locals);
    }

    // Globals deliberately use literal initializers. This keeps startup data
    // deterministic and still permits mutation from functions through the
    // ordinary LOAD_GLOBAL/STORE_GLOBAL instructions.
    fn global(inout self) {
        let name = self.expect(token.IDENT, "expected global binding name");
        if self.program.find_global(name.value) != 18446744073709551615 {
            self.error_here("duplicate global binding");
        }
        let _ = self.expect(token.EQ, "expected '=' after global name");
        let mut negative = false;
        if self.take(token.MINUS) { negative = true; }
        let value = self.advance();
        let mut tag: u64 = 0;
        let mut data: i64 = 0;
        if value.kind == token.INT {
            tag = 1;
            let signed: i64 = @intCast(value.value);
            data = if negative { 0 - signed } else { signed };
        } else if value.kind == token.TRUE || value.kind == token.FALSE {
            if negative { self.error_here("only integer globals may be negative"); }
            tag = 2;
            data = if value.kind == token.TRUE { 1 } else { 0 };
        } else if value.kind == token.STRING {
            if negative { self.error_here("only integer globals may be negative"); }
            tag = 3;
            data = @intCast(value.value);
        } else {
            self.error_here("global initializer must be an integer, boolean, or string literal");
            tag = 2;
            data = 0;
        }
        let _ = self.expect(token.SEMI, "expected ';' after global binding");
        let _ = self.program.add_global(name.value, tag, data);
    }

    fn compile(inout self) {
        while !self.check(token.EOF) {
            if self.take(token.FN) { self.function(); }
            else if self.take(token.LET) { self.global(); }
            else {
                self.error_here("expected function declaration");
                let _ = self.advance();
            }
        }
        let _ = self.program.emit(bytecode.HALT, 0, 0);
    }
}

pub fn compile(tokens: token.Tokens, pool: poolmod.Pool) -> CompileResult {
    let mut compiler = Compiler.new(tokens, pool);
    compiler.compile();
    CompileResult { program: compiler.program, errors: compiler.errors }
}
