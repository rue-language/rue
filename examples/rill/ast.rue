// POD arena syntax tree for Rill. Every relationship is an integer node index;
// sibling lists use `next`, so the complete tree can be revisited freely from
// ArrayBuf without moving recursive owned values.
const std = @import("std");

pub const NONE: u64 = 18446744073709551615;

pub const PROGRAM: u64 = 1;
pub const GLOBAL: u64 = 2;
pub const FUNCTION: u64 = 3;
pub const PARAM: u64 = 4;
pub const BLOCK: u64 = 5;
pub const LET: u64 = 6;
pub const ASSIGN: u64 = 7;
pub const IF: u64 = 8;
pub const WHILE: u64 = 9;
pub const RETURN: u64 = 10;
pub const PRINT: u64 = 11;
pub const EXPR_STMT: u64 = 12;

pub const INT: u64 = 20;
pub const BOOL: u64 = 21;
pub const STRING: u64 = 22;
pub const VARIABLE: u64 = 23;
pub const CALL: u64 = 24;
pub const LIST: u64 = 25;
pub const LEN: u64 = 26;
pub const PUSH: u64 = 27;
pub const GET: u64 = 28;
pub const UNARY: u64 = 29;
pub const BINARY: u64 = 30;

pub struct Node {
    kind: u64,
    value: u64,
    first: u64,
    second: u64,
    third: u64,
    next: u64,
    start: u64,
    end: u64,
}

pub const Nodes = std.arraybuf.ArrayBuf(Node);

pub struct Arena {
    nodes: Nodes,

    fn new() -> Self { Self { nodes: Nodes.new() } }

    fn add(inout self, kind: u64, value: u64, first: u64, second: u64, third: u64, start: u64, end: u64) -> u64 {
        let id = self.nodes.len();
        self.nodes.push(Node {
            kind: kind,
            value: value,
            first: first,
            second: second,
            third: third,
            next: NONE,
            start: start,
            end: end,
        });
        id
    }

    fn get(borrow self, id: u64) -> Node {
        self.nodes.get_or(id, Node {
            kind: 0,
            value: 0,
            first: NONE,
            second: NONE,
            third: NONE,
            next: NONE,
            start: 0,
            end: 0,
        })
    }

    fn set_next(inout self, id: u64, next: u64) {
        let old = self.get(id);
        self.nodes.set(id, Node {
            kind: old.kind,
            value: old.value,
            first: old.first,
            second: old.second,
            third: old.third,
            next: next,
            start: old.start,
            end: old.end,
        });
    }
}

// Builder for a sibling chain. Keeping head and tail together avoids repeated
// arena scans when parsing parameter, argument, statement, and item lists.
pub struct Chain {
    head: u64,
    tail: u64,

    fn new() -> Self { Self { head: NONE, tail: NONE } }

    fn push(inout self, inout arena: Arena, id: u64) {
        if self.head == NONE {
            self.head = id;
        } else {
            arena.set_next(self.tail, id);
        }
        self.tail = id;
    }
}
