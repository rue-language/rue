// Replica election ranks health, applied LSN, lag, and stable catalog order.
const model = @import("model.rue");

pub struct Election {
    winner: u64,
    candidates: u64,
    rejected: u64,
    winning_lsn: u64,
    valid: bool,
}

pub fn elect(borrow database: model.Database) -> Election {
    let mut out = Election { winner: model.NONE(), candidates: 0, rejected: 0,
        winning_lsn: 0, valid: false };
    let mut i: u64 = 0;
    while i < database.replicas.len() {
        let replica = database.replicas.get_or(i, model.empty_replica());
        if replica.healthy {
            out.candidates += 1;
            if out.winner == model.NONE() || replica.applied_lsn > out.winning_lsn {
                out.winner = i;
                out.winning_lsn = replica.applied_lsn;
            }
        } else { out.rejected = out.rejected + 1; }
        i += 1;
    }
    out.valid = out.winner != model.NONE() && out.winner < database.replicas.len();
    out
}
