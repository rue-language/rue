pub struct Result {
    rules: u64,
    evaluations: u64,
    inspected: u64,
    matches: u64,
    rewrites: u64,
    benefit: u64,
    failures: u64,
    deterministic: bool,
    digest: u64,
    valid: bool,
}

fn empty() -> Result {
    Result { rules: 0, evaluations: 0, inspected: 0, matches: 0,
        rewrites: 0, benefit: 0, failures: 0, deterministic: true,
        digest: 14695981039346656037, valid: false }
}

fn include(inout out: Result, borrow input: plan.Plan,
    borrow first: rule_result.Decision, borrow second: rule_result.Decision,
    verified: bool) {
    out.evaluations += 1;
    out.inspected += first.inspected;
    out.matches += first.matches;
    out.rewrites += first.rewrites;
    out.benefit += first.benefit;
    out.digest = metric.mix(out.digest, first.rule);
    out.digest = metric.mix(out.digest, first.digest);
    if !verified || !first.valid || first.cost_before != input.cost {
        out.failures += 1;
    }
    if first.digest != second.digest || first.matches != second.matches ||
        first.rewrites != second.rewrites || first.cost_after != second.cost_after {
        out.deterministic = false;
        out.failures += 1;
    }
}

pub fn run(borrow database: model.Database) -> Result {
    let mut out = empty();
    let mut q: u64 = 0;
    while q < database.queries.len() {
        let query = database.queries.get_or(q, model.empty_query());
        let input = plan.build(borrow database, borrow query);
        let logical_push_filter_a = rule_logical_push_filter.evaluate(borrow database, borrow query, borrow input);
        let logical_push_filter_b = rule_logical_push_filter.evaluate(borrow database, borrow query, borrow input);
        include(inout out, borrow input, borrow logical_push_filter_a, borrow logical_push_filter_b,
            rule_logical_push_filter.verify(borrow input, borrow logical_push_filter_a));
        let logical_merge_filters_a = rule_logical_merge_filters.evaluate(borrow database, borrow query, borrow input);
        let logical_merge_filters_b = rule_logical_merge_filters.evaluate(borrow database, borrow query, borrow input);
