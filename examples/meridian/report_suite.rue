const report_cost = @import("report_cost.rue");
const report_statistics = @import("report_statistics.rue");
const report_transactions = @import("report_transactions.rue");
const report_mvcc = @import("report_mvcc.rue");
const report_wal = @import("report_wal.rue");
const report_checkpoint = @import("report_checkpoint.rue");
const report_recovery = @import("report_recovery.rue");
