    let cost_a = report_cost.render(borrow database, borrow query, borrow query_plan, borrow output);
    let cost_b = report_cost.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow cost_a, borrow cost_b, report_cost.verify(borrow cost_a));
    let statistics_a = report_statistics.render(borrow database, borrow query, borrow query_plan, borrow output);
    let statistics_b = report_statistics.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow statistics_a, borrow statistics_b, report_statistics.verify(borrow statistics_a));
    let transactions_a = report_transactions.render(borrow database, borrow query, borrow query_plan, borrow output);
    let transactions_b = report_transactions.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow transactions_a, borrow transactions_b, report_transactions.verify(borrow transactions_a));
    let mvcc_a = report_mvcc.render(borrow database, borrow query, borrow query_plan, borrow output);
    let mvcc_b = report_mvcc.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow mvcc_a, borrow mvcc_b, report_mvcc.verify(borrow mvcc_a));
    let wal_a = report_wal.render(borrow database, borrow query, borrow query_plan, borrow output);
    let wal_b = report_wal.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow wal_a, borrow wal_b, report_wal.verify(borrow wal_a));
    let checkpoint_a = report_checkpoint.render(borrow database, borrow query, borrow query_plan, borrow output);
    let checkpoint_b = report_checkpoint.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow checkpoint_a, borrow checkpoint_b, report_checkpoint.verify(borrow checkpoint_a));
    let recovery_a = report_recovery.render(borrow database, borrow query, borrow query_plan, borrow output);
    let recovery_b = report_recovery.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow recovery_a, borrow recovery_b, report_recovery.verify(borrow recovery_a));
    let locks_a = report_locks.render(borrow database, borrow query, borrow query_plan, borrow output);
    let locks_b = report_locks.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow locks_a, borrow locks_b, report_locks.verify(borrow locks_a));
    let deadlocks_a = report_deadlocks.render(borrow database, borrow query, borrow query_plan, borrow output);
    let deadlocks_b = report_deadlocks.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow deadlocks_a, borrow deadlocks_b, report_deadlocks.verify(borrow deadlocks_a));
    let replicas_a = report_replicas.render(borrow database, borrow query, borrow query_plan, borrow output);
    let replicas_b = report_replicas.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow replicas_a, borrow replicas_b, report_replicas.verify(borrow replicas_a));
    let failover_a = report_failover.render(borrow database, borrow query, borrow query_plan, borrow output);
    let failover_b = report_failover.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow failover_a, borrow failover_b, report_failover.verify(borrow failover_a));
    let shards_a = report_shards.render(borrow database, borrow query, borrow query_plan, borrow output);
    let shards_b = report_shards.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow shards_a, borrow shards_b, report_shards.verify(borrow shards_a));
    let partitions_a = report_partitions.render(borrow database, borrow query, borrow query_plan, borrow output);
    let partitions_b = report_partitions.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow partitions_a, borrow partitions_b, report_partitions.verify(borrow partitions_a));
    let lineage_a = report_lineage.render(borrow database, borrow query, borrow query_plan, borrow output);
    let lineage_b = report_lineage.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow lineage_a, borrow lineage_b, report_lineage.verify(borrow lineage_a));
    let audit_a = report_audit.render(borrow database, borrow query, borrow query_plan, borrow output);
    let audit_b = report_audit.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow audit_a, borrow audit_b, report_audit.verify(borrow audit_a));
