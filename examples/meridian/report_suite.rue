const report_audit = @import("report_audit.rue");
const report_constraints = @import("report_constraints.rue");
const report_benchmark = @import("report_benchmark.rue");

pub struct Audit {
    documents: u64,
    bytes: u64,
    failures: u64,
    deterministic_mismatches: u64,
    digest: u64,
    valid: bool,
}

fn empty() -> Audit {
    Audit { documents: 0, bytes: 0, failures: 0,
        deterministic_mismatches: 0, digest: 14695981039346656037, valid: false }
}

fn include(inout audit: Audit, borrow first: StrBuf, borrow second: StrBuf, verified: bool) {
    audit.documents += 1;
    audit.bytes += first.len();
    audit.digest = metric.mix(audit.digest, text.fnv1a(borrow first));
    if !verified || first.len() == 0 { audit.failures += 1; }
    if first.len() != second.len() ||
        text.fnv1a(borrow first) != text.fnv1a(borrow second) {
        audit.deterministic_mismatches += 1;
        audit.failures += 1;
    }
}

pub fn run(borrow database: model.Database, borrow query: model.Query,
    borrow query_plan: plan.Plan, borrow output: result.Result) -> Audit {
    let mut audit = empty();
    let human_a = report_human.render(borrow database, borrow query, borrow query_plan, borrow output);
    let human_b = report_human.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow human_a, borrow human_b, report_human.verify(borrow human_a));
    let csv_a = report_csv.render(borrow database, borrow query, borrow query_plan, borrow output);
    let csv_b = report_csv.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow csv_a, borrow csv_b, report_csv.verify(borrow csv_a));
    let json_a = report_json.render(borrow database, borrow query, borrow query_plan, borrow output);
    let json_b = report_json.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow json_a, borrow json_b, report_json.verify(borrow json_a));
    let ndjson_a = report_ndjson.render(borrow database, borrow query, borrow query_plan, borrow output);
    let ndjson_b = report_ndjson.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow ndjson_a, borrow ndjson_b, report_ndjson.verify(borrow ndjson_a));
    let sql_a = report_sql.render(borrow database, borrow query, borrow query_plan, borrow output);
    let sql_b = report_sql.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow sql_a, borrow sql_b, report_sql.verify(borrow sql_a));
    let dot_a = report_dot.render(borrow database, borrow query, borrow query_plan, borrow output);
    let dot_b = report_dot.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow dot_a, borrow dot_b, report_dot.verify(borrow dot_a));
    let mermaid_a = report_mermaid.render(borrow database, borrow query, borrow query_plan, borrow output);
    let mermaid_b = report_mermaid.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow mermaid_a, borrow mermaid_b, report_mermaid.verify(borrow mermaid_a));
    let html_a = report_html.render(borrow database, borrow query, borrow query_plan, borrow output);
    let html_b = report_html.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow html_a, borrow html_b, report_html.verify(borrow html_a));
    let markdown_a = report_markdown.render(borrow database, borrow query, borrow query_plan, borrow output);
    let markdown_b = report_markdown.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow markdown_a, borrow markdown_b, report_markdown.verify(borrow markdown_a));
    let yaml_a = report_yaml.render(borrow database, borrow query, borrow query_plan, borrow output);
    let yaml_b = report_yaml.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow yaml_a, borrow yaml_b, report_yaml.verify(borrow yaml_a));
    let toml_a = report_toml.render(borrow database, borrow query, borrow query_plan, borrow output);
    let toml_b = report_toml.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow toml_a, borrow toml_b, report_toml.verify(borrow toml_a));
    let xml_a = report_xml.render(borrow database, borrow query, borrow query_plan, borrow output);
    let xml_b = report_xml.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow xml_a, borrow xml_b, report_xml.verify(borrow xml_a));
    let junit_a = report_junit.render(borrow database, borrow query, borrow query_plan, borrow output);
    let junit_b = report_junit.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow junit_a, borrow junit_b, report_junit.verify(borrow junit_a));
    let sarif_a = report_sarif.render(borrow database, borrow query, borrow query_plan, borrow output);
    let sarif_b = report_sarif.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow sarif_a, borrow sarif_b, report_sarif.verify(borrow sarif_a));
    let prometheus_a = report_prometheus.render(borrow database, borrow query, borrow query_plan, borrow output);
    let prometheus_b = report_prometheus.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow prometheus_a, borrow prometheus_b, report_prometheus.verify(borrow prometheus_a));
    let otel_a = report_otel.render(borrow database, borrow query, borrow query_plan, borrow output);
    let otel_b = report_otel.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow otel_a, borrow otel_b, report_otel.verify(borrow otel_a));
    let chrome_trace_a = report_chrome_trace.render(borrow database, borrow query, borrow query_plan, borrow output);
    let chrome_trace_b = report_chrome_trace.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow chrome_trace_a, borrow chrome_trace_b, report_chrome_trace.verify(borrow chrome_trace_a));
    let catalog_a = report_catalog.render(borrow database, borrow query, borrow query_plan, borrow output);
    let catalog_b = report_catalog.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow catalog_a, borrow catalog_b, report_catalog.verify(borrow catalog_a));
    let schema_a = report_schema.render(borrow database, borrow query, borrow query_plan, borrow output);
    let schema_b = report_schema.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow schema_a, borrow schema_b, report_schema.verify(borrow schema_a));
    let table_a = report_table.render(borrow database, borrow query, borrow query_plan, borrow output);
    let table_b = report_table.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow table_a, borrow table_b, report_table.verify(borrow table_a));
    let columns_a = report_columns.render(borrow database, borrow query, borrow query_plan, borrow output);
    let columns_b = report_columns.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow columns_a, borrow columns_b, report_columns.verify(borrow columns_a));
    let indexes_a = report_indexes.render(borrow database, borrow query, borrow query_plan, borrow output);
    let indexes_b = report_indexes.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow indexes_a, borrow indexes_b, report_indexes.verify(borrow indexes_a));
    let rows_a = report_rows.render(borrow database, borrow query, borrow query_plan, borrow output);
    let rows_b = report_rows.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow rows_a, borrow rows_b, report_rows.verify(borrow rows_a));
    let cells_a = report_cells.render(borrow database, borrow query, borrow query_plan, borrow output);
    let cells_b = report_cells.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow cells_a, borrow cells_b, report_cells.verify(borrow cells_a));
    let query_a = report_query.render(borrow database, borrow query, borrow query_plan, borrow output);
    let query_b = report_query.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow query_a, borrow query_b, report_query.verify(borrow query_a));
    let plan_a = report_plan.render(borrow database, borrow query, borrow query_plan, borrow output);
