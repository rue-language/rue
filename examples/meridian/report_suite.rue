    let benchmark_a = report_benchmark.render(borrow database, borrow query, borrow query_plan, borrow output);
    let benchmark_b = report_benchmark.render(borrow database, borrow query, borrow query_plan, borrow output);
    include(inout audit, borrow benchmark_a, borrow benchmark_b, report_benchmark.verify(borrow benchmark_a));
    audit.valid = audit.documents == 44 && audit.failures == 0 &&
        audit.deterministic_mismatches == 0;
    audit
