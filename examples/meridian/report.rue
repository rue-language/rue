// Primary human-readable query and catalog summary.
const model = @import("model.rue");
const plan = @import("plan.rue");
const result = @import("result.rue");
const std = @import("std");
const text = @import("text.rue");
const StrBuf = std.strbuf.StrBuf;

pub fn summary(borrow database: model.Database, borrow query: model.Query,
    borrow query_plan: plan.Plan, borrow output: result.Result) -> StrBuf {
    let mut out = StrBuf.new();
    text.append_literal(inout out, "database=");
    text.append_id(inout out, borrow database, database.name); out.push(10);
    text.line(inout out, "tables=", database.tables.len());
    text.line(inout out, "columns=", database.columns.len());
    text.line(inout out, "stored_rows=", database.rows.len());
    text.line(inout out, "indexes=", database.indexes.len());
    text.line(inout out, "queries=", database.queries.len());
    text.line(inout out, "transactions=", database.transactions.len());
    text.line(inout out, "wal_entries=", database.wal.len());
    text.line(inout out, "replicas=", database.replicas.len());
    text.append_literal(inout out, "query_table=");
    text.append_id(inout out, borrow database, query.table_name); out.push(10);
    text.line(inout out, "plan_nodes=", query_plan.nodes.len());
    text.line(inout out, "plan_cost=", query_plan.cost);
    text.line(inout out, "estimated_rows=", query_plan.estimated_rows);
    text.line(inout out, "result_rows=", output.rows);
    text.line(inout out, "joined_rows=", output.joined_rows);
    text.line(inout out, "groups=", output.groups);
    text.line(inout out, "sum=", output.sum);
    text.line(inout out, "minimum=", output.minimum);
    text.line(inout out, "maximum=", output.maximum);
    text.bool_line(inout out, "used_index=", output.used_index);
    text.bool_line(inout out, "truncated=", output.truncated);
    text.bool_line(inout out, "plan_valid=", plan.verify(borrow query_plan));
    text.bool_line(inout out, "result_valid=", output.valid);
    out
}
