pub struct Result {
    passes: u64,
    failures: u64,
    observations: u64,
    warnings: u64,
    digest: u64,
    deterministic: bool,
    valid: bool,
}

fn empty() -> Result {
    Result { passes: 0, failures: 0, observations: 0, warnings: 0,
        digest: 14695981039346656037, deterministic: true, valid: false }
}

fn include(inout out: Result, borrow first: metric.Metric, borrow second: metric.Metric, verified: bool) {
    out.passes += 1;
    out.observations += first.observations;
    out.warnings += first.warnings;
    out.digest = metric.mix(out.digest, first.tag);
    out.digest = metric.mix(out.digest, first.digest);
    if !verified || !metric.valid(borrow first) { out.failures = out.failures + 1; }
    if first.digest != second.digest || first.observations != second.observations ||
        first.warnings != second.warnings {
        out.deterministic = false;
        out.failures += 1;
    }
}

pub fn run(borrow database: model.Database) -> Result {
    let mut out = empty();
    let catalog_table_density_a = analysis_catalog_table_density.analyze(borrow database);
    let catalog_table_density_b = analysis_catalog_table_density.analyze(borrow database);
