// Required, unique, row-width, and index-entry constraint oracle.
const metric = @import("metric.rue");
const model = @import("model.rue");

pub fn audit(borrow database: model.Database) -> metric.Metric {
    let mut out = metric.new(4501);
    let mut c: u64 = 0;
    while c < database.columns.len() {
        let column = database.columns.get_or(c, model.empty_column());
        let mut distinct: u64 = 0;
        let mut duplicates: u64 = 0;
        let mut r: u64 = 0;
        while r < database.rows.len() {
            let row = database.rows.get_or(r, model.empty_row());
            if row.table == column.table && model.visible(borrow row, database.version) {
                let value = model.cell_number(borrow database, r, c);
                let mut seen = false;
                let mut earlier: u64 = 0;
                while earlier < r {
                    let old = database.rows.get_or(earlier, model.empty_row());
                    if old.table == column.table && model.visible(borrow old, database.version) &&
                        model.cell_number(borrow database, earlier, c) == value {
                        seen = true;
                    }
                    earlier += 1;
                }
                if seen { duplicates += 1; } else { distinct += 1; }
            }
            r += 1;
        }
        metric.observe(inout out, distinct, c + 1);
        metric.warn(inout out, column.unique && duplicates > 0);
        metric.warn(inout out, !column.nullable && column.kind == 0);
        c += 1;
    }
    metric.finish(inout out);
    out
}
