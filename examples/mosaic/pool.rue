// Shared byte pool for Mosaic. Every parsed string is represented by a stable
// integer id, keeping the site model trivially copyable and arena-friendly.
// An open-addressed hash index makes interning amortized O(length), so total
// intern work stays linear in input volume instead of quadratic in pool size
// (RUE-1003). A retained StrMap(u64) field works since RUE-993, but it would
// copy every key's bytes into a second table; this index is built from the
// pool's own primitive arrays so the pooled bytes stay the only copy
// (RUE-1008). Ids are never removed, so the table needs no tombstones: a
// slot holds id + 1, and 0 means empty.
const std = @import("std");
const StrBuf = std.strbuf.StrBuf;
const U64s = std.arraybuf.ArrayBuf(u64);
const OptU8 = std.option.Option(u8);

pub struct Pool {
    bytes: StrBuf,
    offsets: U64s,
    lengths: U64s,
    slots: U64s,
    slot_cap: u64,

    fn new() -> Self {
        let mut pool = Self {
            bytes: StrBuf.new(),
            offsets: U64s.new(),
            lengths: U64s.new(),
            slots: U64s.new(),
            slot_cap: 0,
        };
        pool.grow_slots(16);
        pool
    }

    fn len(borrow self) -> u64 { self.offsets.len() }

    // FNV-1a over the candidate's bytes; must match `hash` over pooled ids so
    // rebuilt tables and fresh probes agree on slot positions.
    fn value_hash(borrow value: StrBuf) -> u64 {
        let mut h: u64 = 14695981039346656037;
        let mut i: u64 = 0;
        while i < value.len() {
            let b = match value.byte_at(i) { OptU8.Some(x) => x, OptU8.None => 0 };
            h ^= @intCast(b);
            h = @wrapping_mul(h, 1099511628211);
            i += 1;
        }
        h
    }

    // Re-hash every interned id into a table of `new_cap` slots.
    fn grow_slots(inout self, new_cap: u64) {
        let mut fresh = U64s.new();
        let mut i: u64 = 0;
        while i < new_cap { fresh.push(0); i = i + 1; }
        let mut id: u64 = 0;
        while id < self.len() {
            let mut slot = self.hash(id) % new_cap;
            while fresh.get_or(slot, 0) != 0 { slot = (slot + 1) % new_cap; }
            fresh.set(slot, id + 1);
            id += 1;
        }
        self.slots = fresh;
        self.slot_cap = new_cap;
    }

    fn intern(inout self, borrow value: StrBuf) -> u64 {
        // Grow above 50% load so probe chains stay short.
        if (self.len() + 1) * 2 > self.slot_cap { self.grow_slots(self.slot_cap * 2); }
        let mut slot = Self.value_hash(borrow value) % self.slot_cap;
        while self.slots.get_or(slot, 0) != 0 {
            let id = self.slots.get_or(slot, 0) - 1;
            if self.equals(id, borrow value) { return id; }
            slot = (slot + 1) % self.slot_cap;
        }
        let id = self.len();
        self.slots.set(slot, id + 1);
        self.offsets.push(self.bytes.len());
        self.lengths.push(value.len());
        let mut i: u64 = 0;
        while i < value.len() {
            match value.byte_at(i) {
                OptU8.Some(b) => { self.bytes.push(b); },
                OptU8.None => {},
            }
            i += 1;
        }
        id
    }

    fn intern_literal(inout self, value: StrBuf) -> u64 { self.intern(borrow value) }

    fn find(borrow self, borrow value: StrBuf) -> u64 {
        if self.slot_cap == 0 { return self.len(); }
        let mut slot = Self.value_hash(borrow value) % self.slot_cap;
        while self.slots.get_or(slot, 0) != 0 {
            let id = self.slots.get_or(slot, 0) - 1;
            if self.equals(id, borrow value) { return id; }
            slot = (slot + 1) % self.slot_cap;
        }
        self.len()
    }

    fn byte_at(borrow self, id: u64, index: u64) -> u8 {
        if id >= self.len() || index >= self.lengths.get_or(id, 0) { return 0; }
        match self.bytes.byte_at(self.offsets.get_or(id, 0) + index) {
            OptU8.Some(b) => b,
            OptU8.None => 0,
        }
    }

    fn string_len(borrow self, id: u64) -> u64 {
        if id < self.len() { self.lengths.get_or(id, 0) } else { 0 }
    }

    fn append(borrow self, id: u64, inout out: StrBuf) {
        let n = self.string_len(id);
        let mut i: u64 = 0;
        while i < n { out.push(self.byte_at(id, i)); i = i + 1; }
    }

    fn copy(borrow self, id: u64) -> StrBuf {
        let mut out = StrBuf.new();
        self.append(id, inout out);
        out
    }

    fn equals(borrow self, id: u64, borrow value: StrBuf) -> bool {
        let n = self.string_len(id);
        if n != value.len() { return false; }
        let mut i: u64 = 0;
        while i < n {
            let b = match value.byte_at(i) { OptU8.Some(x) => x, OptU8.None => 0 };
            if self.byte_at(id, i) != b { return false; }
            i += 1;
        }
        true
    }

    fn ids_equal(borrow self, a: u64, b: u64) -> bool {
        let n = self.string_len(a);
        if n != self.string_len(b) { return false; }
        let mut i: u64 = 0;
        while i < n {
            if self.byte_at(a, i) != self.byte_at(b, i) { return false; }
            i += 1;
        }
        true
    }

    fn starts_with(borrow self, id: u64, borrow prefix: StrBuf) -> bool {
        if prefix.len() > self.string_len(id) { return false; }
        let mut i: u64 = 0;
        while i < prefix.len() {
            let b = match prefix.byte_at(i) { OptU8.Some(x) => x, OptU8.None => 0 };
            if self.byte_at(id, i) != b { return false; }
            i += 1;
        }
        true
    }

    fn hash(borrow self, id: u64) -> u64 {
        let mut h: u64 = 14695981039346656037;
        let mut i: u64 = 0;
        while i < self.string_len(id) {
            h ^= @intCast(self.byte_at(id, i));
            h = @wrapping_mul(h, 1099511628211);
            i += 1;
        }
        h
    }
}
