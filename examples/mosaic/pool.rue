// Shared byte pool for Mosaic. Every parsed string is represented by a stable
// integer id, keeping the site model trivially copyable and arena-friendly.
const std = @import("std");
const StrBuf = std.strbuf.StrBuf;
const U64s = std.arraybuf.ArrayBuf(u64);
const OptU8 = std.option.Option(u8);

pub struct Pool {
    bytes: StrBuf,
    offsets: U64s,
    lengths: U64s,

    fn new() -> Self {
        Self { bytes: StrBuf.new(), offsets: U64s.new(), lengths: U64s.new() }
    }

    fn len(borrow self) -> u64 { self.offsets.len() }

    fn intern(inout self, borrow value: StrBuf) -> u64 {
        let existing = self.find(borrow value);
        if existing < self.len() { return existing; }
        let id = self.len();
        self.offsets.push(self.bytes.len());
        self.lengths.push(value.len());
        let mut i: u64 = 0;
        while i < value.len() {
            match value.byte_at(i) {
                OptU8.Some(b) => { self.bytes.push(b); },
                OptU8.None => {},
            }
            i = i + 1;
        }
        id
    }

    fn intern_literal(inout self, value: StrBuf) -> u64 { self.intern(borrow value) }

    fn find(borrow self, borrow value: StrBuf) -> u64 {
        let mut id: u64 = 0;
        while id < self.len() {
            if self.equals(id, borrow value) { return id; }
            id = id + 1;
        }
        self.len()
    }

    fn byte_at(borrow self, id: u64, index: u64) -> u8 {
        if id >= self.len() || index >= self.lengths.get_or(id, 0) { return 0; }
        match self.bytes.byte_at(self.offsets.get_or(id, 0) + index) {
            OptU8.Some(b) => b,
            OptU8.None => 0,
        }
    }

    fn string_len(borrow self, id: u64) -> u64 {
        if id < self.len() { self.lengths.get_or(id, 0) } else { 0 }
    }

    fn append(borrow self, id: u64, inout out: StrBuf) {
        let n = self.string_len(id);
        let mut i: u64 = 0;
        while i < n { out.push(self.byte_at(id, i)); i = i + 1; }
    }

    fn copy(borrow self, id: u64) -> StrBuf {
        let mut out = StrBuf.new();
        self.append(id, inout out);
        out
    }

    fn equals(borrow self, id: u64, borrow value: StrBuf) -> bool {
        let n = self.string_len(id);
        if n != value.len() { return false; }
        let mut i: u64 = 0;
        while i < n {
            let b = match value.byte_at(i) { OptU8.Some(x) => x, OptU8.None => 0 };
            if self.byte_at(id, i) != b { return false; }
            i = i + 1;
        }
        true
    }

    fn ids_equal(borrow self, a: u64, b: u64) -> bool {
        let n = self.string_len(a);
        if n != self.string_len(b) { return false; }
        let mut i: u64 = 0;
        while i < n {
            if self.byte_at(a, i) != self.byte_at(b, i) { return false; }
            i = i + 1;
        }
        true
    }

    fn starts_with(borrow self, id: u64, borrow prefix: StrBuf) -> bool {
        if prefix.len() > self.string_len(id) { return false; }
        let mut i: u64 = 0;
        while i < prefix.len() {
            let b = match prefix.byte_at(i) { OptU8.Some(x) => x, OptU8.None => 0 };
            if self.byte_at(id, i) != b { return false; }
            i = i + 1;
        }
        true
    }

    fn hash(borrow self, id: u64) -> u64 {
        let mut h: u64 = 14695981039346656037;
        let mut i: u64 = 0;
        while i < self.string_len(id) {
            h = h ^ @intCast(self.byte_at(id, i));
            h = @wrapping_mul(h, 1099511628211);
            i = i + 1;
        }
        h
    }
}
