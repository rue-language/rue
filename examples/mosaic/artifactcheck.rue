// Validators for shared non-HTML artifacts. These run before each corresponding
// write and provide independent structural checks for JSON, XML, CSS, and robots.
const std = @import("std");
const text = @import("text.rue");
const utf8 = @import("utf8.rue");
const StrBuf = std.strbuf.StrBuf;

pub struct Result {
    ok: bool,
    records: u64,
    error: StrBuf,
}

fn success(records: u64) -> Result {
    Result { ok: true, records: records, error: StrBuf.new() }
}

fn failure(message: StrBuf) -> Result {
    Result { ok: false, records: 0, error: message }
}

fn contains(borrow value: StrBuf, needle: StrBuf) -> bool {
    if needle.len() == 0 {
        return true;
    }
    let mut i: u64 = 0;
    while i + needle.len() <= value.len() {
        let mut matched = true;
        let mut j: u64 = 0;
        while j < needle.len() {
            if text.byte_of(borrow value, i + j) != text.byte_of(borrow needle, j) {
                matched = false;
                j = needle.len();
            } else {
                j += 1;
            }
        }
        if matched {
            return true;
        }
        i += 1;
    }
    false
}

fn count(borrow value: StrBuf, needle: StrBuf) -> u64 {
    if needle.len() == 0 {
        return 0;
    }
    let mut total: u64 = 0;
    let mut i: u64 = 0;
    while i + needle.len() <= value.len() {
        let mut matched = true;
        let mut j: u64 = 0;
        while j < needle.len() {
            if text.byte_of(borrow value, i + j) != text.byte_of(borrow needle, j) {
                matched = false;
                j = needle.len();
            } else {
                j += 1;
            }
        }
        if matched {
            total += 1;
            i += needle.len();
        } else {
            i += 1;
        }
    }
    total
}

fn balanced_bytes(borrow value: StrBuf, open: u8, close: u8) -> bool {
    let mut depth: i64 = 0;
    let mut in_string = false;
    let mut escaped = false;
    let mut i: u64 = 0;
    while i < value.len() {
        let b = text.byte_of(borrow value, i);
        if in_string {
            if escaped {
                escaped = false;
            } else if b == 92 {
                escaped = true;
            } else if b == 34 {
                in_string = false;
            }
        } else if b == 34 {
            in_string = true;
        } else if b == open {
            depth += 1;
        } else if b == close {
            depth -= 1;
            if depth < 0 {
                return false;
            }
        }
        i += 1;
    }
    depth == 0 && !in_string && !escaped
}

pub fn search_json(borrow value: StrBuf, expected_pages: u64) -> Result {
    if !utf8.validate(borrow value).ok {
        return failure("search index is not UTF-8");
    }
    if value.len() < 2 || text.byte_of(borrow value, 0) != 123 {
        return failure("search index is not a JSON object");
    }
    if !balanced_bytes(borrow value, 123, 125) || !balanced_bytes(borrow value, 91, 93) {
        return failure("search index JSON delimiters are unbalanced");
    }
    if !contains(borrow value, "\"version\":1") {
        return failure("search index has no supported version");
    }
    if !contains(borrow value, "\"terms\":[") || !contains(borrow value, "\"pages\":[") {
        return failure("search index is missing terms or pages");
    }
    let pages = count(borrow value, "\"url\":");
    if pages != expected_pages {
        return failure("search index page count disagrees with published pages");
    }
    success(pages)
}

pub fn sitemap_xml(borrow value: StrBuf, expected_pages: u64) -> Result {
    if !utf8.validate(borrow value).ok {
        return failure("sitemap is not UTF-8");
    }
    if !contains(borrow value, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>") {
        return failure("sitemap lacks the XML declaration");
    }
    if count(borrow value, "<urlset ") != 1 || count(borrow value, "</urlset>") != 1 {
        return failure("sitemap urlset is missing or duplicated");
    }
    let opens = count(borrow value, "<url><loc>");
    let closes = count(borrow value, "</loc></url>");
    if opens != closes {
        return failure("sitemap URL records are unbalanced");
    }
    if opens != expected_pages {
        return failure("sitemap page count disagrees with published pages");
    }
    success(opens)
}

pub fn stylesheet(borrow value: StrBuf) -> Result {
    if !utf8.validate(borrow value).ok {
        return failure("stylesheet is not UTF-8");
    }
    if !balanced_bytes(borrow value, 123, 125) {
        return failure("stylesheet rule braces are unbalanced");
    }
    if !contains(borrow value, ":root") {
        return failure("stylesheet has no root rule");
    }
    if !contains(borrow value, ".skip:focus") {
        return failure("stylesheet lacks visible keyboard skip-link behavior");
    }
    if !contains(borrow value, "@media") {
        return failure("stylesheet lacks responsive rules");
    }
    success(text.count_byte(borrow value, 123))
}

pub fn robots(borrow value: StrBuf) -> Result {
    if !utf8.validate(borrow value).ok {
        return failure("robots output is not UTF-8");
    }
    if !contains(borrow value, "User-agent: *\n") {
        return failure("robots output has no user-agent record");
    }
    if !contains(borrow value, "Allow: /\n") {
        return failure("robots output has no allow policy");
    }
    if count(borrow value, "Sitemap: ") != 1 {
        return failure("robots output needs exactly one sitemap record");
    }
    success(1)
}
