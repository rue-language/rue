// Cross-check rendered HTML against the semantic page model. htmlcheck proves
// shell balance; this audit verifies counts and identity derived from the arenas.
const std = @import("std");
const htmlcheck = @import("htmlcheck.rue");
const model = @import("model.rue");
const navigation = @import("navigation.rue");
const text = @import("text.rue");
const StrBuf = std.strbuf.StrBuf;

pub struct Result {
    ok: bool,
    expected_headings: u64,
    actual_headings: u64,
    expected_links: u64,
    actual_links: u64,
    expected_tables: u64,
    actual_tables: u64,
    error: StrBuf,
}

fn count(borrow value: StrBuf, needle: StrBuf) -> u64 {
    if needle.len() == 0 || needle.len() > value.len() {
        return 0;
    }
    let mut total: u64 = 0;
    let mut i: u64 = 0;
    while i + needle.len() <= value.len() {
        let mut yes = true;
        let mut j: u64 = 0;
        while j < needle.len() {
            if text.byte_of(borrow value, i + j) != text.byte_of(borrow needle, j) {
                yes = false;
                j = needle.len();
            } else {
                j += 1;
            }
        }
        if yes {
            total += 1;
            i += needle.len();
        } else {
            i += 1;
        }
    }
    total
}

fn expected_block_count(borrow site: model.Site, page_index: u64, tag: u64) -> u64 {
    let page = site.pages.get_or(page_index, model.empty_page());
    let mut total: u64 = 0;
    let mut i = page.block_start;
    while i < page.block_start + page.block_count {
        let block = site.blocks.get_or(i, model.Block {
            tag: 0,
            text_id: 0,
            level: 0,
            first: 0,
            count: 0,
            line: 0,
            aux: 0,
        });
        if block.tag == tag {
            total += 1;
        }
        i += 1;
    }
    total
}

fn expected_toc_count(borrow site: model.Site, page_index: u64) -> u64 {
    let page = site.pages.get_or(page_index, model.empty_page());
    let mut total: u64 = 0;
    let mut i = page.block_start;
    while i < page.block_start + page.block_count {
        let block = site.blocks.get_or(i, model.Block {
            tag: 0,
            text_id: 0,
            level: 0,
            first: 0,
            count: 0,
            line: 0,
            aux: 0,
        });
        if block.tag == model.BLOCK_HEADING() && block.level >= 2 {
            total += 1;
        }
        i += 1;
    }
    total
}

fn expected_rendered_links(borrow site: model.Site, page_index: u64) -> u64 {
    let page = site.pages.get_or(page_index, model.empty_page());
    let content = page.link_count;
    // The rendered primary-navigation window plus the brand link and
    // keyboard skip link.
    let primary = navigation.window_len(borrow site) + 2;
    let mut pager: u64 = 0;
    let mut pos: u64 = 0;
    while pos < site.navigation.len() {
        if site.navigation.get_or(pos, model.NONE()) == page_index {
            if pos > 0 {
                pager += 1;
            }
            if pos + 1 < site.navigation.len() {
                pager += 1;
            }
            pos = site.navigation.len();
        } else {
            pos += 1;
        }
    }
    let toc_links = expected_toc_count(borrow site, page_index);
    content + primary + pager + toc_links
}

fn result(
    ok: bool,
    expected_headings: u64,
    actual_headings: u64,
    expected_links: u64,
    actual_links: u64,
    expected_tables: u64,
    actual_tables: u64,
    error: StrBuf,
) -> Result {
    Result {
        ok: ok,
        expected_headings: expected_headings,
        actual_headings: actual_headings,
        expected_links: expected_links,
        actual_links: actual_links,
        expected_tables: expected_tables,
        actual_tables: actual_tables,
        error: error,
    }
}

pub fn verify(borrow site: model.Site, page_index: u64, borrow html: StrBuf) -> Result {
    let basic = htmlcheck.verify(borrow html);
    let content_headings = expected_block_count(borrow site, page_index, model.BLOCK_HEADING());
    let expected_headings = if expected_toc_count(borrow site, page_index) > 0 {
        content_headings + 1
    } else {
        content_headings
    };
    let actual_headings = basic.headings;
    let expected_links = expected_rendered_links(borrow site, page_index);
    let actual_links = count(borrow html, "<a ");
    let expected_tables = expected_block_count(borrow site, page_index, model.BLOCK_TABLE());
    let actual_tables = count(borrow html, "<table>");
    if !basic.ok {
        return result(false, expected_headings, actual_headings, expected_links, actual_links, expected_tables, actual_tables, basic.error);
    }
    if expected_headings != actual_headings {
        return result(false, expected_headings, actual_headings, expected_links, actual_links, expected_tables, actual_tables, "rendered heading count disagrees with page model");
    }
    if expected_links != actual_links {
        return result(false, expected_headings, actual_headings, expected_links, actual_links, expected_tables, actual_tables, "rendered link count disagrees with page model");
    }
    if expected_tables != actual_tables {
        return result(false, expected_headings, actual_headings, expected_links, actual_links, expected_tables, actual_tables, "rendered table count disagrees with page model");
    }
    result(true, expected_headings, actual_headings, expected_links, actual_links, expected_tables, actual_tables, StrBuf.new())
}
