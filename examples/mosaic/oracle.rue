// Independent source scanner used as a differential invariant. It does not call
// the block or inline parser: a single byte-state machine counts source-level
// headings, fenced code blocks, link forms, and table candidates, then compares
// those observations with the canonical arenas for the page.
const std = @import("std");
const model = @import("model.rue");
const text = @import("text.rue");
const StrBuf = std.strbuf.StrBuf;

pub struct Inventory {
    headings: u64,
    links: u64,
    fences: u64,
    tables: u64,
    list_items: u64,
    quotes: u64,
    rules: u64,
    words: u64,
    lines: u64,
    balanced_fences: bool,
}

fn blank_inventory() -> Inventory {
    Inventory {
        headings: 0,
        links: 0,
        fences: 0,
        tables: 0,
        list_items: 0,
        quotes: 0,
        rules: 0,
        words: 0,
        lines: 0,
        balanced_fences: true,
    }
}

fn line_heading(borrow line: StrBuf) -> bool {
    let mut i: u64 = 0;
    while i < line.len() && i < 6 && text.byte_of(borrow line, i) == 35 {
        i += 1;
    }
    i > 0 && i < line.len() && text.byte_of(borrow line, i) == 32
}

fn line_fence(borrow line: StrBuf) -> bool {
    line.len() >= 3 &&
        text.byte_of(borrow line, 0) == 96 &&
        text.byte_of(borrow line, 1) == 96 &&
        text.byte_of(borrow line, 2) == 96
}

fn line_list_item(borrow line: StrBuf) -> bool {
    if line.len() >= 2 {
        let first = text.byte_of(borrow line, 0);
        if (first == 45 || first == 42 || first == 43) && text.byte_of(borrow line, 1) == 32 {
            return true;
        }
    }
    let mut i: u64 = 0;
    while i < line.len() && text.is_digit(text.byte_of(borrow line, i)) {
        i += 1;
    }
    i > 0 && i + 1 < line.len() && text.byte_of(borrow line, i) == 46 && text.byte_of(borrow line, i + 1) == 32
}

fn line_rule(borrow line: StrBuf) -> bool {
    if line.len() < 3 {
        return false;
    }
    let marker = text.byte_of(borrow line, 0);
    if marker != 45 && marker != 42 && marker != 95 {
        return false;
    }
    let mut count: u64 = 0;
    let mut i: u64 = 0;
    while i < line.len() {
        let b = text.byte_of(borrow line, i);
        if b == marker {
            count += 1;
        } else if !text.is_space(b) {
            return false;
        }
        i += 1;
    }
    count >= 3
}

fn links_on_line(borrow line: StrBuf) -> u64 {
    let mut count: u64 = 0;
    let mut i: u64 = 0;
    while i < line.len() {
        if text.byte_of(borrow line, i) == 92 {
            i += 2;
        } else if text.byte_of(borrow line, i) == 91 {
            let close = text.find_byte(borrow line, 93, i + 1);
            if close + 1 < line.len() && text.byte_of(borrow line, close + 1) == 40 {
                let target_close = text.find_byte(borrow line, 41, close + 2);
                if target_close < line.len() {
                    count += 1;
                    i = target_close + 1;
                } else {
                    i += 1;
                }
            } else {
                i += 1;
            }
        } else {
            i += 1;
        }
    }
    count
}

fn words_on_line(borrow line: StrBuf) -> u64 {
    let mut count: u64 = 0;
    let mut inside = false;
    let mut i: u64 = 0;
    while i < line.len() {
        if text.is_alnum(text.byte_of(borrow line, i)) {
            if !inside {
                count += 1;
                inside = true;
            }
        } else {
            inside = false;
        }
        i += 1;
    }
    count
}

fn front_matter_end(borrow source: StrBuf) -> u64 {
    let first = text.line_at(borrow source, 0);
    if !text.equals_literal(borrow first, "---") {
        return 0;
    }
    let mut offset = text.next_line(borrow source, 0);
    while offset < source.len() {
        let line = text.line_at(borrow source, offset);
        if text.equals_literal(borrow line, "---") {
            return text.next_line(borrow source, offset);
        }
        offset = text.next_line(borrow source, offset);
    }
    source.len()
}

pub fn scan(borrow source: StrBuf) -> Inventory {
    let mut result = blank_inventory();
    let mut offset = front_matter_end(borrow source);
    let mut in_fence = false;
    let mut previous_had_pipes = false;
    while offset < source.len() {
        let line = text.line_at(borrow source, offset);
        result.lines += 1;
        if line_fence(borrow line) {
            if in_fence {
                in_fence = false;
            } else {
                in_fence = true;
                result.fences += 1;
            }
        } else if !in_fence {
            if line_heading(borrow line) {
                result.headings += 1;
            }
            if line_list_item(borrow line) {
                result.list_items += 1;
            }
            if line.len() > 0 && text.byte_of(borrow line, 0) == 62 {
                result.quotes += 1;
            }
            if line_rule(borrow line) {
                result.rules += 1;
            }
            let pipes = text.count_byte(borrow line, 124) > 0;
            if previous_had_pipes && pipes && text.count_byte(borrow line, 45) >= 3 {
                result.tables += 1;
            }
            previous_had_pipes = pipes;
            result.links += links_on_line(borrow line);
            result.words += words_on_line(borrow line);
        }
        offset = text.next_line(borrow source, offset);
    }
    result.balanced_fences = !in_fence;
    result
}

fn actual_blocks(borrow site: model.Site, page_index: u64, tag: u64) -> u64 {
    let page = site.pages.get_or(page_index, model.empty_page());
    let mut count: u64 = 0;
    let mut i = page.block_start;
    while i < page.block_start + page.block_count {
        if site.blocks.get_or(i, model.Block { tag: 0, text_id: 0, level: 0, first: 0, count: 0, line: 0, aux: 0 }).tag == tag {
            count += 1;
        }
        i += 1;
    }
    count
}

fn mismatch(inout site: model.Site, page_index: u64, detail: StrBuf) {
    let page = site.pages.get_or(page_index, model.empty_page());
    model.add_error(inout site, 203, page.source_id, 0, detail);
}

pub fn compare(inout site: model.Site, page_index: u64, borrow source: StrBuf) {
    let expected = scan(borrow source);
    let page = site.pages.get_or(page_index, model.empty_page());
    if expected.headings != actual_blocks(borrow site, page_index, model.BLOCK_HEADING()) {
        mismatch(inout site, page_index, "heading parser disagrees with source oracle");
    }
    if expected.fences != actual_blocks(borrow site, page_index, model.BLOCK_CODE()) {
        mismatch(inout site, page_index, "fenced-code parser disagrees with source oracle");
    }
    if expected.tables != actual_blocks(borrow site, page_index, model.BLOCK_TABLE()) {
        mismatch(inout site, page_index, "table parser disagrees with source oracle");
    }
    if expected.list_items != actual_blocks(borrow site, page_index, model.BLOCK_ITEM()) {
        mismatch(inout site, page_index, "list parser disagrees with source oracle");
    }
    if expected.quotes != actual_blocks(borrow site, page_index, model.BLOCK_QUOTE()) {
        mismatch(inout site, page_index, "quote parser disagrees with source oracle");
    }
    if expected.rules != actual_blocks(borrow site, page_index, model.BLOCK_RULE()) {
        mismatch(inout site, page_index, "rule parser disagrees with source oracle");
    }
    if expected.links != page.link_count {
        mismatch(inout site, page_index, "inline-link parser disagrees with source oracle");
    }
    if !expected.balanced_fences {
        mismatch(inout site, page_index, "source oracle found an unterminated fence");
    }
}
