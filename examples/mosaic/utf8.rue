// Strict UTF-8 validator for document bytes. Markup punctuation is ASCII, but
// content is UTF-8 and must reject overlong encodings, surrogates, truncation,
// and code points above U+10FFFF before byte-preserving rendering.
const std = @import("std");
const text = @import("text.rue");
const StrBuf = std.strbuf.StrBuf;

pub struct Result {
    ok: bool,
    offset: u64,
    codepoints: u64,
    ascii: u64,
    multibyte: u64,
}

fn continuation(b: u8) -> bool {
    b >= 128 && b <= 191
}

fn fail(offset: u64, codepoints: u64, ascii: u64, multibyte: u64) -> Result {
    Result {
        ok: false,
        offset: offset,
        codepoints: codepoints,
        ascii: ascii,
        multibyte: multibyte,
    }
}

pub fn validate(borrow source: StrBuf) -> Result {
    let mut i: u64 = 0;
    let mut codepoints: u64 = 0;
    let mut ascii: u64 = 0;
    let mut multibyte: u64 = 0;
    while i < source.len() {
        let first = text.byte_of(borrow source, i);
        if first <= 127 {
            ascii += 1;
            codepoints += 1;
            i += 1;
        } else if first >= 194 && first <= 223 {
            if i + 1 >= source.len() {
                return fail(i, codepoints, ascii, multibyte);
            }
            let second = text.byte_of(borrow source, i + 1);
            if !continuation(second) {
                return fail(i, codepoints, ascii, multibyte);
            }
            multibyte += 1;
            codepoints += 1;
            i += 2;
        } else if first >= 224 && first <= 239 {
            if i + 2 >= source.len() {
                return fail(i, codepoints, ascii, multibyte);
            }
            let second = text.byte_of(borrow source, i + 1);
            let third = text.byte_of(borrow source, i + 2);
            if !continuation(second) || !continuation(third) {
                return fail(i, codepoints, ascii, multibyte);
            }
            if first == 224 && second < 160 {
                return fail(i, codepoints, ascii, multibyte);
            }
            if first == 237 && second > 159 {
                return fail(i, codepoints, ascii, multibyte);
            }
            multibyte += 1;
            codepoints += 1;
            i += 3;
        } else if first >= 240 && first <= 244 {
            if i + 3 >= source.len() {
                return fail(i, codepoints, ascii, multibyte);
            }
            let second = text.byte_of(borrow source, i + 1);
            let third = text.byte_of(borrow source, i + 2);
            let fourth = text.byte_of(borrow source, i + 3);
            if !continuation(second) || !continuation(third) || !continuation(fourth) {
                return fail(i, codepoints, ascii, multibyte);
            }
            if first == 240 && second < 144 {
                return fail(i, codepoints, ascii, multibyte);
            }
            if first == 244 && second > 143 {
                return fail(i, codepoints, ascii, multibyte);
            }
            multibyte += 1;
            codepoints += 1;
            i += 4;
        } else {
            return fail(i, codepoints, ascii, multibyte);
        }
    }
    Result {
        ok: true,
        offset: source.len(),
        codepoints: codepoints,
        ascii: ascii,
        multibyte: multibyte,
    }
}

pub fn codepoint_width(first: u8) -> u64 {
    if first <= 127 {
        1
    } else if first >= 194 && first <= 223 {
        2
    } else if first >= 224 && first <= 239 {
        3
    } else if first >= 240 && first <= 244 {
        4
    } else {
        0
    }
}

pub fn count(borrow source: StrBuf) -> u64 {
    let validation = validate(borrow source);
    if validation.ok { validation.codepoints } else { 0 }
}
