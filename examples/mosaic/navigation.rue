// Deterministic site navigation and previous/next page links.
const std = @import("std");
const escape = @import("escape.rue");
const model = @import("model.rue");
const text = @import("text.rue");
const StrBuf = std.strbuf.StrBuf;

fn append_borrowed(borrow value: StrBuf, inout out: StrBuf) {
    let mut i: u64 = 0;
    while i < value.len() { out.push(text.byte_of(borrow value, i)); i = i + 1; }
}

fn append_page_link(borrow site: model.Site, page_index: u64, current: u64, inout out: StrBuf) {
    let page = site.pages.get_or(page_index, model.empty_page());
    out.push_str("<li");
    if page_index == current { out.push_str(" aria-current=\"page\""); }
    out.push_str("><a href=\"");
    let path = site.strings.copy(page.output_id);
    escape.url_attribute(borrow path, inout out);
    out.push_str("\">");
    let title = site.strings.copy(page.title_id);
    escape.html_text(borrow title, inout out);
    out.push_str("</a></li>");
}

pub fn primary(borrow site: model.Site, current: u64) -> StrBuf {
    let mut out = StrBuf.new();
    out.push_str("<nav class=\"site-nav\" aria-label=\"Primary\"><ul>");
    let mut i: u64 = 0;
    while i < site.navigation.len() {
        append_page_link(borrow site, site.navigation.get_or(i, 0), current, inout out);
        i = i + 1;
    }
    out.push_str("</ul></nav>");
    out
}

fn position(borrow site: model.Site, page_index: u64) -> u64 {
    let mut i: u64 = 0;
    while i < site.navigation.len() {
        if site.navigation.get_or(i, model.NONE()) == page_index { return i; }
        i = i + 1;
    }
    model.NONE()
}

fn adjacent_link(borrow site: model.Site, nav_index: u64, borrow relation: StrBuf, inout out: StrBuf) {
    let page_index = site.navigation.get_or(nav_index, 0);
    let page = site.pages.get_or(page_index, model.empty_page());
    out.push_str("<a rel=\""); append_borrowed(borrow relation, inout out); out.push_str("\" href=\"");
    let path = site.strings.copy(page.output_id);
    escape.url_attribute(borrow path, inout out);
    out.push_str("\">");
    let title = site.strings.copy(page.title_id);
    escape.html_text(borrow title, inout out);
    out.push_str("</a>");
}

pub fn pager(borrow site: model.Site, page_index: u64) -> StrBuf {
    let mut out = StrBuf.new();
    let pos = position(borrow site, page_index);
    let prev: StrBuf = "prev";
    let next: StrBuf = "next";
    if pos == model.NONE() { return out; }
    out.push_str("<nav class=\"pager\" aria-label=\"Page navigation\">");
    if pos > 0 { adjacent_link(borrow site, pos - 1, borrow prev, inout out); }
    if pos + 1 < site.navigation.len() { adjacent_link(borrow site, pos + 1, borrow next, inout out); }
    out.push_str("</nav>");
    out
}
