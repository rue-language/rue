// Derived graph-degree and edge-kind metrics.
const std = @import("std");
const model = @import("model.rue");
const text = @import("text.rue");

pub struct Analysis {
    internal: u64,
    external: u64,
    fragments: u64,
    self_links: u64,
    unresolved: u64,
    max_inbound: u64,
    max_outbound: u64,
}

pub fn collect(borrow site: model.Site) -> Analysis {
    let mut value = Analysis {
        internal: 0,
        external: 0,
        fragments: 0,
        self_links: 0,
        unresolved: 0,
        max_inbound: 0,
        max_outbound: 0,
    };
    let mut inbound = model.U64s.new();
    let mut outbound = model.U64s.new();
    let mut i: u64 = 0;
    while i < site.pages.len() {
        inbound.push(0);
        outbound.push(0);
        i += 1;
    }
    i = 0;
    while i < site.links.len() {
        let link = site.links.get_or(i, model.Link {
            source_page: 0,
            target_id: 0,
            label_id: 0,
            line: 0,
            resolved_page: model.NONE(),
            resolved_anchor: model.NONE(),
            external: false,
        });
        if link.external {
            value.external += 1;
        } else if link.resolved_page == model.NONE() {
            value.unresolved += 1;
        } else {
            value.internal += 1;
            inbound.set(link.resolved_page, inbound.get_or(link.resolved_page, 0) + 1);
            outbound.set(link.source_page, outbound.get_or(link.source_page, 0) + 1);
            if link.source_page == link.resolved_page {
                value.self_links += 1;
            }
            let target = site.strings.copy(link.target_id);
            if text.find_byte(borrow target, 35, 0) < target.len() {
                value.fragments += 1;
            }
        }
        i += 1;
    }
    i = 0;
    while i < site.pages.len() {
        let incoming = inbound.get_or(i, 0);
        let outgoing = outbound.get_or(i, 0);
        if incoming > value.max_inbound {
            value.max_inbound = incoming;
        }
        if outgoing > value.max_outbound {
            value.max_outbound = outgoing;
        }
        i += 1;
    }
    value
}

pub fn append(borrow value: Analysis, inout out: std.strbuf.StrBuf) {
    out.push_str("external_links=");
    out.push_str(@to_string(value.external));
    out.push(10);
    out.push_str("fragment_links=");
    out.push_str(@to_string(value.fragments));
    out.push(10);
    out.push_str("self_links=");
    out.push_str(@to_string(value.self_links));
    out.push(10);
    out.push_str("unresolved_links=");
    out.push_str(@to_string(value.unresolved));
    out.push(10);
    out.push_str("max_inbound=");
    out.push_str(@to_string(value.max_inbound));
    out.push(10);
    out.push_str("max_outbound=");
    out.push_str(@to_string(value.max_outbound));
    out.push(10);
}
