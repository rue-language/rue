// Inline markup parser. It emits a flat arena because rendering needs source
// order rather than recursive ownership. Delimiter content becomes one tagged
// node; links additionally populate the cross-document graph.
const std = @import("std");
const model = @import("model.rue");
const text = @import("text.rue");
const StrBuf = std.strbuf.StrBuf;

fn flush_text(
    inout site: model.Site,
    borrow value: StrBuf,
    start: u64,
    end: u64,
    line: u64,
) {
    if end <= start { return; }
    let piece = text.slice(borrow value, start, end);
    let id = site.strings.intern(borrow piece);
    site.inlines.push(model.Inline { tag: model.INLINE_TEXT(), text_id: id, target_id: model.NONE(), line: line });
}

fn push_tagged(
    inout site: model.Site,
    tag: u64,
    borrow value: StrBuf,
    start: u64,
    end: u64,
    line: u64,
) {
    let piece = text.slice(borrow value, start, end);
    let id = site.strings.intern(borrow piece);
    site.inlines.push(model.Inline { tag: tag, text_id: id, target_id: model.NONE(), line: line });
}

fn is_external(borrow target: StrBuf) -> bool {
    let http: StrBuf = "http://";
    let https: StrBuf = "https://";
    let mailto: StrBuf = "mailto:";
    text.starts_with(borrow target, borrow http) ||
        text.starts_with(borrow target, borrow https) ||
        text.starts_with(borrow target, borrow mailto)
}

fn parse_link(
    inout site: model.Site,
    page_index: u64,
    borrow value: StrBuf,
    open: u64,
    line: u64,
) -> u64 {
    let close_label = text.find_byte(borrow value, 93, open + 1);
    if close_label >= value.len() || close_label + 1 >= value.len() || text.byte_of(borrow value, close_label + 1) != 40 {
        return open;
    }
    let close_target = text.find_byte(borrow value, 41, close_label + 2);
    if close_target >= value.len() { return open; }
    let label = text.slice(borrow value, open + 1, close_label);
    let raw_target = text.slice(borrow value, close_label + 2, close_target);
    let target = text.trim(borrow raw_target);
    if label.len() == 0 || target.len() == 0 { return open; }
    let label_id = site.strings.intern(borrow label);
    let target_id = site.strings.intern(borrow target);
    site.inlines.push(model.Inline {
        tag: model.INLINE_LINK(), text_id: label_id, target_id: target_id, line: line,
    });
    site.links.push(model.Link {
        source_page: page_index,
        target_id: target_id,
        label_id: label_id,
        line: line,
        resolved_page: model.NONE(),
        resolved_anchor: model.NONE(),
        external: is_external(borrow target),
    });
    close_target + 1
}

fn find_closing(borrow value: StrBuf, byte: u8, start: u64) -> u64 {
    let mut i = start;
    while i < value.len() {
        if text.byte_of(borrow value, i) == 92 { i = i + 2; }
        else if text.byte_of(borrow value, i) == byte { return i; }
        else { i = i + 1; }
    }
    value.len()
}

fn find_double_closing(borrow value: StrBuf, byte: u8, start: u64) -> u64 {
    let mut i = start;
    while i + 1 < value.len() {
        if text.byte_of(borrow value, i) == 92 { i = i + 2; }
        else if text.byte_of(borrow value, i) == byte && text.byte_of(borrow value, i + 1) == byte { return i; }
        else { i = i + 1; }
    }
    value.len()
}

pub fn parse(inout site: model.Site, page_index: u64, borrow value: StrBuf, line: u64) -> model.U64s {
    let mut created = model.U64s.new();
    let first = site.inlines.len();
    let mut plain_start: u64 = 0;
    let mut i: u64 = 0;
    while i < value.len() {
        let b = text.byte_of(borrow value, i);
        if b == 92 && i + 1 < value.len() {
            flush_text(inout site, borrow value, plain_start, i, line);
            let escaped = text.slice(borrow value, i + 1, i + 2);
            let id = site.strings.intern(borrow escaped);
            site.inlines.push(model.Inline { tag: model.INLINE_ESCAPE(), text_id: id, target_id: model.NONE(), line: line });
            i += 2;
            plain_start = i;
        } else if b == 91 {
            let after = parse_link(inout site, page_index, borrow value, i, line);
            if after != i {
                flush_text(inout site, borrow value, plain_start, i, line);
                i = after;
                plain_start = i;
            } else { i = i + 1; }
        } else if b == 96 {
            let close = find_closing(borrow value, 96, i + 1);
            if close < value.len() {
                flush_text(inout site, borrow value, plain_start, i, line);
                push_tagged(inout site, model.INLINE_CODE(), borrow value, i + 1, close, line);
                i = close + 1;
                plain_start = i;
            } else { i = i + 1; }
        } else if (b == 42 || b == 95) && i + 1 < value.len() && text.byte_of(borrow value, i + 1) == b {
            let close = find_double_closing(borrow value, b, i + 2);
            if close < value.len() {
                flush_text(inout site, borrow value, plain_start, i, line);
                push_tagged(inout site, model.INLINE_STRONG(), borrow value, i + 2, close, line);
                i = close + 2;
                plain_start = i;
            } else { i = i + 1; }
        } else if b == 42 || b == 95 {
            let close = find_closing(borrow value, b, i + 1);
            if close < value.len() {
                flush_text(inout site, borrow value, plain_start, i, line);
                push_tagged(inout site, model.INLINE_EMPHASIS(), borrow value, i + 1, close, line);
                i = close + 1;
                plain_start = i;
            } else { i = i + 1; }
        } else {
            i += 1;
        }
    }
    flush_text(inout site, borrow value, plain_start, value.len(), line);
    let mut n = first;
    while n < site.inlines.len() { created.push(n); n = n + 1; }
    created
}

pub fn word_count(borrow value: StrBuf) -> u64 {
    let mut words: u64 = 0;
    let mut inside = false;
    let mut i: u64 = 0;
    while i < value.len() {
        let b = text.byte_of(borrow value, i);
        if text.is_alnum(b) {
            if !inside { words = words + 1; inside = true; }
        } else { inside = false; }
        i += 1;
    }
    words
}
