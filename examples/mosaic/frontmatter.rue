// YAML-shaped front matter parser. Mosaic accepts a deliberately bounded
// `key: value` subset between `---` delimiters and reports malformed or unknown
// metadata rather than silently dropping it.
const std = @import("std");
const model = @import("model.rue");
const text = @import("text.rue");
const StrBuf = std.strbuf.StrBuf;

pub struct Result {
    body_start: u64,
    first_body_line: u64,
    had_front_matter: bool,
}

fn parse_bool(borrow value: StrBuf) -> u64 {
    if text.equals_literal(borrow value, "true") { 1 }
    else if text.equals_literal(borrow value, "false") { 0 }
    else { 2 }
}

fn parse_u64(borrow value: StrBuf) -> u64 {
    if value.len() == 0 { return model.NONE(); }
    let mut n: u64 = 0;
    let mut i: u64 = 0;
    while i < value.len() {
        let b = text.byte_of(borrow value, i);
        if !text.is_digit(b) { return model.NONE(); }
        n = n * 10 + @intCast(b - 48);
        i += 1;
    }
    n
}

fn apply_field(
    inout site: model.Site,
    page_index: u64,
    borrow key: StrBuf,
    borrow value: StrBuf,
    line: u64,
) {
    let mut page = site.pages.get_or(page_index, model.empty_page());
    if text.equals_literal(borrow key, "title") {
        if value.len() == 0 {
            model.add_error(inout site, 201, page.source_id, line, "title metadata cannot be empty");
        } else {
            page.title_id = site.strings.intern(borrow value);
        }
    } else if text.equals_literal(borrow key, "description") {
        page.description_id = site.strings.intern(borrow value);
    } else if text.equals_literal(borrow key, "template") {
        page.template_id = site.strings.intern(borrow value);
    } else if text.equals_literal(borrow key, "nav_order") {
        let order = parse_u64(borrow value);
        if order == model.NONE() {
            model.add_error(inout site, 201, page.source_id, line, "nav_order must be an unsigned integer");
        } else {
            page.nav_order = order;
        }
    } else if text.equals_literal(borrow key, "draft") {
        let parsed = parse_bool(borrow value);
        if parsed == 2 {
            model.add_error(inout site, 201, page.source_id, line, "draft must be true or false");
        } else {
            page.draft = parsed == 1;
        }
    } else {
        model.add_error(inout site, 201, page.source_id, line, "unknown front matter key");
    }
    site.pages.set(page_index, page);
}

pub fn parse(inout site: model.Site, page_index: u64, borrow source: StrBuf) -> Result {
    let first = text.line_at(borrow source, 0);
    if !text.equals_literal(borrow first, "---") {
        return Result { body_start: 0, first_body_line: 1, had_front_matter: false };
    }
    let mut offset = text.next_line(borrow source, 0);
    let mut line: u64 = 2;
    while offset < source.len() {
        let current = text.line_at(borrow source, offset);
        if text.equals_literal(borrow current, "---") {
            return Result {
                body_start: text.next_line(borrow source, offset),
                first_body_line: line + 1,
                had_front_matter: true,
            };
        }
        if current.len() > 0 {
            let colon = text.find_byte(borrow current, 58, 0);
            if colon >= current.len() {
                let page = site.pages.get_or(page_index, model.empty_page());
                model.add_error(inout site, 201, page.source_id, line, "expected metadata key: value");
            } else {
                let raw_key = text.slice(borrow current, 0, colon);
                let raw_value = text.slice(borrow current, colon + 1, current.len());
                let key = text.trim(borrow raw_key);
                let value = text.trim(borrow raw_value);
                apply_field(inout site, page_index, borrow key, borrow value, line);
            }
        }
        offset = text.next_line(borrow source, offset);
        line += 1;
    }
    let page = site.pages.get_or(page_index, model.empty_page());
    model.add_error(inout site, 201, page.source_id, 1, "unterminated front matter");
    Result { body_start: source.len(), first_body_line: line, had_front_matter: true }
}
