// Block parser for Mosaic's Markdown-like language. The parser recognizes
// headings, paragraphs, fenced code, quotes, unordered/ordered lists, rules,
// and pipe tables. Its output is a flat block arena with explicit ranges.
const std = @import("std");
const frontmatter = @import("frontmatter.rue");
const inline = @import("inline.rue");
const model = @import("model.rue");
const text = @import("text.rue");
const StrBuf = std.strbuf.StrBuf;

fn heading_level(borrow line: StrBuf) -> u64 {
    let mut level: u64 = 0;
    while level < line.len() && level < 6 && text.byte_of(borrow line, level) == 35 { level += 1; }
    if level > 0 && level < line.len() && text.byte_of(borrow line, level) == 32 { level } else { 0 }
}

fn is_rule(borrow line: StrBuf) -> bool {
    if line.len() < 3 { return false; }
    let first = text.byte_of(borrow line, 0);
    if first != 45 && first != 42 && first != 95 { return false; }
    let mut marks: u64 = 0;
    let mut i: u64 = 0;
    while i < line.len() {
        let b = text.byte_of(borrow line, i);
        if b == first { marks += 1; }
        else if !text.is_space(b) { return false; }
        i += 1;
    }
    marks >= 3
}

fn is_fence(borrow line: StrBuf) -> bool {
    line.len() >= 3 && text.byte_of(borrow line, 0) == 96 && text.byte_of(borrow line, 1) == 96 && text.byte_of(borrow line, 2) == 96
}

fn list_prefix(borrow line: StrBuf) -> u64 {
    if line.len() >= 2 {
        let b = text.byte_of(borrow line, 0);
        if (b == 45 || b == 42 || b == 43) && text.byte_of(borrow line, 1) == 32 { return 2; }
    }
    let mut i: u64 = 0;
    while i < line.len() && text.is_digit(text.byte_of(borrow line, i)) { i += 1; }
    if i > 0 && i + 1 < line.len() && text.byte_of(borrow line, i) == 46 && text.byte_of(borrow line, i + 1) == 32 { i + 2 } else { 0 }
}

fn explicit_anchor(borrow heading: StrBuf) -> StrBuf {
    if heading.len() < 4 || text.byte_of(borrow heading, heading.len() - 1) != 125 { return StrBuf.new(); }
    let mut i = heading.len() - 1;
    while i > 1 {
        i -= 1;
        if text.byte_of(borrow heading, i) == 123 && text.byte_of(borrow heading, i + 1) == 35 {
            return text.slice(borrow heading, i + 2, heading.len() - 1);
        }
    }
    StrBuf.new()
}

fn heading_text(borrow heading: StrBuf) -> StrBuf {
    let anchor = explicit_anchor(borrow heading);
    if anchor.len() == 0 { return text.trim(borrow heading); }
    let marker = heading.len() - anchor.len() - 3;
    let raw = text.slice(borrow heading, 0, marker);
    text.trim(borrow raw)
}

fn add_anchor(inout site: model.Site, page_index: u64, block_index: u64, borrow heading: StrBuf, line: u64) {
    let explicit = explicit_anchor(borrow heading);
    let clean = heading_text(borrow heading);
    let slug = if explicit.len() > 0 { explicit } else { text.slugify(borrow clean) };
    let page = site.pages.get_or(page_index, model.empty_page());
    if slug.len() == 0 {
        model.add_error(inout site, 200, page.source_id, line, "heading produces an empty anchor");
        return;
    }
    let id = site.strings.intern(borrow slug);
    let mut i = page.anchor_start;
    while i < site.anchors.len() {
        let anchor = site.anchors.get_or(i, model.Anchor { page: 0, name_id: 0, line: 0, heading_block: 0 });
        if anchor.page == page_index && site.strings.ids_equal(anchor.name_id, id) {
            model.add_error(inout site, 202, page.source_id, line, "duplicate heading anchor");
            return;
        }
        i += 1;
    }
    site.anchors.push(model.Anchor { page: page_index, name_id: id, line: line, heading_block: block_index });
}

fn add_text_block(
    inout site: model.Site,
    page_index: u64,
    tag: u64,
    level: u64,
    borrow content: StrBuf,
    line: u64,
) {
    let first = site.inlines.len();
    let parsed = inline.parse(inout site, page_index, borrow content, line);
    let text_id = site.strings.intern(borrow content);
    site.blocks.push(model.Block {
        tag: tag, text_id: text_id, level: level, first: first,
        count: parsed.len(), line: line, aux: model.NONE(),
    });
}

fn add_code_block(inout site: model.Site, borrow code: StrBuf, borrow language: StrBuf, line: u64) {
    let id = site.strings.intern(borrow code);
    let language_id = site.strings.intern(borrow language);
    site.blocks.push(model.Block {
        tag: model.BLOCK_CODE(), text_id: id, level: 0, first: 0,
        count: 0, line: line, aux: language_id,
    });
}

fn parse_fence(
    inout site: model.Site,
    page_index: u64,
    borrow source: StrBuf,
    start: u64,
    line: u64,
) -> u64 {
    let opener = text.line_at(borrow source, start);
    let raw_language = text.slice(borrow opener, 3, opener.len());
    let language = text.trim(borrow raw_language);
    let mut offset = text.next_line(borrow source, start);
    let mut content = StrBuf.new();
    while offset < source.len() {
        let current = text.line_at(borrow source, offset);
        if is_fence(borrow current) {
            add_code_block(inout site, borrow content, borrow language, line);
            return text.next_line(borrow source, offset);
        }
        let raw_end = text.find_byte(borrow source, 10, offset);
        let raw = text.slice(borrow source, offset, raw_end);
        content.push_str(raw);
        content.push(10);
        offset = text.next_line(borrow source, offset);
    }
    let page = site.pages.get_or(page_index, model.empty_page());
    model.add_error(inout site, 200, page.source_id, line, "unterminated fenced code block");
    add_code_block(inout site, borrow content, borrow language, line);
    source.len()
}

fn parse_paragraph(
    inout site: model.Site,
    page_index: u64,
    borrow source: StrBuf,
    start: u64,
    line: u64,
) -> u64 {
    let mut out = StrBuf.new();
    let mut offset = start;
    while offset < source.len() {
        let current = text.line_at(borrow source, offset);
        if current.len() == 0 { break; }
        if offset != start && (heading_level(borrow current) > 0 || is_fence(borrow current) || list_prefix(borrow current) > 0 || is_rule(borrow current)) { break; }
        if out.len() > 0 { out.push(32); }
        out.push_str(current);
        offset = text.next_line(borrow source, offset);
    }
    add_text_block(inout site, page_index, model.BLOCK_PARAGRAPH(), 0, borrow out, line);
    offset
}

fn parse_list(
    inout site: model.Site,
    page_index: u64,
    borrow source: StrBuf,
    start: u64,
    line: u64,
) -> u64 {
    let first_item = site.blocks.len() + 1;
    let mut count: u64 = 0;
    let mut offset = start;
    let first_line = text.line_at(borrow source, start);
    let ordered = text.is_digit(text.byte_of(borrow first_line, 0));
    site.blocks.push(model.Block {
        tag: model.BLOCK_LIST(), text_id: model.NONE(), level: if ordered { 1 } else { 0 },
        first: first_item, count: 0, line: line, aux: model.NONE(),
    });
    let list_index = first_item - 1;
    let mut current_line = line;
    while offset < source.len() {
        let current = text.line_at(borrow source, offset);
        let prefix = list_prefix(borrow current);
        if prefix == 0 { break; }
        let raw_item = text.slice(borrow current, prefix, current.len());
        let item = text.trim(borrow raw_item);
        add_text_block(inout site, page_index, model.BLOCK_ITEM(), 0, borrow item, current_line);
        count += 1;
        offset = text.next_line(borrow source, offset);
        current_line += 1;
    }
    let mut list = site.blocks.get_or(list_index, model.Block { tag: 0, text_id: 0, level: 0, first: 0, count: 0, line: 0, aux: 0 });
    list.count = count;
    site.blocks.set(list_index, list);
    offset
}

fn is_table_separator(borrow line: StrBuf) -> bool {
    if text.count_byte(borrow line, 124) == 0 { return false; }
    let mut dashes: u64 = 0;
    let mut i: u64 = 0;
    while i < line.len() {
        let b = text.byte_of(borrow line, i);
        if b == 45 { dashes += 1; }
        else if b != 124 && b != 58 && !text.is_space(b) { return false; }
        i += 1;
    }
    dashes >= 3
}

fn add_table_row(inout site: model.Site, page_index: u64, borrow line_text: StrBuf, line: u64) {
    let first = site.inlines.len();
    let mut start: u64 = 0;
    let mut cells: u64 = 0;
    while start < line_text.len() {
        let bar = text.find_byte(borrow line_text, 124, start);
        let raw = text.slice(borrow line_text, start, bar);
        let cell = text.trim(borrow raw);
        if cell.len() > 0 { let _ = inline.parse(inout site, page_index, borrow cell, line); cells += 1; }
        if bar >= line_text.len() { break; }
        start = bar + 1;
    }
    let id = site.strings.intern(borrow line_text);
    site.blocks.push(model.Block {
        tag: model.BLOCK_TABLE_ROW(), text_id: id, level: 0, first: first,
        count: cells, line: line, aux: model.NONE(),
    });
}

fn parse_table(
    inout site: model.Site,
    page_index: u64,
    borrow source: StrBuf,
    start: u64,
    line: u64,
) -> u64 {
    let header = text.line_at(borrow source, start);
    let separator_offset = text.next_line(borrow source, start);
    let _separator = text.line_at(borrow source, separator_offset);
    let first_row = site.blocks.len() + 1;
    site.blocks.push(model.Block {
        tag: model.BLOCK_TABLE(), text_id: model.NONE(), level: 0,
        first: first_row, count: 0, line: line, aux: model.NONE(),
    });
    let table_index = first_row - 1;
    add_table_row(inout site, page_index, borrow header, line);
    let mut count: u64 = 1;
    let mut offset = text.next_line(borrow source, separator_offset);
    let mut current_line = line + 2;
    while offset < source.len() {
        let row = text.line_at(borrow source, offset);
        if row.len() == 0 || text.count_byte(borrow row, 124) == 0 { break; }
        add_table_row(inout site, page_index, borrow row, current_line);
        count += 1;
        offset = text.next_line(borrow source, offset);
        current_line += 1;
    }
    let mut table = site.blocks.get_or(table_index, model.Block { tag: 0, text_id: 0, level: 0, first: 0, count: 0, line: 0, aux: 0 });
    table.count = count;
    site.blocks.set(table_index, table);
    offset
}

pub fn parse_page(inout site: model.Site, page_index: u64, source: StrBuf) {
    let fm = frontmatter.parse(inout site, page_index, borrow source);
    let mut page = site.pages.get_or(page_index, model.empty_page());
    page.block_start = site.blocks.len();
    page.inline_start = site.inlines.len();
    page.anchor_start = site.anchors.len();
    page.link_start = site.links.len();
    site.pages.set(page_index, page);
    let mut offset = fm.body_start;
    let mut line = fm.first_body_line;
    while offset < source.len() {
        let current = text.line_at(borrow source, offset);
        if current.len() == 0 {
            offset = text.next_line(borrow source, offset);
            line += 1;
        } else {
            let level = heading_level(borrow current);
            if level > 0 {
                let raw = text.slice(borrow current, level + 1, current.len());
                let heading = text.trim(borrow raw);
                let clean_heading = heading_text(borrow heading);
                let heading_block = site.blocks.len();
                add_text_block(inout site, page_index, model.BLOCK_HEADING(), level, borrow clean_heading, line);
                add_anchor(inout site, page_index, heading_block, borrow heading, line);
                offset = text.next_line(borrow source, offset);
                line += 1;
            } else if is_fence(borrow current) {
                let next = parse_fence(inout site, page_index, borrow source, offset, line);
                while offset < next { offset = text.next_line(borrow source, offset); line += 1; }
            } else if list_prefix(borrow current) > 0 {
                let next = parse_list(inout site, page_index, borrow source, offset, line);
                while offset < next { offset = text.next_line(borrow source, offset); line += 1; }
            } else if is_rule(borrow current) {
                site.blocks.push(model.Block { tag: model.BLOCK_RULE(), text_id: model.NONE(), level: 0, first: 0, count: 0, line: line, aux: model.NONE() });
                offset = text.next_line(borrow source, offset);
                line += 1;
            } else if text.byte_of(borrow current, 0) == 62 {
                let raw = text.slice(borrow current, 1, current.len());
                let quote = text.trim(borrow raw);
                add_text_block(inout site, page_index, model.BLOCK_QUOTE(), 0, borrow quote, line);
                offset = text.next_line(borrow source, offset);
                line += 1;
            } else {
                let next_offset = text.next_line(borrow source, offset);
                let next = if next_offset < source.len() { text.line_at(borrow source, next_offset) } else { StrBuf.new() };
                if text.count_byte(borrow current, 124) > 0 && is_table_separator(borrow next) {
                    let after = parse_table(inout site, page_index, borrow source, offset, line);
                    while offset < after { offset = text.next_line(borrow source, offset); line += 1; }
                } else {
                    let after = parse_paragraph(inout site, page_index, borrow source, offset, line);
                    while offset < after { offset = text.next_line(borrow source, offset); line += 1; }
                }
            }
        }
    }
    page = site.pages.get_or(page_index, model.empty_page());
    page.block_count = site.blocks.len() - page.block_start;
    page.inline_count = site.inlines.len() - page.inline_start;
    page.anchor_count = site.anchors.len() - page.anchor_start;
    page.link_count = site.links.len() - page.link_start;
    let mut words: u64 = 0;
    let mut b = page.block_start;
    while b < page.block_start + page.block_count {
        let block = site.blocks.get_or(b, model.Block { tag: 0, text_id: 0, level: 0, first: 0, count: 0, line: 0, aux: 0 });
        if block.text_id != model.NONE() {
            let value = site.strings.copy(block.text_id);
            words += inline.word_count(borrow value);
        }
        b += 1;
    }
    page.word_count = words;
    if page.title_id == model.NONE() {
        model.add_error(inout site, 101, page.source_id, 0, "page title is required in manifest or front matter");
    }
    site.pages.set(page_index, page);
}
