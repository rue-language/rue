// Feature coverage profile for a site. This makes workload evolution measurable:
// stats reveal whether every parser and renderer path is represented.
const std = @import("std");
const model = @import("model.rue");

pub struct Coverage {
    paragraphs: u64,
    headings: u64,
    code_blocks: u64,
    lists: u64,
    list_items: u64,
    quotes: u64,
    rules: u64,
    tables: u64,
    table_rows: u64,
    text_inlines: u64,
    emphasis: u64,
    strong: u64,
    code_inlines: u64,
    link_inlines: u64,
    escapes: u64,
    exercised_block_kinds: u64,
    exercised_inline_kinds: u64,
}

pub fn collect(borrow site: model.Site) -> Coverage {
    let mut value = Coverage {
        paragraphs: 0,
        headings: 0,
        code_blocks: 0,
        lists: 0,
        list_items: 0,
        quotes: 0,
        rules: 0,
        tables: 0,
        table_rows: 0,
        text_inlines: 0,
        emphasis: 0,
        strong: 0,
        code_inlines: 0,
        link_inlines: 0,
        escapes: 0,
        exercised_block_kinds: 0,
        exercised_inline_kinds: 0,
    };
    let B = std.bitset.BitSet();
    let mut block_kinds = B.new();
    let mut inline_kinds = B.new();
    let mut i: u64 = 0;
    while i < site.blocks.len() {
        let block = site.blocks.get_or(i, model.Block {
            tag: 0,
            text_id: 0,
            level: 0,
            first: 0,
            count: 0,
            line: 0,
            aux: 0,
        });
        block_kinds.set(block.tag);
        if block.tag == model.BLOCK_PARAGRAPH() {
            value.paragraphs += 1;
        } else if block.tag == model.BLOCK_HEADING() {
            value.headings += 1;
        } else if block.tag == model.BLOCK_CODE() {
            value.code_blocks += 1;
        } else if block.tag == model.BLOCK_LIST() {
            value.lists += 1;
        } else if block.tag == model.BLOCK_ITEM() {
            value.list_items += 1;
        } else if block.tag == model.BLOCK_QUOTE() {
            value.quotes += 1;
        } else if block.tag == model.BLOCK_RULE() {
            value.rules += 1;
        } else if block.tag == model.BLOCK_TABLE() {
            value.tables += 1;
        } else if block.tag == model.BLOCK_TABLE_ROW() {
            value.table_rows += 1;
        }
        i += 1;
    }
    i = 0;
    while i < site.inlines.len() {
        let node = site.inlines.get_or(i, model.Inline {
            tag: 0,
            text_id: 0,
            target_id: 0,
            line: 0,
        });
        inline_kinds.set(node.tag);
        if node.tag == model.INLINE_TEXT() {
            value.text_inlines += 1;
        } else if node.tag == model.INLINE_EMPHASIS() {
            value.emphasis += 1;
        } else if node.tag == model.INLINE_STRONG() {
            value.strong += 1;
        } else if node.tag == model.INLINE_CODE() {
            value.code_inlines += 1;
        } else if node.tag == model.INLINE_LINK() {
            value.link_inlines += 1;
        } else if node.tag == model.INLINE_ESCAPE() {
            value.escapes += 1;
        }
        i += 1;
    }
    value.exercised_block_kinds = block_kinds.count();
    value.exercised_inline_kinds = inline_kinds.count();
    value
}

pub fn complete(borrow value: Coverage) -> bool {
    value.exercised_block_kinds == 9 && value.exercised_inline_kinds == 6
}

pub fn append(borrow value: Coverage, inout out: std.strbuf.StrBuf) {
    out.push_str("block_kinds_exercised=");
    out.push_str(@to_string(value.exercised_block_kinds));
    out.push_str("/9\n");
    out.push_str("inline_kinds_exercised=");
    out.push_str(@to_string(value.exercised_inline_kinds));
    out.push_str("/6\n");
    out.push_str("emphasis_inlines=");
    out.push_str(@to_string(value.emphasis));
    out.push(10);
    out.push_str("strong_inlines=");
    out.push_str(@to_string(value.strong));
    out.push(10);
    out.push_str("code_inlines=");
    out.push_str(@to_string(value.code_inlines));
    out.push(10);
    out.push_str("escape_inlines=");
    out.push_str(@to_string(value.escapes));
    out.push(10);
    out.push_str("feature_complete=");
    if complete(borrow value) {
        out.push_str("true\n");
    } else {
        out.push_str("false\n");
    }
}
