// Dogfood for the source-level std.arraybuf.ArrayBuf(T) library (RUE-1,
// RUE-315).
//
// Compile:
//   RUE_STD_PATH=std rue examples/std/arraybuf_demo.rue -o arraybuf_demo
//
// Exercises push/len/get/set/pop/while-sum/out-of-bounds on an ArrayBuf(i32)
// with the `Option(T)`-returning accessors (RUE-313). The buffer is freed
// automatically when `v` goes out of scope (ArrayBuf's `drop fn`, RUE-312) — no
// explicit `free()`.

const std = @import("std");

fn main() -> i32 {
    let V = std.arraybuf.ArrayBuf(i32);
    let O = std.option.Option(i32);

    let mut v = V.new();
    v.push(10);
    v.push(20);
    v.push(30);
    @dbg(v.len());          // 3

    // `get` returns Option(i32): Some in bounds, None otherwise.
    @dbg(match v.get(1) { O.Some(x) => x, O.None => -1 });   // 20
    v.set(0, 99);
    @dbg(match v.get(0) { O.Some(x) => x, O.None => -1 });   // 99

    // `pop` returns Option(i32): Some(last) or None when empty.
    @dbg(match v.pop() { O.Some(x) => x, O.None => -1 });    // 30 (removed)
    @dbg(v.len());          // 2

    @dbg(match v.get(99) { O.Some(x) => x, O.None => -1 });  // -1 (out of bounds)

    // Sum the remaining elements with a manual while loop (no for/index sugar).
    // `get_or` is the ergonomic default-based read used inside the loop.
    let mut i: u64 = 0;
    let mut sum: i32 = 0;
    while i < v.len() {
        sum += v.get_or(i, 0);
        i += 1;
    }
    @dbg(sum);              // 99 + 20 = 119

    sum
    // `v` is dropped here: its `drop fn` frees the heap buffer automatically.
}
