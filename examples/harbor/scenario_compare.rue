// Temporal scenario comparison. Each disruption is treated as a named variant
// and compared with the immediately preceding network state across three route
// objectives, producing stable deltas suitable for reports and regression tests.
const std = @import("std");
const model = @import("model.rue");
const route_matrix = @import("route_matrix.rue");
const routing = @import("routing.rue");
const text = @import("text.rue");
const StrBuf = std.strbuf.StrBuf;

pub struct Delta {
    disruption: u64,
    mode: u64,
    before_at: u64,
    during_at: u64,
    before_reachable: u64,
    during_reachable: u64,
    newly_unreachable: u64,
    newly_reachable: u64,
    increased: u64,
    decreased: u64,
    unchanged: u64,
    before_total: u64,
    during_total: u64,
    added_weight: u64,
    largest_increase: u64,
    largest_from: u64,
    largest_to: u64,
}

pub const Deltas = std.arraybuf.ArrayBuf(Delta);

pub struct Comparison {
    deltas: Deltas,
    variants: u64,
    pair_comparisons: u64,
    newly_unreachable: u64,
    increased: u64,
    total_added_weight: u64,
    worst_variant: u64,
    worst_mode: u64,
    worst_added_weight: u64,
    digest: u64,
}

fn add(a: u64, b: u64) -> u64 {
    if b > 18446744073709551615 - a { 18446744073709551615 } else { a + b }
}

fn mix(value: u64, next: u64) -> u64 { @wrapping_mul(value ^ next, 1099511628211) }

fn mode(index: u64) -> u64 {
    if index == 0 { routing.MODE_COST() }
    else if index == 1 { routing.MODE_TIME() }
    else { routing.MODE_DISTANCE() }
}

fn empty_delta() -> Delta {
    Delta {
        disruption: model.NONE(), mode: 0, before_at: 0, during_at: 0,
        before_reachable: 0, during_reachable: 0, newly_unreachable: 0,
        newly_reachable: 0, increased: 0, decreased: 0, unchanged: 0,
        before_total: 0, during_total: 0, added_weight: 0,
        largest_increase: 0, largest_from: model.NONE(), largest_to: model.NONE(),
    }
}

fn compare_matrices(
    disruption: u64,
    mode_value: u64,
    before_at: u64,
    during_at: u64,
    borrow before: route_matrix.Matrix,
    borrow during: route_matrix.Matrix,
) -> Delta {
    let mut result = empty_delta();
    result.disruption = disruption;
    result.mode = mode_value;
    result.before_at = before_at;
    result.during_at = during_at;
    result.before_reachable = before.reachable_pairs;
    result.during_reachable = during.reachable_pairs;
    let mut from: u64 = 0;
    while from < before.size {
        let mut to: u64 = 0;
        while to < before.size {
            if from != to {
                let a = route_matrix.weight(borrow before, from, to);
                let b = route_matrix.weight(borrow during, from, to);
                if a == routing.INF() && b != routing.INF() {
                    result.newly_reachable += 1;
                    result.during_total = add(result.during_total, b);
                } else if a != routing.INF() && b == routing.INF() {
                    result.newly_unreachable += 1;
                    result.before_total = add(result.before_total, a);
                } else if a != routing.INF() && b != routing.INF() {
                    result.before_total = add(result.before_total, a);
                    result.during_total = add(result.during_total, b);
                    if b > a {
                        result.increased += 1;
                        let increase = b - a;
                        if increase > result.largest_increase {
                            result.largest_increase = increase;
                            result.largest_from = from;
                            result.largest_to = to;
                        }
                    } else if b < a {
                        result.decreased += 1;
                    } else {
                        result.unchanged += 1;
                    }
                } else {
                    result.unchanged += 1;
                }
            }
            to += 1;
        }
        from += 1;
    }
    if result.during_total > result.before_total {
        result.added_weight = result.during_total - result.before_total;
    }
    result
}

pub fn compare(borrow scenario: model.Scenario) -> Comparison {
    let mut deltas = Deltas.new();
    let mut pair_comparisons: u64 = 0;
    let mut newly_unreachable: u64 = 0;
    let mut increased: u64 = 0;
    let mut total_added_weight: u64 = 0;
    let mut worst_variant = model.NONE();
    let mut worst_mode: u64 = 0;
    let mut worst_added_weight: u64 = 0;
    let mut digest: u64 = 14695981039346656037;
    let mut disruption_index: u64 = 0;
    while disruption_index < scenario.disruptions.len() {
        let item = scenario.disruptions.get_or(disruption_index, model.empty_disruption());
        let before_at = if item.start > 0 { item.start - 1 } else { item.end };
        let during_at = item.start;
        let mut mode_index: u64 = 0;
        while mode_index < 3 {
            let mode_value = mode(mode_index);
            let before = route_matrix.compute(borrow scenario, before_at, 1, mode_value);
            let during = route_matrix.compute(borrow scenario, during_at, 1, mode_value);
            let delta = compare_matrices(
                disruption_index, mode_value, before_at, during_at,
                borrow before, borrow during,
            );
            pair_comparisons = add(pair_comparisons, scenario.locations.len() * (scenario.locations.len() - 1));
            newly_unreachable = add(newly_unreachable, delta.newly_unreachable);
            increased = add(increased, delta.increased);
            total_added_weight = add(total_added_weight, delta.added_weight);
            digest = mix(digest, delta.added_weight);
            digest = mix(digest, delta.newly_unreachable);
            if worst_variant == model.NONE() || delta.added_weight > worst_added_weight {
                worst_variant = disruption_index;
                worst_mode = mode_value;
                worst_added_weight = delta.added_weight;
            }
            deltas.push(delta);
            mode_index += 1;
        }
        disruption_index += 1;
    }
    Comparison {
        deltas: deltas, variants: scenario.disruptions.len(),
        pair_comparisons: pair_comparisons, newly_unreachable: newly_unreachable,
        increased: increased, total_added_weight: total_added_weight,
        worst_variant: worst_variant, worst_mode: worst_mode,
        worst_added_weight: worst_added_weight, digest: digest,
    }
}

fn append_mode(inout out: StrBuf, value: u64) {
    if value == routing.MODE_COST() { text.append_literal(inout out, "cost"); }
    else if value == routing.MODE_TIME() { text.append_literal(inout out, "time"); }
    else { text.append_literal(inout out, "distance"); }
}

pub fn render(borrow scenario: model.Scenario, borrow value: Comparison) -> StrBuf {
    let mut out = StrBuf.new();
    text.append_literal(inout out, "Scenario variant comparison\n");
    text.append_literal(inout out, "variants="); text.append_u64(inout out, value.variants);
    text.append_literal(inout out, " pair_comparisons="); text.append_u64(inout out, value.pair_comparisons);
    text.append_literal(inout out, " increased="); text.append_u64(inout out, value.increased);
    text.append_literal(inout out, " disconnected="); text.append_u64(inout out, value.newly_unreachable); out.push(10);
    let mut i: u64 = 0;
    while i < value.deltas.len() {
        let item = value.deltas.get_or(i, empty_delta());
        text.append_literal(inout out, "variant="); text.append_u64(inout out, item.disruption);
        text.append_literal(inout out, " mode="); append_mode(inout out, item.mode);
        text.append_literal(inout out, " before="); text.append_u64(inout out, item.before_at);
        text.append_literal(inout out, " during="); text.append_u64(inout out, item.during_at);
        text.append_literal(inout out, " increased="); text.append_u64(inout out, item.increased);
        text.append_literal(inout out, " disconnected="); text.append_u64(inout out, item.newly_unreachable);
        text.append_literal(inout out, " added_weight="); text.append_u64(inout out, item.added_weight);
        if item.largest_from != model.NONE() {
            let from = scenario.locations.get_or(item.largest_from, model.empty_location());
            let to = scenario.locations.get_or(item.largest_to, model.empty_location());
            text.append_literal(inout out, " worst_pair="); text.append_id(inout out, borrow scenario, from.id);
            text.append_literal(inout out, "->"); text.append_id(inout out, borrow scenario, to.id);
            text.append_literal(inout out, " (+"); text.append_u64(inout out, item.largest_increase);
            text.append_literal(inout out, ")");
        }
        out.push(10);
        i += 1;
    }
    text.append_literal(inout out, "total_added_weight="); text.append_u64(inout out, value.total_added_weight);
    text.append_literal(inout out, " digest="); text.append_u64(inout out, value.digest); out.push(10);
    out
}
