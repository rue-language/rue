fn parse_production(value: Json, inout scenario: model.Scenario) {
    let mut location_id = model.NONE();
    let mut cargo_id = model.NONE();
    let mut quantity: u64 = 0;
    let mut every: u64 = 0;
    let mut start: u64 = 0;
    let mut end: u64 = 0;
    match value {
        Json.Object(value_object) => {
            let mut object = value_object;
            while object.keys.len() > 0 && object.values.len() > 0 {
                let key = object.keys.pop_or("");
                let item = object.values.pop_or(Json.Null);
                if same(borrow key, "at") {
                    location_id = string_id(item, inout scenario);
                    if location_id == model.NONE() { field_error(inout scenario, "production", "at"); }
                } else if same(borrow key, "cargo") {
                    cargo_id = string_id(item, inout scenario);
                    if cargo_id == model.NONE() { field_error(inout scenario, "production", "cargo"); }
                } else if same(borrow key, "quantity") {
                    quantity = match number(item) { OptU64.Some(n) => n, OptU64.None => { field_error(inout scenario, "production", "quantity"); 0 } };
                } else if same(borrow key, "every") {
                    every = match number(item) { OptU64.Some(n) => n, OptU64.None => { field_error(inout scenario, "production", "every"); 0 } };
                } else if same(borrow key, "start") {
                    start = match number(item) { OptU64.Some(n) => n, OptU64.None => { field_error(inout scenario, "production", "start"); 0 } };
                } else if same(borrow key, "end") {
                    end = match number(item) { OptU64.Some(n) => n, OptU64.None => { field_error(inout scenario, "production", "end"); 0 } };
                } else {
                    unknown_field(inout scenario, "production", borrow key);
                }
            }
        },
        _ => { model.add_error(inout scenario, 101, "production", "array element must be an object"); },
    }
    scenario.productions.push(model.Production {
        location_id: location_id, cargo_id: cargo_id, location: model.NONE(), cargo: model.NONE(),
        quantity: quantity, every: every, start: start, end: end,
    });
}

fn parse_disruption(value: Json, inout scenario: model.Scenario) {
    let mut route = model.NONE();
    let mut start: u64 = 0;
    let mut end: u64 = 0;
    let mut capacity_percent: u64 = 100;
    let mut cost_percent: u64 = 100;
    match value {
        Json.Object(value_object) => {
            let mut object = value_object;
            while object.keys.len() > 0 && object.values.len() > 0 {
                let key = object.keys.pop_or("");
                let item = object.values.pop_or(Json.Null);
                if same(borrow key, "route") {
                    route = match number(item) { OptU64.Some(n) => n, OptU64.None => { field_error(inout scenario, "disruption", "route"); model.NONE() } };
                } else if same(borrow key, "start") {
                    start = match number(item) { OptU64.Some(n) => n, OptU64.None => { field_error(inout scenario, "disruption", "start"); 0 } };
                } else if same(borrow key, "end") {
                    end = match number(item) { OptU64.Some(n) => n, OptU64.None => { field_error(inout scenario, "disruption", "end"); 0 } };
                } else if same(borrow key, "capacity_percent") {
                    capacity_percent = match number(item) { OptU64.Some(n) => n, OptU64.None => { field_error(inout scenario, "disruption", "capacity_percent"); 0 } };
                } else if same(borrow key, "cost_percent") {
                    cost_percent = match number(item) { OptU64.Some(n) => n, OptU64.None => { field_error(inout scenario, "disruption", "cost_percent"); 0 } };
                } else {
                    unknown_field(inout scenario, "disruption", borrow key);
                }
            }
        },
        _ => { model.add_error(inout scenario, 101, "disruptions", "array element must be an object"); },
    }
    scenario.disruptions.push(model.Disruption {
        route: route, start: start, end: end,
        capacity_percent: capacity_percent, cost_percent: cost_percent,
    });
}

fn parse_locations(value: Json, inout scenario: model.Scenario) {
    match value {
        Json.Array(value_array) => {
            let mut values = value_array;
            while values.len() > 0 { parse_location(values.pop_or(Json.Null), inout scenario); }
            scenario.locations.reverse();
        },
        _ => field_error(inout scenario, "scenario", "locations"),
    }
}

fn parse_routes(value: Json, inout scenario: model.Scenario) {
    match value {
        Json.Array(value_array) => {
            let mut values = value_array;
            while values.len() > 0 { parse_route(values.pop_or(Json.Null), inout scenario); }
            scenario.routes.reverse();
        },
        _ => field_error(inout scenario, "scenario", "routes"),
    }
}

