fn parse_disruptions(value: Json, inout scenario: model.Scenario) {
    match value {
        Json.Array(value_array) => {
            let mut values = value_array;
            while values.len() > 0 { parse_disruption(values.pop_or(Json.Null), inout scenario); }
            scenario.disruptions.reverse();
        },
        _ => field_error(inout scenario, "scenario", "disruptions"),
    }
}

fn parse_root(value: Json, inout scenario: model.Scenario) {
    match value {
        Json.Object(value_object) => {
            let mut object = value_object;
            while object.keys.len() > 0 && object.values.len() > 0 {
                let key = object.keys.pop_or("");
                let item = object.values.pop_or(Json.Null);
                if same(borrow key, "name") {
                    scenario.name = string_id(item, inout scenario);
                    if scenario.name == model.NONE() { field_error(inout scenario, "scenario", "name"); }
                } else if same(borrow key, "duration") {
                    scenario.duration = match number(item) { OptU64.Some(n) => n, OptU64.None => { field_error(inout scenario, "scenario", "duration"); 0 } };
                } else if same(borrow key, "seed") {
                    scenario.seed = match number(item) { OptU64.Some(n) => n, OptU64.None => { field_error(inout scenario, "scenario", "seed"); 1 } };
                } else if same(borrow key, "locations") {
                    parse_locations(item, inout scenario);
                } else if same(borrow key, "routes") {
                    parse_routes(item, inout scenario);
                } else if same(borrow key, "cargo") {
                    parse_cargoes(item, inout scenario);
                } else if same(borrow key, "vehicles") {
                    parse_vehicles(item, inout scenario);
                } else if same(borrow key, "supplies") {
                    parse_supplies(item, inout scenario);
                } else if same(borrow key, "demands") {
                    parse_demands(item, inout scenario);
                } else if same(borrow key, "production") {
                    parse_productions(item, inout scenario);
                } else if same(borrow key, "disruptions") {
                    parse_disruptions(item, inout scenario);
                } else {
                    unknown_field(inout scenario, "scenario", borrow key);
                }
            }
        },
        _ => model.add_error(inout scenario, 101, "scenario", "root JSON value must be an object"),
    }
}

fn parse_error_position(error: ParseError) -> u64 {
    match error {
        std.json.ParseError.UnexpectedEnd(at) => at,
        std.json.ParseError.UnexpectedByte(at) => at,
        std.json.ParseError.InvalidNumber(at) => at,
        std.json.ParseError.InvalidEscape(at) => at,
        std.json.ParseError.InvalidUnicode(at) => at,
        std.json.ParseError.TrailingCharacters(at) => at,
        std.json.ParseError.NestingTooDeep(at) => at,
    }
}

pub fn source(text: StrBuf) -> model.Scenario {
    let mut scenario = model.new_scenario();
    match std.json.parse(text) {
        std.result.Result(std.json.Json, std.json.ParseError).Ok(value) => {
            parse_root(value, inout scenario)
        },
        std.result.Result(std.json.Json, std.json.ParseError).Err(error) => {
            let at = parse_error_position(error);
            model.add_error(inout scenario, 100, "scenario", "invalid JSON at byte " + @to_string(at));
        },
    }
    scenario
}
