// Consuming JSON decoder for Harbor's domain schema. std.json owns strings and
// nested arrays, so this module deliberately pops values out exactly once and
// converts them into the canonical pooled POD model.
const std = @import("std");
const model = @import("model.rue");
const StrBuf = std.strbuf.StrBuf;
const Json = std.json.Json;
const Object = std.json.Object;
const ParseError = std.json.ParseError;
const OptU64 = std.option.Option(u64);
const OptI64 = std.option.Option(i64);
const OptBool = std.option.Option(bool);

fn same(borrow key: StrBuf, expected: StrBuf) -> bool {
    StrBuf.equals_borrowed(borrow key, borrow expected)
}

fn number(value: Json) -> OptU64 {
    let O = OptU64;
    match value {
        Json.Number(text) => {
            match std.strings.parse_int(text) {
                std.option.Option(i64).Some(n) => {
                    if n >= 0 {
                        let converted: u64 = @intCast(n);
                        O.Some(converted)
                    } else { O.None }
                },
                std.option.Option(i64).None => O.None,
            }
        },
        _ => O.None,
    }
}

fn signed_number(value: Json) -> OptI64 {
    let O = OptI64;
    match value {
        Json.Number(text) => std.strings.parse_int(text),
        _ => O.None,
    }
}

fn boolean(value: Json) -> OptBool {
    let O = OptBool;
    match value {
        Json.Bool(v) => O.Some(v),
        _ => O.None,
    }
}

fn string_id(value: Json, inout scenario: model.Scenario) -> u64 {
    match value {
        Json.String(text) => scenario.strings.intern(borrow text),
        _ => model.NONE(),
    }
}

fn field_error(inout scenario: model.Scenario, subject: StrBuf, field: StrBuf) {
    model.add_error(inout scenario, 102, subject, "field has the wrong JSON type: " + field);
}

fn unknown_field(inout scenario: model.Scenario, subject: StrBuf, borrow field: StrBuf) {
    model.add_error(inout scenario, 101, subject, "unknown field: " + field);
}

fn parse_location(value: Json, inout scenario: model.Scenario) {
    let mut id = model.NONE();
    let mut kind_id = model.NONE();
    let mut capacity: u64 = 0;
    let mut handling: u64 = 0;
    let mut x: i64 = 0;
    let mut y: i64 = 0;
    match value {
        Json.Object(value_object) => {
            let mut object = value_object;
            while object.keys.len() > 0 && object.values.len() > 0 {
                let key = object.keys.pop_or("");
                let item = object.values.pop_or(Json.Null);
                if same(borrow key, "id") {
                    id = string_id(item, inout scenario);
                    if id == model.NONE() { field_error(inout scenario, "location", "id"); }
                } else if same(borrow key, "kind") {
                    kind_id = string_id(item, inout scenario);
                    if kind_id == model.NONE() { field_error(inout scenario, "location", "kind"); }
                } else if same(borrow key, "capacity") {
                    capacity = match number(item) {
                        OptU64.Some(n) => n,
                        OptU64.None => { field_error(inout scenario, "location", "capacity"); 0 },
                    };
                } else if same(borrow key, "handling") {
                    handling = match number(item) {
                        OptU64.Some(n) => n,
                        OptU64.None => { field_error(inout scenario, "location", "handling"); 0 },
                    };
                } else if same(borrow key, "x") {
                    x = match signed_number(item) {
                        OptI64.Some(n) => n,
                        OptI64.None => { field_error(inout scenario, "location", "x"); 0 },
                    };
                } else if same(borrow key, "y") {
                    y = match signed_number(item) {
                        OptI64.Some(n) => n,
                        OptI64.None => { field_error(inout scenario, "location", "y"); 0 },
                    };
                } else {
                    unknown_field(inout scenario, "location", borrow key);
                }
            }
        },
        _ => { model.add_error(inout scenario, 101, "locations", "array element must be an object"); },
    }
    scenario.locations.push(model.Location {
        id: id, kind: kind_id, capacity: capacity, handling: handling, x: x, y: y,
    });
}

fn parse_route(value: Json, inout scenario: model.Scenario) {
    let mut from_id = model.NONE();
    let mut to_id = model.NONE();
    let mut distance: u64 = 0;
    let mut capacity: u64 = 0;
    let mut cost: u64 = 0;
    let mut travel: u64 = 0;
    let mut bidirectional = false;
    match value {
        Json.Object(value_object) => {
            let mut object = value_object;
            while object.keys.len() > 0 && object.values.len() > 0 {
                let key = object.keys.pop_or("");
                let item = object.values.pop_or(Json.Null);
                if same(borrow key, "from") {
                    from_id = string_id(item, inout scenario);
                    if from_id == model.NONE() { field_error(inout scenario, "route", "from"); }
                } else if same(borrow key, "to") {
                    to_id = string_id(item, inout scenario);
                    if to_id == model.NONE() { field_error(inout scenario, "route", "to"); }
                } else if same(borrow key, "distance") {
                    distance = match number(item) { OptU64.Some(n) => n, OptU64.None => { field_error(inout scenario, "route", "distance"); 0 } };
                } else if same(borrow key, "capacity") {
                    capacity = match number(item) { OptU64.Some(n) => n, OptU64.None => { field_error(inout scenario, "route", "capacity"); 0 } };
                } else if same(borrow key, "cost") {
                    cost = match number(item) { OptU64.Some(n) => n, OptU64.None => { field_error(inout scenario, "route", "cost"); 0 } };
                } else if same(borrow key, "travel") {
                    travel = match number(item) { OptU64.Some(n) => n, OptU64.None => { field_error(inout scenario, "route", "travel"); 0 } };
                } else if same(borrow key, "bidirectional") {
                    bidirectional = match boolean(item) { OptBool.Some(v) => v, OptBool.None => { field_error(inout scenario, "route", "bidirectional"); false } };
                } else {
                    unknown_field(inout scenario, "route", borrow key);
                }
            }
        },
        _ => { model.add_error(inout scenario, 101, "routes", "array element must be an object"); },
    }
    scenario.routes.push(model.Route {
        from_id: from_id, to_id: to_id, from: model.NONE(), to: model.NONE(),
        distance: distance, capacity: capacity, cost: cost, travel: travel,
        bidirectional: bidirectional,
    });
}

fn parse_cargo(value: Json, inout scenario: model.Scenario) {
    let mut id = model.NONE();
    let mut unit_value: u64 = 0;
    let mut shelf_life: u64 = 0;
    let mut weight: u64 = 1;
    match value {
        Json.Object(value_object) => {
            let mut object = value_object;
            while object.keys.len() > 0 && object.values.len() > 0 {
                let key = object.keys.pop_or("");
                let item = object.values.pop_or(Json.Null);
                if same(borrow key, "id") {
                    id = string_id(item, inout scenario);
                    if id == model.NONE() { field_error(inout scenario, "cargo", "id"); }
                } else if same(borrow key, "unit_value") {
                    unit_value = match number(item) { OptU64.Some(n) => n, OptU64.None => { field_error(inout scenario, "cargo", "unit_value"); 0 } };
                } else if same(borrow key, "shelf_life") {
                    shelf_life = match number(item) { OptU64.Some(n) => n, OptU64.None => { field_error(inout scenario, "cargo", "shelf_life"); 0 } };
                } else if same(borrow key, "weight") {
                    weight = match number(item) { OptU64.Some(n) => n, OptU64.None => { field_error(inout scenario, "cargo", "weight"); 0 } };
                } else {
                    unknown_field(inout scenario, "cargo", borrow key);
                }
            }
        },
        _ => { model.add_error(inout scenario, 101, "cargo", "array element must be an object"); },
    }
    scenario.cargoes.push(model.Cargo { id: id, unit_value: unit_value, shelf_life: shelf_life, weight: weight });
}

