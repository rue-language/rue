    match value {
        Json.Array(value_array) => {
            let mut values = value_array;
            while values.len() > 0 { parse_demand(values.pop_or(Json.Null), inout scenario); }
            scenario.demands.reverse();
        },
        _ => field_error(inout scenario, "scenario", "demands"),
    }
}

