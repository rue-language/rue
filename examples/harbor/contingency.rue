// Contingency planner: samples each disruption window and capacity threshold,
// identifies isolated origin/destination pairs, and recommends the least-cost
// surviving path for operational review.
const std = @import("std");
const model = @import("model.rue");
const routing = @import("routing.rue");
const text = @import("text.rue");
const StrBuf = std.strbuf.StrBuf;

pub struct Option {
    disruption: u64,
    at: u64,
    from: u64,
    to: u64,
    minimum_capacity: u64,
    reachable: bool,
    cost: u64,
    travel: u64,
    distance: u64,
    hops: u64,
    bottleneck: u64,
}

pub const Options = std.arraybuf.ArrayBuf(Option);

pub struct Plan {
    options: Options,
    windows: u64,
    samples: u64,
    reachable: u64,
    isolated: u64,
    degraded: u64,
    total_cost: u64,
    worst_disruption: u64,
    worst_isolated: u64,
    digest: u64,
}

fn add(a: u64, b: u64) -> u64 {
    if b > 18446744073709551615 - a { 18446744073709551615 } else { a + b }
}

fn mix(value: u64, next: u64) -> u64 { @wrapping_mul(value ^ next, 1099511628211) }

fn empty_option() -> Option {
    Option {
        disruption: model.NONE(), at: 0, from: model.NONE(), to: model.NONE(),
        minimum_capacity: 0, reachable: false, cost: routing.INF(), travel: 0,
        distance: 0, hops: 0, bottleneck: 0,
    }
}

fn midpoint(start: u64, end: u64) -> u64 {
    if end <= start { start } else { start + (end - start) / 2 }
}

fn option_for(
    borrow scenario: model.Scenario,
    disruption: u64,
    at: u64,
    from: u64,
    to: u64,
    minimum_capacity: u64,
) -> Option {
    let path = routing.shortest(
        borrow scenario, from, to, at, minimum_capacity, routing.MODE_COST(),
    );
    Option {
        disruption: disruption, at: at, from: from, to: to,
        minimum_capacity: minimum_capacity, reachable: path.reachable,
        cost: routing.path_weight(borrow scenario, borrow path, at, routing.MODE_COST()),
        travel: path.travel, distance: path.distance, hops: path.routes.len(),
        bottleneck: path.bottleneck,
    }
}

fn threshold(index: u64) -> u64 {
    if index == 0 { 1 }
    else if index == 1 { 10 }
    else if index == 2 { 25 }
    else { 50 }
}

fn sample_time(borrow item: model.Disruption, index: u64) -> u64 {
    if index == 0 { item.start }
    else if index == 1 { midpoint(item.start, item.end) }
    else if item.end > item.start { item.end - 1 }
    else { item.start }
}

fn baseline_cost(borrow scenario: model.Scenario, from: u64, to: u64, at: u64, capacity: u64) -> u64 {
    let path = routing.shortest(borrow scenario, from, to, at, capacity, routing.MODE_COST());
    routing.path_weight(borrow scenario, borrow path, at, routing.MODE_COST())
}

pub fn build(borrow scenario: model.Scenario) -> Plan {
    let mut options = Options.new();
    let mut reachable: u64 = 0;
    let mut isolated: u64 = 0;
    let mut degraded: u64 = 0;
    let mut total_cost: u64 = 0;
    let mut worst_disruption = model.NONE();
    let mut worst_isolated: u64 = 0;
    let mut digest: u64 = 14695981039346656037;
    let mut disruption_index: u64 = 0;
    while disruption_index < scenario.disruptions.len() {
        let disruption = scenario.disruptions.get_or(disruption_index, model.empty_disruption());
        let before = if disruption.start > 0 { disruption.start - 1 } else { disruption.end };
        let mut local_isolated: u64 = 0;
        let mut time_index: u64 = 0;
        while time_index < 3 {
            let at = sample_time(borrow disruption, time_index);
            let mut capacity_index: u64 = 0;
            while capacity_index < 4 {
                let capacity = threshold(capacity_index);
                let mut from: u64 = 0;
                while from < scenario.locations.len() {
                    let mut to: u64 = 0;
                    while to < scenario.locations.len() {
                        if from != to {
                            let item = option_for(
                                borrow scenario, disruption_index, at, from, to, capacity,
                            );
                            let base = baseline_cost(borrow scenario, from, to, before, capacity);
                            if item.reachable {
                                reachable += 1;
                                total_cost = add(total_cost, item.cost);
                                if base != routing.INF() && item.cost > base { degraded = degraded + 1; }
                            } else {
                                isolated += 1;
                                local_isolated += 1;
                            }
                            digest = mix(digest, item.cost);
                            digest = mix(digest, item.bottleneck);
                            options.push(item);
                        }
                        to += 1;
                    }
                    from += 1;
                }
                capacity_index += 1;
            }
            time_index += 1;
        }
        if worst_disruption == model.NONE() || local_isolated > worst_isolated {
            worst_disruption = disruption_index;
            worst_isolated = local_isolated;
        }
        disruption_index += 1;
    }
    Plan {
        options: options, windows: scenario.disruptions.len(),
        samples: reachable + isolated, reachable: reachable, isolated: isolated,
        degraded: degraded, total_cost: total_cost,
        worst_disruption: worst_disruption, worst_isolated: worst_isolated,
        digest: digest,
    }
}

fn append_location(inout out: StrBuf, borrow scenario: model.Scenario, index: u64) {
    if index >= scenario.locations.len() { text.append_literal(inout out, "-"); return; }
    let location = scenario.locations.get_or(index, model.empty_location());
    text.append_id(inout out, borrow scenario, location.id);
}

pub fn render(borrow scenario: model.Scenario, borrow plan: Plan) -> StrBuf {
    let mut out = StrBuf.new();
    text.append_literal(inout out, "Contingency plan\n");
    text.append_literal(inout out, "windows="); text.append_u64(inout out, plan.windows);
    text.append_literal(inout out, " samples="); text.append_u64(inout out, plan.samples);
    text.append_literal(inout out, " reachable="); text.append_u64(inout out, plan.reachable);
    text.append_literal(inout out, " isolated="); text.append_u64(inout out, plan.isolated);
    text.append_literal(inout out, " degraded="); text.append_u64(inout out, plan.degraded); out.push(10);
    text.append_literal(inout out, "worst_disruption=");
    if plan.worst_disruption == model.NONE() { text.append_literal(inout out, "-"); }
    else { text.append_u64(inout out, plan.worst_disruption); }
    text.append_literal(inout out, " isolated_samples="); text.append_u64(inout out, plan.worst_isolated);
    text.append_literal(inout out, " digest="); text.append_u64(inout out, plan.digest); out.push(10);
    text.append_literal(inout out, "isolated options (first 24):\n");
    let mut shown: u64 = 0;
    let mut i: u64 = 0;
    while i < plan.options.len() && shown < 24 {
        let item = plan.options.get_or(i, empty_option());
        if !item.reachable {
            text.append_literal(inout out, "  disruption="); text.append_u64(inout out, item.disruption);
            text.append_literal(inout out, " hour="); text.append_u64(inout out, item.at);
            text.append_literal(inout out, " capacity="); text.append_u64(inout out, item.minimum_capacity);
            text.append_literal(inout out, " from="); append_location(inout out, borrow scenario, item.from);
            text.append_literal(inout out, " to="); append_location(inout out, borrow scenario, item.to); out.push(10);
            shown += 1;
        }
        i += 1;
    }
    if shown == 0 { text.append_literal(inout out, "  none\n"); }
    out
}
