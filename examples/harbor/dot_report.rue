// Graphviz DOT network export with disruption and direction annotations.
const std = @import("std");
const model = @import("model.rue");
const network = @import("network.rue");
const text = @import("text.rue");
const StrBuf = std.strbuf.StrBuf;

fn quoted_id(inout out: StrBuf, borrow scenario: model.Scenario, id: u64) {
    let value = scenario.strings.copy(id);
    text.append_json_string(inout out, borrow value);
}

fn kind_shape(borrow scenario: model.Scenario, kind: u64) -> str {
    let port: StrBuf = "port";
    let hub: StrBuf = "hub";
    let factory: StrBuf = "factory";
    if scenario.strings.equals(kind, borrow port) { "box" }
    else if scenario.strings.equals(kind, borrow hub) { "diamond" }
    else if scenario.strings.equals(kind, borrow factory) { "component" }
    else { "ellipse" }
}

fn disrupted(borrow scenario: model.Scenario, route: u64) -> bool {
    let mut i: u64 = 0;
    while i < scenario.disruptions.len() {
        if scenario.disruptions.get_or(i, model.empty_disruption()).route == route { return true; }
        i += 1;
    }
    false
}

pub fn render(borrow scenario: model.Scenario) -> StrBuf {
    let stats = network.summarize(borrow scenario);
    let mut out = StrBuf.new();
    text.append_literal(inout out, "digraph harbor {\n  rankdir=LR;\n  graph [label=");
    quoted_id(inout out, borrow scenario, scenario.name);
    text.append_literal(inout out, ", labelloc=t];\n  node [fontname=\"sans-serif\"];\n");
    let mut i: u64 = 0;
    while i < scenario.locations.len() {
        let item = scenario.locations.get_or(i, model.empty_location());
        let location_stats = stats.locations.get_or(i, network.LocationStats {
            location: i, outgoing: 0, incoming: 0, neighbors: 0,
            outbound_capacity: 0, inbound_capacity: 0, distance_sum: 0,
            critical: false,
        });
        text.append_literal(inout out, "  "); quoted_id(inout out, borrow scenario, item.id);
        text.append_literal(inout out, " [shape="); text.append_literal(inout out, kind_shape(borrow scenario, item.kind));
        text.append_literal(inout out, ", label=");
        let mut label = scenario.strings.copy(item.id);
        label.push_str("\\ncapacity="); label.push_str(@to_string(item.capacity));
        text.append_json_string(inout out, borrow label);
        if location_stats.critical { text.append_literal(inout out, ", color=red, penwidth=2"); }
        text.append_literal(inout out, "];\n");
        i += 1;
    }
    i = 0;
    while i < scenario.routes.len() {
        let route = scenario.routes.get_or(i, model.empty_route());
        text.append_literal(inout out, "  "); quoted_id(inout out, borrow scenario, route.from_id);
        text.append_literal(inout out, " -> "); quoted_id(inout out, borrow scenario, route.to_id);
        text.append_literal(inout out, " [label=\""); text.append_u64(inout out, route.distance);
        text.append_literal(inout out, "km / "); text.append_u64(inout out, route.capacity);
        text.append_literal(inout out, "u\"");
        if route.bidirectional { text.append_literal(inout out, ", dir=both"); }
        if disrupted(borrow scenario, i) { text.append_literal(inout out, ", color=orange, style=dashed"); }
        text.append_literal(inout out, "];\n");
        i += 1;
    }
    text.append_literal(inout out, "}\n");
    out
}
