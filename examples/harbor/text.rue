// Shared deterministic text helpers for reports, diagnostics, and fingerprints.
const std = @import("std");
const model = @import("model.rue");
const StrBuf = std.strbuf.StrBuf;

pub fn append_literal(inout out: StrBuf, value: str) {
    let mut i: u64 = 0;
    while i < value.len() { out.push(value[i]); i += 1; }
}

pub fn append_string(inout out: StrBuf, borrow value: StrBuf) {
    let mut i: u64 = 0;
    while i < value.len() {
        out.push(StrBuf.byte_at_borrowed(borrow value, i));
        i += 1;
    }
}

pub fn append_id(inout out: StrBuf, borrow scenario: model.Scenario, id: u64) {
    if id < scenario.strings.len() { scenario.strings.append(id, inout out); }
    else { append_literal(inout out, "<none>"); }
}

pub fn append_u64(inout out: StrBuf, value: u64) {
    let formatted = @to_string(value);
    append_string(inout out, borrow formatted);
}

pub fn append_i64(inout out: StrBuf, value: i64) {
    let formatted = @to_string(value);
    append_string(inout out, borrow formatted);
}

pub fn append_bool(inout out: StrBuf, value: bool) {
    if value { append_literal(inout out, "true"); }
    else { append_literal(inout out, "false"); }
}

pub fn append_percent(inout out: StrBuf, numerator: u64, denominator: u64) {
    if denominator == 0 { append_literal(inout out, "0.0%"); return; }
    let whole = (numerator * 100) / denominator;
    let tenth = ((numerator * 1000) / denominator) % 10;
    append_u64(inout out, whole);
    out.push(46);
    append_u64(inout out, tenth);
    out.push(37);
}

pub fn line(inout out: StrBuf, label: str, value: u64) {
    append_literal(inout out, label);
    append_u64(inout out, value);
    out.push(10);
}

pub fn heading(inout out: StrBuf, title: str) {
    append_literal(inout out, title);
    out.push(10);
    let mut i: u64 = 0;
    while i < title.len() { out.push(45); i += 1; }
    out.push(10);
}

pub fn fnv1a(borrow value: StrBuf) -> u64 {
    let mut hash: u64 = 14695981039346656037;
    let mut i: u64 = 0;
    while i < value.len() {
        hash ^= @intCast(StrBuf.byte_at_borrowed(borrow value, i));
        hash = @wrapping_mul(hash, 1099511628211);
        i += 1;
    }
    hash
}

pub fn append_json_string(inout out: StrBuf, borrow value: StrBuf) {
    out.push(34);
    let mut i: u64 = 0;
    while i < value.len() {
        let b = StrBuf.byte_at_borrowed(borrow value, i);
        if b == 34 { append_literal(inout out, "\\\""); }
        else if b == 92 { append_literal(inout out, "\\\\"); }
        else if b == 8 { append_literal(inout out, "\\b"); }
        else if b == 9 { append_literal(inout out, "\\t"); }
        else if b == 10 { append_literal(inout out, "\\n"); }
        else if b == 12 { append_literal(inout out, "\\f"); }
        else if b == 13 { append_literal(inout out, "\\r"); }
        else if b < 32 {
            append_literal(inout out, "\\u00");
            let digits: StrBuf = "0123456789abcdef";
            out.push(StrBuf.byte_at_borrowed(borrow digits, @intCast(b >> 4)));
            out.push(StrBuf.byte_at_borrowed(borrow digits, @intCast(b & 15)));
        } else { out.push(b); }
        i += 1;
    }
    out.push(34);
}

pub fn append_json_id(inout out: StrBuf, borrow scenario: model.Scenario, id: u64) {
    let value = scenario.strings.copy(id);
    append_json_string(inout out, borrow value);
}
