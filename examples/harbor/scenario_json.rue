// Canonical scenario serializer and decode round-trip oracle.
const std = @import("std");
const decode = @import("decode.rue");
const fingerprint = @import("fingerprint.rue");
const model = @import("model.rue");
const text = @import("text.rue");
const validate = @import("validate.rue");
const StrBuf = std.strbuf.StrBuf;

fn key(inout out: StrBuf, name: str) {
    let mut value = StrBuf.new();
    text.append_literal(inout value, name);
    text.append_json_string(inout out, borrow value);
    out.push(58);
}

fn comma(inout out: StrBuf, inout first: bool) {
    if first { first = false; } else { out.push(44); }
}

fn number(inout out: StrBuf, inout first: bool, name: str, value: u64) {
    comma(inout out, inout first); key(inout out, name); text.append_u64(inout out, value);
}

fn signed(inout out: StrBuf, inout first: bool, name: str, value: i64) {
    comma(inout out, inout first); key(inout out, name); text.append_i64(inout out, value);
}

fn boolean(inout out: StrBuf, inout first: bool, name: str, value: bool) {
    comma(inout out, inout first); key(inout out, name); text.append_bool(inout out, value);
}

fn id(inout out: StrBuf, inout first: bool, borrow scenario: model.Scenario, name: str, value: u64) {
    comma(inout out, inout first); key(inout out, name); text.append_json_id(inout out, borrow scenario, value);
}

fn kind_name(borrow scenario: model.Scenario, kind: u64) -> u64 { kind }

fn locations(inout out: StrBuf, borrow scenario: model.Scenario) {
    out.push(91);
    let mut i: u64 = 0;
    while i < scenario.locations.len() {
        if i > 0 { out.push(44); }
        let item = scenario.locations.get_or(i, model.empty_location());
        out.push(123); let mut first = true;
        id(inout out, inout first, borrow scenario, "id", item.id);
        id(inout out, inout first, borrow scenario, "kind", kind_name(borrow scenario, item.kind));
        number(inout out, inout first, "capacity", item.capacity);
        number(inout out, inout first, "handling", item.handling);
        signed(inout out, inout first, "x", item.x);
        signed(inout out, inout first, "y", item.y);
        out.push(125); i += 1;
    }
    out.push(93);
}

fn routes(inout out: StrBuf, borrow scenario: model.Scenario) {
    out.push(91);
    let mut i: u64 = 0;
    while i < scenario.routes.len() {
        if i > 0 { out.push(44); }
        let item = scenario.routes.get_or(i, model.empty_route());
        out.push(123); let mut first = true;
        id(inout out, inout first, borrow scenario, "from", item.from_id);
        id(inout out, inout first, borrow scenario, "to", item.to_id);
        number(inout out, inout first, "distance", item.distance);
        number(inout out, inout first, "capacity", item.capacity);
        number(inout out, inout first, "cost", item.cost);
        number(inout out, inout first, "travel", item.travel);
        boolean(inout out, inout first, "bidirectional", item.bidirectional);
        out.push(125); i += 1;
    }
    out.push(93);
}

