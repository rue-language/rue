        number(inout out, inout first, "start", item.start);
        number(inout out, inout first, "end", item.end);
        number(inout out, inout first, "capacity_percent", item.capacity_percent);
        number(inout out, inout first, "cost_percent", item.cost_percent);
        out.push(125); i += 1;
    }
    out.push(93);
}

pub fn render(borrow scenario: model.Scenario) -> StrBuf {
    let mut out = StrBuf.new();
    out.push(123); let mut first = true;
    id(inout out, inout first, borrow scenario, "name", scenario.name);
    number(inout out, inout first, "duration", scenario.duration);
    number(inout out, inout first, "seed", scenario.seed);
    comma(inout out, inout first); key(inout out, "locations"); locations(inout out, borrow scenario);
    comma(inout out, inout first); key(inout out, "routes"); routes(inout out, borrow scenario);
    comma(inout out, inout first); key(inout out, "cargo"); cargoes(inout out, borrow scenario);
    comma(inout out, inout first); key(inout out, "vehicles"); vehicles(inout out, borrow scenario);
    comma(inout out, inout first); key(inout out, "supplies"); supplies(inout out, borrow scenario);
    comma(inout out, inout first); key(inout out, "demands"); demands(inout out, borrow scenario);
    comma(inout out, inout first); key(inout out, "production"); productions(inout out, borrow scenario);
    comma(inout out, inout first); key(inout out, "disruptions"); disruptions(inout out, borrow scenario);
    out.push(125); out.push(10);
    out
}

pub fn roundtrip_fingerprint(borrow scenario: model.Scenario) -> u64 {
    let encoded = render(borrow scenario);
    let mut decoded = decode.source(encoded);
    validate.scenario(inout decoded);
    if decoded.diagnostics.len() > 0 { 0 } else { fingerprint.scenario(borrow decoded) }
}

pub fn decoded_diagnostics(borrow scenario: model.Scenario) -> u64 {
    let encoded = render(borrow scenario);
    let mut decoded = decode.source(encoded);
    validate.scenario(inout decoded);
    decoded.diagnostics.len()
}

pub fn roundtrips(borrow scenario: model.Scenario) -> bool {
    roundtrip_fingerprint(borrow scenario) == fingerprint.scenario(borrow scenario)
}
