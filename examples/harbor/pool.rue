// Stable pooled strings for Harbor. Domain records carry integer ids so the
// simulation arenas remain Copy and can be read repeatedly across modules.
// Lookup goes through a `std.hashmap.HashMap(StrBuf, u64)` index, the generic
// map keyed by `StrBuf`'s `Hashable + Equatable` conformance (spec 6.7), so
// `intern` and `find` are amortized O(length) rather than a scan of every
// pooled string.
const std = @import("std");
const StrBuf = std.strbuf.StrBuf;
const U64s = std.arraybuf.ArrayBuf(u64);
const Index = std.hashmap.HashMap(StrBuf, u64);
const OptU8 = std.option.Option(u8);
const OptU64 = std.option.Option(u64);

pub struct Pool {
    bytes: StrBuf,
    offsets: U64s,
    lengths: U64s,
    index: Index,

    fn new() -> Self {
        Self { bytes: StrBuf.new(), offsets: U64s.new(), lengths: U64s.new(), index: Index.new() }
    }

    fn len(borrow self) -> u64 { self.offsets.len() }

    fn intern(inout self, borrow value: StrBuf) -> u64 {
        let found = self.find(borrow value);
        if found < self.len() { return found; }
        let id = self.len();
        self.index.insert(value.copy(), id);
        self.offsets.push(self.bytes.len());
        self.lengths.push(value.len());
        let mut i: u64 = 0;
        while i < value.len() {
            let b = match value.byte_at(i) { OptU8.Some(x) => x, OptU8.None => 0 };
            self.bytes.push(b);
            i += 1;
        }
        id
    }

    fn intern_literal(inout self, value: StrBuf) -> u64 { self.intern(borrow value) }

    // The id of `value`, or `len()` when it is not pooled.
    fn find(borrow self, borrow value: StrBuf) -> u64 {
        match self.index.get(borrow value) {
            OptU64.Some(id) => id,
            OptU64.None => self.len(),
        }
    }

    fn string_len(borrow self, id: u64) -> u64 {
        if id < self.len() { self.lengths.get_or(id, 0) } else { 0 }
    }

    fn byte_at(borrow self, id: u64, index: u64) -> u8 {
        if id >= self.len() || index >= self.string_len(id) { return 0; }
        match self.bytes.byte_at(self.offsets.get_or(id, 0) + index) {
            OptU8.Some(b) => b,
            OptU8.None => 0,
        }
    }

    // Whether pooled string `id` has exactly the bytes of `value`, without
    // interning `value`.
    fn equals(borrow self, id: u64, borrow value: StrBuf) -> bool {
        if self.string_len(id) != value.len() { return false; }
        let mut i: u64 = 0;
        while i < value.len() {
            let b = match value.byte_at(i) { OptU8.Some(x) => x, OptU8.None => 0 };
            if self.byte_at(id, i) != b { return false; }
            i += 1;
        }
        true
    }

    fn ids_equal(borrow self, a: u64, b: u64) -> bool {
        if self.string_len(a) != self.string_len(b) { return false; }
        let mut i: u64 = 0;
        while i < self.string_len(a) {
            if self.byte_at(a, i) != self.byte_at(b, i) { return false; }
            i += 1;
        }
        true
    }

    fn append(borrow self, id: u64, inout out: StrBuf) {
        let mut i: u64 = 0;
        while i < self.string_len(id) {
            out.push(self.byte_at(id, i));
            i += 1;
        }
    }

    fn copy(borrow self, id: u64) -> StrBuf {
        let mut out = StrBuf.with_capacity(self.string_len(id));
        self.append(id, inout out);
        out
    }

    fn hash(borrow self, id: u64) -> u64 {
        let mut h: u64 = 14695981039346656037;
        let mut i: u64 = 0;
        while i < self.string_len(id) {
            h ^= @intCast(self.byte_at(id, i));
            h = @wrapping_mul(h, 1099511628211);
            i += 1;
        }
        h
    }
}
