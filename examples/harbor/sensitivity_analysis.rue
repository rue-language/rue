// Parameter sensitivity analysis for network capacity and departure time. This
// evaluates the same origin/destination corpus across a fixed set of capacity
// thresholds and time slices, making nonlinear routing changes visible.
const std = @import("std");
const model = @import("model.rue");
const route_matrix = @import("route_matrix.rue");
const routing = @import("routing.rue");
const text = @import("text.rue");
const StrBuf = std.strbuf.StrBuf;

pub struct Cell {
    hour: u64,
    minimum_capacity: u64,
    reachable: u64,
    unreachable: u64,
    average_cost: u64,
    average_time: u64,
    average_distance: u64,
    diameter: u64,
    changed_from_baseline: u64,
    total_penalty: u64,
}

pub const Cells = std.arraybuf.ArrayBuf(Cell);

pub struct Analysis {
    cells: Cells,
    hours: u64,
    thresholds: u64,
    pair_evaluations: u64,
    unreachable: u64,
    changed: u64,
    total_penalty: u64,
    most_sensitive_hour: u64,
    most_sensitive_capacity: u64,
    most_sensitive_changes: u64,
    digest: u64,
}

fn add(a: u64, b: u64) -> u64 {
    if b > 18446744073709551615 - a { 18446744073709551615 } else { a + b }
}

fn mix(value: u64, next: u64) -> u64 { @wrapping_mul(value ^ next, 1099511628211) }

fn empty_cell() -> Cell {
    Cell {
        hour: 0, minimum_capacity: 0, reachable: 0, unreachable: 0,
        average_cost: 0, average_time: 0, average_distance: 0, diameter: 0,
        changed_from_baseline: 0, total_penalty: 0,
    }
}

fn threshold(index: u64) -> u64 {
    if index == 0 { 1 }
    else if index == 1 { 10 }
    else if index == 2 { 25 }
    else if index == 3 { 50 }
    else { 100 }
}

fn hour(borrow scenario: model.Scenario, index: u64) -> u64 {
    if index == 0 { 0 }
    else if index == 1 { scenario.duration / 4 }
    else if index == 2 { scenario.duration / 2 }
    else if index == 3 { (scenario.duration * 3) / 4 }
    else if scenario.duration > 0 { scenario.duration - 1 }
    else { 0 }
}

fn penalty(baseline: u64, candidate: u64) -> u64 {
    if baseline == routing.INF() || candidate == routing.INF() { 0 }
    else if candidate > baseline { candidate - baseline }
    else { 0 }
}

fn compare_pair(
    borrow baseline: route_matrix.Matrix,
    borrow candidate: route_matrix.Matrix,
    from: u64,
    to: u64,
    inout changed: u64,
    inout total_penalty: u64,
) {
    let before = route_matrix.weight(borrow baseline, from, to);
    let after = route_matrix.weight(borrow candidate, from, to);
    if before != after {
        changed += 1;
        if before != routing.INF() && after == routing.INF() {
            total_penalty = add(total_penalty, baseline.diameter + 1);
        } else {
            total_penalty = add(total_penalty, penalty(before, after));
        }
    }
}

fn make_cell(
    borrow scenario: model.Scenario,
    at: u64,
    capacity: u64,
    borrow baseline: route_matrix.Matrix,
) -> Cell {
    let cost = route_matrix.compute(borrow scenario, at, capacity, routing.MODE_COST());
    let time = route_matrix.compute(borrow scenario, at, capacity, routing.MODE_TIME());
    let distance = route_matrix.compute(borrow scenario, at, capacity, routing.MODE_DISTANCE());
    let mut changed: u64 = 0;
    let mut total_penalty: u64 = 0;
    let mut from: u64 = 0;
    while from < scenario.locations.len() {
        let mut to: u64 = 0;
        while to < scenario.locations.len() {
            if from != to {
                compare_pair(borrow baseline, borrow cost, from, to, inout changed, inout total_penalty);
            }
            to += 1;
        }
        from += 1;
    }
    Cell {
        hour: at, minimum_capacity: capacity,
        reachable: cost.reachable_pairs, unreachable: cost.unreachable_pairs,
        average_cost: route_matrix.average_weight(borrow cost),
        average_time: route_matrix.average_weight(borrow time),
        average_distance: route_matrix.average_weight(borrow distance),
        diameter: cost.diameter, changed_from_baseline: changed,
        total_penalty: total_penalty,
    }
}

pub fn run(borrow scenario: model.Scenario) -> Analysis {
    let baseline = route_matrix.compute(borrow scenario, 0, 1, routing.MODE_COST());
    let mut cells = Cells.new();
    let mut pair_evaluations: u64 = 0;
    let mut unreachable: u64 = 0;
    let mut changed: u64 = 0;
    let mut total_penalty: u64 = 0;
    let mut most_sensitive_hour: u64 = 0;
    let mut most_sensitive_capacity: u64 = 1;
    let mut most_sensitive_changes: u64 = 0;
    let mut digest: u64 = 14695981039346656037;
    let mut hour_index: u64 = 0;
    while hour_index < 5 {
        let at = hour(borrow scenario, hour_index);
        let mut threshold_index: u64 = 0;
        while threshold_index < 5 {
            let capacity = threshold(threshold_index);
            let cell = make_cell(borrow scenario, at, capacity, borrow baseline);
            pair_evaluations = add(pair_evaluations, scenario.locations.len() * (scenario.locations.len() - 1) * 3);
            unreachable = add(unreachable, cell.unreachable);
            changed = add(changed, cell.changed_from_baseline);
            total_penalty = add(total_penalty, cell.total_penalty);
            if cell.changed_from_baseline > most_sensitive_changes {
                most_sensitive_changes = cell.changed_from_baseline;
                most_sensitive_hour = at;
                most_sensitive_capacity = capacity;
            }
            digest = mix(digest, cell.reachable);
            digest = mix(digest, cell.changed_from_baseline);
            digest = mix(digest, cell.total_penalty);
            cells.push(cell);
            threshold_index += 1;
        }
        hour_index += 1;
    }
    Analysis {
        cells: cells, hours: 5, thresholds: 5,
        pair_evaluations: pair_evaluations, unreachable: unreachable,
        changed: changed, total_penalty: total_penalty,
        most_sensitive_hour: most_sensitive_hour,
        most_sensitive_capacity: most_sensitive_capacity,
        most_sensitive_changes: most_sensitive_changes, digest: digest,
    }
}

pub fn stable(borrow scenario: model.Scenario, borrow first: Analysis) -> bool {
    let second = run(borrow scenario);
    first.cells.len() == second.cells.len() &&
    first.pair_evaluations == second.pair_evaluations &&
    first.unreachable == second.unreachable && first.changed == second.changed &&
    first.total_penalty == second.total_penalty && first.digest == second.digest
}

pub fn render(borrow value: Analysis) -> StrBuf {
    let mut out = StrBuf.new();
    text.append_literal(inout out, "Network parameter sensitivity\n");
    text.append_literal(inout out, "hours="); text.append_u64(inout out, value.hours);
    text.append_literal(inout out, " thresholds="); text.append_u64(inout out, value.thresholds);
    text.append_literal(inout out, " pair_evaluations="); text.append_u64(inout out, value.pair_evaluations); out.push(10);
    text.append_literal(inout out, "hour capacity reachable unreachable avg_cost avg_time avg_distance diameter changed penalty\n");
    let mut i: u64 = 0;
    while i < value.cells.len() {
        let cell = value.cells.get_or(i, empty_cell());
        text.append_u64(inout out, cell.hour); out.push(32);
        text.append_u64(inout out, cell.minimum_capacity); out.push(32);
        text.append_u64(inout out, cell.reachable); out.push(32);
        text.append_u64(inout out, cell.unreachable); out.push(32);
        text.append_u64(inout out, cell.average_cost); out.push(32);
        text.append_u64(inout out, cell.average_time); out.push(32);
        text.append_u64(inout out, cell.average_distance); out.push(32);
        text.append_u64(inout out, cell.diameter); out.push(32);
        text.append_u64(inout out, cell.changed_from_baseline); out.push(32);
        text.append_u64(inout out, cell.total_penalty); out.push(10);
        i += 1;
    }
    text.append_literal(inout out, "most_sensitive_hour="); text.append_u64(inout out, value.most_sensitive_hour);
    text.append_literal(inout out, " capacity="); text.append_u64(inout out, value.most_sensitive_capacity);
    text.append_literal(inout out, " changes="); text.append_u64(inout out, value.most_sensitive_changes); out.push(10);
    text.append_literal(inout out, "total_changed="); text.append_u64(inout out, value.changed);
    text.append_literal(inout out, " total_unreachable="); text.append_u64(inout out, value.unreachable);
    text.append_literal(inout out, " total_penalty="); text.append_u64(inout out, value.total_penalty);
    text.append_literal(inout out, " digest="); text.append_u64(inout out, value.digest); out.push(10);
    out
}
