// Vehicle fleet utilization reconstructed from reposition/departure events.
const std = @import("std");
const model = @import("model.rue");
const state = @import("state.rue");

pub struct VehicleUse {
    vehicle: u64,
    dispatches: u64,
    repositions: u64,
    cargo_units: u64,
    loaded_distance: u64,
    empty_distance: u64,
    travel_time: u64,
    busy_until: u64,
    operating_cost: u64,
    capacity_units: u64,
    fill_numerator: u64,
    fill_denominator: u64,
}

pub const VehicleUses = std.arraybuf.ArrayBuf(VehicleUse);

pub struct Summary {
    vehicles: VehicleUses,
    active_vehicles: u64,
    idle_vehicles: u64,
    dispatches: u64,
    cargo_units: u64,
    loaded_distance: u64,
    empty_distance: u64,
    operating_cost: u64,
    fill_numerator: u64,
    fill_denominator: u64,
}

fn add(a: u64, b: u64) -> u64 {
    if b > 18446744073709551615 - a { 18446744073709551615 } else { a + b }
}

fn mul(a: u64, b: u64) -> u64 {
    if a == 0 || b == 0 { 0 }
    else if a > 18446744073709551615 / b { 18446744073709551615 }
    else { a * b }
}

fn one(borrow scenario: model.Scenario, borrow sim: state.State, vehicle_index: u64) -> VehicleUse {
    let vehicle = scenario.vehicles.get_or(vehicle_index, model.empty_vehicle());
    let mut dispatches: u64 = 0;
    let mut repositions: u64 = 0;
    let mut cargo_units: u64 = 0;
    let mut loaded_distance: u64 = 0;
    let mut empty_distance: u64 = 0;
    let mut travel_time: u64 = 0;
    let mut busy_until = vehicle.available;
    let mut operating_cost: u64 = 0;
    let mut fill_numerator: u64 = 0;
    let mut fill_denominator: u64 = 0;
    let mut i: u64 = 0;
    while i < sim.log.len() {
        let event = sim.log.get_or(i, state.empty_event());
        if event.vehicle == vehicle_index {
            if event.tag == state.EVENT_REPOSITION() {
                repositions += 1;
                empty_distance = add(empty_distance, event.distance);
                travel_time = add(travel_time, event.travel);
                operating_cost = add(operating_cost, event.cost);
                busy_until = if add(event.time, event.travel) > busy_until { add(event.time, event.travel) } else { busy_until };
            } else if event.tag == state.EVENT_DEPARTURE() {
                dispatches += 1;
                cargo_units = add(cargo_units, event.quantity);
                loaded_distance = add(loaded_distance, event.distance);
                travel_time = add(travel_time, event.travel);
                operating_cost = add(operating_cost, event.cost);
                fill_numerator = add(fill_numerator, event.quantity);
                fill_denominator = add(fill_denominator, vehicle.capacity);
                busy_until = if add(event.time, event.travel) > busy_until { add(event.time, event.travel) } else { busy_until };
            }
        }
        i += 1;
    }
    VehicleUse {
        vehicle: vehicle_index, dispatches: dispatches, repositions: repositions,
        cargo_units: cargo_units, loaded_distance: loaded_distance,
        empty_distance: empty_distance, travel_time: travel_time,
        busy_until: busy_until, operating_cost: operating_cost,
        capacity_units: mul(dispatches, vehicle.capacity),
        fill_numerator: fill_numerator, fill_denominator: fill_denominator,
    }
}

pub fn summarize(borrow scenario: model.Scenario, borrow sim: state.State) -> Summary {
    let mut vehicles = VehicleUses.new();
    let mut active_vehicles: u64 = 0;
    let mut idle_vehicles: u64 = 0;
    let mut dispatches: u64 = 0;
    let mut cargo_units: u64 = 0;
    let mut loaded_distance: u64 = 0;
    let mut empty_distance: u64 = 0;
    let mut operating_cost: u64 = 0;
    let mut fill_numerator: u64 = 0;
    let mut fill_denominator: u64 = 0;
    let mut i: u64 = 0;
    while i < scenario.vehicles.len() {
        let item = one(borrow scenario, borrow sim, i);
        if item.dispatches > 0 || item.repositions > 0 { active_vehicles = active_vehicles + 1; }
        else { idle_vehicles = idle_vehicles + 1; }
        dispatches = add(dispatches, item.dispatches);
        cargo_units = add(cargo_units, item.cargo_units);
        loaded_distance = add(loaded_distance, item.loaded_distance);
        empty_distance = add(empty_distance, item.empty_distance);
        operating_cost = add(operating_cost, item.operating_cost);
        fill_numerator = add(fill_numerator, item.fill_numerator);
        fill_denominator = add(fill_denominator, item.fill_denominator);
        vehicles.push(item);
        i += 1;
    }
    Summary {
        vehicles: vehicles, active_vehicles: active_vehicles, idle_vehicles: idle_vehicles,
        dispatches: dispatches, cargo_units: cargo_units,
        loaded_distance: loaded_distance, empty_distance: empty_distance,
        operating_cost: operating_cost, fill_numerator: fill_numerator,
        fill_denominator: fill_denominator,
    }
}
