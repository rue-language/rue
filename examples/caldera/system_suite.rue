pub struct Summary { systems: u64, inspected: u64, eligible: u64, commands: u64,
    deterministic_mismatches: u64, digest: u64, valid: bool }
fn include(inout out: Summary, borrow first: result.Result, borrow second: result.Result, verified: bool) {
    out.systems += 1; out.inspected += first.inspected;
    out.eligible += first.eligible; out.commands += first.commands;
    if first.digest != second.digest || first.energy != second.energy || !verified {
        out.deterministic_mismatches += 1;
    }
    out.digest = metric.mix(out.digest, first.digest);
}
pub fn run(borrow world: model.World) -> Summary {
    let mut out = Summary { systems: 0, inspected: 0, eligible: 0, commands: 0,
        deterministic_mismatches: 0, digest: 14695981039346656037, valid: false };
    let system_lifecycle_bootstrap_a = system_lifecycle_bootstrap.evaluate(borrow world);
    let system_lifecycle_bootstrap_b = system_lifecycle_bootstrap.evaluate(borrow world);
    include(inout out, borrow system_lifecycle_bootstrap_a, borrow system_lifecycle_bootstrap_b,
        system_lifecycle_bootstrap.verify(borrow world, borrow system_lifecycle_bootstrap_a));
    let system_lifecycle_discover_a = system_lifecycle_discover.evaluate(borrow world);
    let system_lifecycle_discover_b = system_lifecycle_discover.evaluate(borrow world);
    include(inout out, borrow system_lifecycle_discover_a, borrow system_lifecycle_discover_b,
        system_lifecycle_discover.verify(borrow world, borrow system_lifecycle_discover_a));
    let system_lifecycle_validate_a = system_lifecycle_validate.evaluate(borrow world);
    let system_lifecycle_validate_b = system_lifecycle_validate.evaluate(borrow world);
    include(inout out, borrow system_lifecycle_validate_a, borrow system_lifecycle_validate_b,
        system_lifecycle_validate.verify(borrow world, borrow system_lifecycle_validate_a));
    let system_lifecycle_schedule_a = system_lifecycle_schedule.evaluate(borrow world);
    let system_lifecycle_schedule_b = system_lifecycle_schedule.evaluate(borrow world);
    include(inout out, borrow system_lifecycle_schedule_a, borrow system_lifecycle_schedule_b,
        system_lifecycle_schedule.verify(borrow world, borrow system_lifecycle_schedule_a));
    let system_lifecycle_prepare_a = system_lifecycle_prepare.evaluate(borrow world);
    let system_lifecycle_prepare_b = system_lifecycle_prepare.evaluate(borrow world);
    include(inout out, borrow system_lifecycle_prepare_a, borrow system_lifecycle_prepare_b,
        system_lifecycle_prepare.verify(borrow world, borrow system_lifecycle_prepare_a));
    let system_lifecycle_dispatch_a = system_lifecycle_dispatch.evaluate(borrow world);
    let system_lifecycle_dispatch_b = system_lifecycle_dispatch.evaluate(borrow world);
    include(inout out, borrow system_lifecycle_dispatch_a, borrow system_lifecycle_dispatch_b,
        system_lifecycle_dispatch.verify(borrow world, borrow system_lifecycle_dispatch_a));
    let system_lifecycle_apply_a = system_lifecycle_apply.evaluate(borrow world);
    let system_lifecycle_apply_b = system_lifecycle_apply.evaluate(borrow world);
    include(inout out, borrow system_lifecycle_apply_a, borrow system_lifecycle_apply_b,
        system_lifecycle_apply.verify(borrow world, borrow system_lifecycle_apply_a));
    let system_lifecycle_resolve_a = system_lifecycle_resolve.evaluate(borrow world);
