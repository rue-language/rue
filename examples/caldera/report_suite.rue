    let report_replay_prometheus_b = report_replay_prometheus.render(borrow world, suite_digest);
    include(inout out, borrow report_replay_prometheus_a, borrow report_replay_prometheus_b, report_replay_prometheus.verify(borrow report_replay_prometheus_a));
    let report_replay_trace_a = report_replay_trace.render(borrow world, suite_digest);
    let report_replay_trace_b = report_replay_trace.render(borrow world, suite_digest);
    include(inout out, borrow report_replay_trace_a, borrow report_replay_trace_b, report_replay_trace.verify(borrow report_replay_trace_a));
    let report_replay_graph_a = report_replay_graph.render(borrow world, suite_digest);
    let report_replay_graph_b = report_replay_graph.render(borrow world, suite_digest);
    include(inout out, borrow report_replay_graph_a, borrow report_replay_graph_b, report_replay_graph.verify(borrow report_replay_graph_a));
    out.valid = out.documents == 64 && out.failures == 0 &&
        out.deterministic_mismatches == 0; out
}
