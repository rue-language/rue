    let behavior_citizen_evade_b = behavior_citizen_evade.evaluate(borrow world);
    include(inout out, borrow behavior_citizen_evade_a, borrow behavior_citizen_evade_b,
        behavior_citizen_evade.verify(borrow world, borrow behavior_citizen_evade_a));
    let behavior_citizen_assist_a = behavior_citizen_assist.evaluate(borrow world);
    let behavior_citizen_assist_b = behavior_citizen_assist.evaluate(borrow world);
    include(inout out, borrow behavior_citizen_assist_a, borrow behavior_citizen_assist_b,
        behavior_citizen_assist.verify(borrow world, borrow behavior_citizen_assist_a));
    let behavior_citizen_trade_a = behavior_citizen_trade.evaluate(borrow world);
    let behavior_citizen_trade_b = behavior_citizen_trade.evaluate(borrow world);
    include(inout out, borrow behavior_citizen_trade_a, borrow behavior_citizen_trade_b,
        behavior_citizen_trade.verify(borrow world, borrow behavior_citizen_trade_a));
    let behavior_citizen_rest_a = behavior_citizen_rest.evaluate(borrow world);
    let behavior_citizen_rest_b = behavior_citizen_rest.evaluate(borrow world);
    include(inout out, borrow behavior_citizen_rest_a, borrow behavior_citizen_rest_b,
        behavior_citizen_rest.verify(borrow world, borrow behavior_citizen_rest_a));
    let behavior_citizen_learn_a = behavior_citizen_learn.evaluate(borrow world);
    let behavior_citizen_learn_b = behavior_citizen_learn.evaluate(borrow world);
    include(inout out, borrow behavior_citizen_learn_a, borrow behavior_citizen_learn_b,
        behavior_citizen_learn.verify(borrow world, borrow behavior_citizen_learn_a));
    let behavior_citizen_coordinate_a = behavior_citizen_coordinate.evaluate(borrow world);
    let behavior_citizen_coordinate_b = behavior_citizen_coordinate.evaluate(borrow world);
    include(inout out, borrow behavior_citizen_coordinate_a, borrow behavior_citizen_coordinate_b,
        behavior_citizen_coordinate.verify(borrow world, borrow behavior_citizen_coordinate_a));
    let behavior_citizen_celebrate_a = behavior_citizen_celebrate.evaluate(borrow world);
    let behavior_citizen_celebrate_b = behavior_citizen_celebrate.evaluate(borrow world);
    include(inout out, borrow behavior_citizen_celebrate_a, borrow behavior_citizen_celebrate_b,
        behavior_citizen_celebrate.verify(borrow world, borrow behavior_citizen_celebrate_a));
    out.valid = out.behaviors == 128 && out.deterministic_mismatches == 0; out
}
