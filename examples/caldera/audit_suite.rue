pub struct Summary { passes: u64, observations: u64, warnings: u64,
    deterministic_mismatches: u64, digest: u64, valid: bool }

fn include(inout out: Summary, borrow first: metric.Metric, borrow second: metric.Metric, verified: bool) {
    out.passes += 1; out.observations += first.observations;
    out.warnings += first.warnings;
    if first.digest != second.digest || first.total != second.total || !verified {
        out.deterministic_mismatches += 1;
    }
    out.digest = metric.mix(out.digest, first.digest);
}

pub fn run(borrow world: model.World) -> Summary {
    let mut out = Summary { passes: 0, observations: 0, warnings: 0,
        deterministic_mismatches: 0, digest: 14695981039346656037, valid: false };
    let audit_world_density_a = audit_world_density.analyze(borrow world);
    let audit_world_density_b = audit_world_density.analyze(borrow world);
    include(inout out, borrow audit_world_density_a, borrow audit_world_density_b,
        audit_world_density.verify(borrow world, borrow audit_world_density_a));
    let audit_world_balance_a = audit_world_balance.analyze(borrow world);
    let audit_world_balance_b = audit_world_balance.analyze(borrow world);
    include(inout out, borrow audit_world_balance_a, borrow audit_world_balance_b,
        audit_world_balance.verify(borrow world, borrow audit_world_balance_a));
    let audit_world_pressure_a = audit_world_pressure.analyze(borrow world);
    let audit_world_pressure_b = audit_world_pressure.analyze(borrow world);
    include(inout out, borrow audit_world_pressure_a, borrow audit_world_pressure_b,
        audit_world_pressure.verify(borrow world, borrow audit_world_pressure_a));
    let audit_world_locality_a = audit_world_locality.analyze(borrow world);
    let audit_world_locality_b = audit_world_locality.analyze(borrow world);
    include(inout out, borrow audit_world_locality_a, borrow audit_world_locality_b,
        audit_world_locality.verify(borrow world, borrow audit_world_locality_a));
    let audit_world_fanout_a = audit_world_fanout.analyze(borrow world);
    let audit_world_fanout_b = audit_world_fanout.analyze(borrow world);
    include(inout out, borrow audit_world_fanout_a, borrow audit_world_fanout_b,
        audit_world_fanout.verify(borrow world, borrow audit_world_fanout_a));
    let audit_world_continuity_a = audit_world_continuity.analyze(borrow world);
    let audit_world_continuity_b = audit_world_continuity.analyze(borrow world);
    include(inout out, borrow audit_world_continuity_a, borrow audit_world_continuity_b,
        audit_world_continuity.verify(borrow world, borrow audit_world_continuity_a));
    let audit_world_coverage_a = audit_world_coverage.analyze(borrow world);
    let audit_world_coverage_b = audit_world_coverage.analyze(borrow world);
    include(inout out, borrow audit_world_coverage_a, borrow audit_world_coverage_b,
        audit_world_coverage.verify(borrow world, borrow audit_world_coverage_a));
    let audit_world_skew_a = audit_world_skew.analyze(borrow world);
    let audit_world_skew_b = audit_world_skew.analyze(borrow world);
    include(inout out, borrow audit_world_skew_a, borrow audit_world_skew_b,
        audit_world_skew.verify(borrow world, borrow audit_world_skew_a));
    let audit_world_capacity_a = audit_world_capacity.analyze(borrow world);
    let audit_world_capacity_b = audit_world_capacity.analyze(borrow world);
    include(inout out, borrow audit_world_capacity_a, borrow audit_world_capacity_b,
        audit_world_capacity.verify(borrow world, borrow audit_world_capacity_a));
    let audit_world_latency_a = audit_world_latency.analyze(borrow world);
    let audit_world_latency_b = audit_world_latency.analyze(borrow world);
    include(inout out, borrow audit_world_latency_a, borrow audit_world_latency_b,
        audit_world_latency.verify(borrow world, borrow audit_world_latency_a));
    let audit_world_stability_a = audit_world_stability.analyze(borrow world);
    let audit_world_stability_b = audit_world_stability.analyze(borrow world);
    include(inout out, borrow audit_world_stability_a, borrow audit_world_stability_b,
        audit_world_stability.verify(borrow world, borrow audit_world_stability_a));
    let audit_world_integrity_a = audit_world_integrity.analyze(borrow world);
    let audit_world_integrity_b = audit_world_integrity.analyze(borrow world);
    include(inout out, borrow audit_world_integrity_a, borrow audit_world_integrity_b,
        audit_world_integrity.verify(borrow world, borrow audit_world_integrity_a));
    let audit_world_cost_a = audit_world_cost.analyze(borrow world);
    let audit_world_cost_b = audit_world_cost.analyze(borrow world);
    include(inout out, borrow audit_world_cost_a, borrow audit_world_cost_b,
        audit_world_cost.verify(borrow world, borrow audit_world_cost_a));
    let audit_world_risk_a = audit_world_risk.analyze(borrow world);
    let audit_world_risk_b = audit_world_risk.analyze(borrow world);
    include(inout out, borrow audit_world_risk_a, borrow audit_world_risk_b,
        audit_world_risk.verify(borrow world, borrow audit_world_risk_a));
    let audit_world_throughput_a = audit_world_throughput.analyze(borrow world);
    let audit_world_throughput_b = audit_world_throughput.analyze(borrow world);
    include(inout out, borrow audit_world_throughput_a, borrow audit_world_throughput_b,
        audit_world_throughput.verify(borrow world, borrow audit_world_throughput_a));
    let audit_world_entropy_a = audit_world_entropy.analyze(borrow world);
    let audit_world_entropy_b = audit_world_entropy.analyze(borrow world);
    include(inout out, borrow audit_world_entropy_a, borrow audit_world_entropy_b,
        audit_world_entropy.verify(borrow world, borrow audit_world_entropy_a));
    let audit_entity_density_a = audit_entity_density.analyze(borrow world);
    let audit_entity_density_b = audit_entity_density.analyze(borrow world);
    include(inout out, borrow audit_entity_density_a, borrow audit_entity_density_b,
        audit_entity_density.verify(borrow world, borrow audit_entity_density_a));
    let audit_entity_balance_a = audit_entity_balance.analyze(borrow world);
    let audit_entity_balance_b = audit_entity_balance.analyze(borrow world);
    include(inout out, borrow audit_entity_balance_a, borrow audit_entity_balance_b,
        audit_entity_balance.verify(borrow world, borrow audit_entity_balance_a));
    let audit_entity_pressure_a = audit_entity_pressure.analyze(borrow world);
    let audit_entity_pressure_b = audit_entity_pressure.analyze(borrow world);
