// This is a simple Rue program demonstrating comment support

fn main() -> i32 {
    // Single-line comments work great!
    let x: i32 = 42;
    
    /* Multi-line comments
       can span multiple
       lines */
    let y: i32 = 10;
    
    /* Nested /* comments are */ supported too! */
    
    // Comments can be at the end of lines
    x + y // This will return 52
}