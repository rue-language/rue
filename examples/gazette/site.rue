// gazette the static site generator: content discovery, the page and section
// model, template application, section indexes, the RSS feed, static
// passthrough, and the output tree (ADR-0072 Phase 4, RUE-1484).
//
// RUE-1483 delivered the three text-processing libraries this builds on. What
// this module adds is everything between "a Markdown file" and "a site": which
// files exist, what route each one takes, which section it belongs to, what
// order a section's pages are in, which template renders it, and where the
// bytes land.
//
// THE SHAPE IS ZOLA'S, because the corpus is a Zola site and ADR-0072
// Decision 3's work-equivalence claim is only honest if the job is the same
// job:
//
//   routes        `_index.md` is its directory's section; `<name>.md` becomes
//                 `<name>/index.html`; the content root's `_index.md` is `/`
//   sections      `_index.md` declares a section. Leaf `index.md` bundles
//                 belong to their nearest enclosing section; a directory of
//                 ordinary pages still needs a declared section.
//   ordering      `sort_by = "weight" | "date"`, else content-path order
//   templates     a page's own `template`, else its section's `page_template`,
//                 else `page.html`; a section's own `template`, else
//                 `section.html`
//   feeds         a section with `generate_feeds = true` emits `rss.xml`
//                 beside its index; the site flag emits a root feed too
//   redirects     a section with `redirect_to` emits Zola's redirect stub
//                 instead of its own index page — see below
//   static        everything under `static/` is copied to the output root
//
// ORDERING TIE-BREAKS ARE TOTAL AND DECLARED. ADR-0072 Decision 2's scale
// variants duplicate the corpus under path prefixes, so the duplicated
// sections tie on weight, on title, and on date — every field a comparison
// would naturally use. Each comparison here therefore ends in the content
// path, which is unique by construction, so the order is a total order and two
// runs over the same tree cannot disagree. A missing `weight` sorts last and a
// missing `date` sorts last, matching Zola's treatment of an absent key rather
// than defaulting it to zero and quietly promoting the page to the front.
//
// NOTHING HERE KNOWS THE CORPUS. No page name, section name, shortcode name,
// or template name from rue-lang.dev appears in this file; the template set is
// discovered from the site directory and the shortcodes are resolved by the
// Markdown library's general `shortcodes/<name>.html` mapping. That is
// ADR-0072 Decision 3's fairness rule, and it binds the site model exactly as
// it binds the engine: a build that special-cased the site it was measured on
// would beat Zola while passing every output check.
//
// THE ACTIVE-NAVIGATION DECISION LIVES IN THE TEMPLATES, not here. The
// production sidebar is a recursive macro gated on a prefix test, and the port
// in `templates/` keeps it that way: this module hands the engine the section
// tree and the current page's permalink and nothing else. Flattening the nav
// host-side would move measured work out of the measured program and would
// pass every check ADR-0072 Decision 4 defines, which is exactly why the rule
// is written down rather than left to the validator.
const std = @import("std");
const ast = @import("tmpl_ast.rue");
const frontmatter = @import("frontmatter.rue");
const markdown = @import("markdown.rue");
const metadata = @import("metadata.rue");
const check = @import("check.rue");
const highlight = @import("highlight.rue");
const text = @import("text.rue");
const tmpl_eval = @import("tmpl_eval.rue");
const tmpl_parse = @import("tmpl_parse.rue");
const value = @import("value.rue");
const StrBuf = std.strbuf.StrBuf;
const Bytes = std.arraybuf.ArrayBuf(u8);
const FileRes = std.result.Result(std.fs.File, std.fs.FileError);
const ReadRes = std.result.Result(u64, std.fs.FileError);
const WriteRes = std.result.Result((), std.fs.FileError);
const DirRes = std.result.Result(std.fs.DirEntries, std.fs.FileError);
const UnitRes = std.result.Result((), std.fs.FileError);

fn NONE() -> u64 { ast.NONE() }

pub fn SORT_NONE() -> u64 { 0 }
pub fn SORT_WEIGHT() -> u64 { 1 }
pub fn SORT_DATE() -> u64 { 2 }

// ---------------------------------------------------------------------------
// File I/O
// ---------------------------------------------------------------------------

pub struct FileInput { data: StrBuf, ok: bool }

pub fn read_file(borrow path: StrBuf) -> FileInput {
    let mut raw = Bytes.new();
    let mut f = match std.fs.File.open(borrow path) {
        FileRes.Ok(file) => file,
        FileRes.Err(_e) => { return FileInput { data: StrBuf.new(), ok: false }; },
    };
    let mut ok = true;
    let chunk: u64 = 65536;
    loop {
        raw.reserve(chunk);
        let n = match f.read(inout raw) {
            ReadRes.Ok(k) => k,
            ReadRes.Err(_e) => { ok = false; 0 },
        };
        if n == 0 { break; }
    }
    let _ = f.close();
    FileInput { data: StrBuf.from_bytes(borrow raw), ok: ok }
}

fn write_file(borrow path: StrBuf, borrow body: StrBuf) -> bool {
    let mut file = match std.fs.File.create(borrow path) {
        FileRes.Ok(f) => f,
        FileRes.Err(_e) => { return false; },
    };
    let bytes = body.to_bytes();
    let ok = match file.write_all(borrow bytes) {
        WriteRes.Ok(_unit) => true,
        WriteRes.Err(_e) => false,
    };
    let _ = file.close();
    ok
}

// Everything up to and including the last `/`, or the empty string. Used both
// for the directory a page belongs to and for the directory an output file
// needs created before it can be written.
fn dir_of(borrow path: StrBuf) -> StrBuf {
    let mut i = path.len();
    while i > 0 {
        if text.byte_of(borrow path, i - 1) == 47 { return text.slice(borrow path, 0, i); }
        i -= 1;
    }
    StrBuf.new()
}

fn join_path(borrow base: StrBuf, borrow rest: StrBuf) -> StrBuf {
    let mut out = text.slice(borrow base, 0, base.len());
    if out.len() > 0 && text.byte_of(borrow out, out.len() - 1) != 47 { out.push(47); }
    out.append_borrowed(borrow rest);
    out
}

// Write `body` to `path`, creating the directories above it first. Output
// directories are created on demand rather than pre-computed because the route
// set is not known until discovery has run, and `create_dir_all` is idempotent.
fn write_output(borrow path: StrBuf, borrow body: StrBuf) -> bool {
    let parent = dir_of(borrow path);
    if parent.len() > 0 {
        let trimmed = text.slice(borrow parent, 0, parent.len() - 1);
        match std.fs.create_dir_all(borrow trimmed) {
            UnitRes.Ok(_u) => {},
            UnitRes.Err(_e) => { return false; },
        }
    }
    write_file(borrow path, borrow body)
}

fn tag_name(borrow source: StrBuf, start: u64) -> StrBuf {
    let mut i = start + 1;
    if text.byte_of(borrow source, i) == 47 { i += 1; }
    let mut name = StrBuf.new();
    while i < source.len() {
        let b = text.lower_byte(text.byte_of(borrow source, i));
        if b < 97 || b > 122 { break; }
        name.push(b); i += 1;
    }
    name
}

fn minify_html(borrow source: StrBuf) -> StrBuf {
    let mut out = StrBuf.new();
    let mut raw = StrBuf.new();
    let mut pending_space = false;
    let mut i: u64 = 0;
    while i < source.len() {
        let b = text.byte_of(borrow source, i);
        if raw.len() > 0 {
            if b == 60 && text.byte_of(borrow source, i + 1) == 47
                && StrBuf.equals_borrowed(borrow tag_name(borrow source, i), borrow raw) {
                raw = StrBuf.new();
            } else { out.push(b); i += 1; continue; }
        }
        if source.matches_at(i, borrow "<!--") {
            let close = text.find_from(borrow source, borrow "-->", i + 4);
            i = if close < source.len() { close + 3 } else { source.len() };
            continue;
        }
        if text.is_blank_byte(b) || b == 10 || b == 13 {
            pending_space = true; i += 1; continue;
        }
        if pending_space && out.len() > 0 { out.push(32); }
        pending_space = false;
        if b == 60 {
            let name = tag_name(borrow source, i);
            let opening = text.byte_of(borrow source, i + 1) != 47;
            let mut quote: u8 = 0;
            loop {
                let c = text.byte_of(borrow source, i); out.push(c); i += 1;
                if quote != 0 { if c == quote { quote = 0; } }
                else if c == 34 || c == 39 { quote = c; }
                else if c == 62 { break; }
                if i >= source.len() { break; }
            }
            if opening && (text.equals_str(borrow name, "pre") || text.equals_str(borrow name, "script")
                || text.equals_str(borrow name, "style") || text.equals_str(borrow name, "textarea")) { raw = name; }
        } else { out.push(b); i += 1; }
    }
    out
}

// ---------------------------------------------------------------------------
// The model
// ---------------------------------------------------------------------------

// Every key the site model interns, done once. Interning inside the render
// loops would hash the same dozen names once per page; at ADR-0072's 100x
// scale variant that is nine thousand repetitions of a constant.
pub struct Keys {
    title: u64,
    date: u64,
    weight: u64,
    description: u64,
    extra: u64,
    template: u64,
    path: u64,
    page_template: u64,
    sort_by: u64,
    generate_feeds: u64,
    paginate_by: u64,
    redirect_to: u64,
    content: u64,
    permalink: u64,
    summary: u64,
    pages: u64,
    subsections: u64,
    lower: u64,
    higher: u64,
    page: u64,
    section: u64,
    config: u64,
    url: u64,
    feed_url: u64,
    paginator: u64,
    previous: u64,
    next: u64,
    sections_global: u64,
    page_url_global: u64,
    base_url_global: u64,
    site_root_global: u64,
    routes_global: u64,
    plain_text: u64,
    toc: u64,
}

fn intern_keys(inout eng: ast.Engine) -> Keys {
    Keys {
        title: eng.key("title"),
        date: eng.key("date"),
        weight: eng.key("weight"),
        description: eng.key("description"),
        extra: eng.key("extra"),
        template: eng.key("template"),
        page_template: eng.key("page_template"),
        sort_by: eng.key("sort_by"),
        generate_feeds: eng.key("generate_feeds"),
        paginate_by: eng.key("paginate_by"),
        redirect_to: eng.key("redirect_to"),
        content: eng.key("content"),
        permalink: eng.key("permalink"),
        path: eng.key("path"),
        summary: eng.key("summary"),
        pages: eng.key("pages"),
        subsections: eng.key("subsections"),
        lower: eng.key("lower"),
        higher: eng.key("higher"),
        page: eng.key("page"),
        section: eng.key("section"),
        config: eng.key("config"),
        url: eng.key("url"),
        feed_url: eng.key("feed_url"),
        paginator: eng.key("paginator"),
        previous: eng.key("previous"),
        next: eng.key("next"),
        sections_global: eng.key("__sections"),
        page_url_global: eng.key("__page_url"),
        base_url_global: eng.key("__base_url"),
        site_root_global: eng.key("__site_root"),
        routes_global: eng.key("__routes"),
        plain_text: eng.key("plain_text"),
        toc: eng.key("toc"),
    }
}

// One content file. String fields are pool ids, so a duplicated corpus costs
// one copy of each distinct path component rather than one per page.
pub struct Page {
    rel: u64,
    route: u64,
    permalink: u64,
    source: u64,
    front: u64,
    body_start: u64,
    body_line: u64,
    section: u64,
    is_index: bool,
    weight: u64,
    template: u64,
    path: u64,
    content: u64,
    summary: u64,
    entry: u64,
    object: u64,
    plain_text: u64,
    toc: u64,
    search_body: u64,
}

pub fn empty_page() -> Page {
    Page {
        rel: NONE(), route: NONE(), permalink: NONE(), source: NONE(), front: NONE(),
        body_start: 0, body_line: 1, section: NONE(), is_index: false, weight: NONE(),
        template: NONE(), path: NONE(), content: NONE(), summary: NONE(), entry: NONE(), object: NONE(),
        plain_text: NONE(), toc: NONE(), search_body: NONE(),
    }
}

// One section: its `_index.md`, its place in the tree, and the ranges of
// `section_pages` / `section_subs` holding its sorted children.
pub struct Section {
    page: u64,
    key: u64,
    dir: u64,
    parent: u64,
    sort_by: u64,
    generate_feeds: bool,
    paginate_by: u64,
    redirect_to: u64,
    page_start: u64,
    page_count: u64,
    sub_start: u64,
    sub_count: u64,
    object: u64,
}

pub fn empty_section() -> Section {
    Section {
        page: NONE(), key: NONE(), dir: NONE(), parent: NONE(), sort_by: SORT_NONE(),
        generate_feeds: false, paginate_by: NONE(), redirect_to: NONE(), page_start: 0, page_count: 0,
        sub_start: 0, sub_count: 0, object: NONE(),
    }
}

pub const Pages = std.arraybuf.ArrayBuf(Page);
pub const Sections = std.arraybuf.ArrayBuf(Section);

pub struct Site {
    keys: Keys,
    pages: Pages,
    sections: Sections,
    section_pages: value.U64s,
    section_subs: value.U64s,
    // Section directory pool ids, ascending, with the parallel section index.
    // Two identical directory strings intern to the same id, so an EQUALITY
    // lookup is a binary search over integers — which keeps assigning nine
    // thousand pages to fourteen hundred sections linearithmic rather than the
    // product of the two.
    dir_ids: value.U64s,
    dir_index: value.U64s,
    config: u64,
    root: StrBuf,
    content_root: StrBuf,
    output_root: StrBuf,
    global_feeds: bool,
    minify_html: bool,
    highlight_code: bool,
    metadata: bool,
    content_metadata: bool,
    highlight_themes: u64,
    search_index: bool,
    pages_rendered: u64,
    files_written: u64,
    // `--list` records every emitted path, in emission order. Off by default:
    // at ADR-0072's 100x scale that is nine and a half thousand lines of
    // stdout, which would be measured work in a run that exists to measure the
    // build. It is what makes the emitted file set assertable from a CLI test.
    list: bool,
    listing: StrBuf,
    heading_meta: metadata.AllHeadings,

    fn new() -> Self {
        Self {
            keys: Keys {
                title: 0, date: 0, weight: 0, description: 0, extra: 0, template: 0,
                page_template: 0, sort_by: 0, generate_feeds: 0, paginate_by: 0, redirect_to: 0,
                content: 0, permalink: 0, path: 0, summary: 0, pages: 0,
                subsections: 0, lower: 0, higher: 0, page: 0, section: 0, config: 0,
                url: 0, feed_url: 0, paginator: 0, previous: 0, next: 0, sections_global: 0, page_url_global: 0,
                base_url_global: 0,
                site_root_global: 0,
                routes_global: 0,
                plain_text: 0, toc: 0,
            },
            pages: Pages.new(),
            sections: Sections.new(),
            section_pages: value.U64s.new(),
            section_subs: value.U64s.new(),
            dir_ids: value.U64s.new(),
            dir_index: value.U64s.new(),
            config: 0, global_feeds: false, minify_html: false, highlight_code: false, metadata: false, content_metadata: false, highlight_themes: NONE(), search_index: false,
            root: StrBuf.new(),
            content_root: StrBuf.new(),
            output_root: StrBuf.new(),
            pages_rendered: 0,
            files_written: 0,
            list: false,
            listing: StrBuf.new(),
            heading_meta: metadata.AllHeadings.new(),
        }
    }

    fn page_at(borrow self, i: u64) -> Page { self.pages.get_or(i, empty_page()) }
    fn section_at(borrow self, i: u64) -> Section { self.sections.get_or(i, empty_section()) }
}

fn fail(inout eng: ast.Engine, detail: StrBuf, subject: u64) {
    eng.error(value.E_TEMPLATE(), 0, detail, subject);
}

// ---------------------------------------------------------------------------
// Configuration
// ---------------------------------------------------------------------------

// Read `config.toml` and bind the globals every later stage reads. The site's
// base URL is the one input the route model cannot derive, so a config that
// fails to parse stops the build here rather than producing a site of relative
// links that happen to work locally.
fn load_config(inout site: Site, inout eng: ast.Engine) -> bool {
    let path = join_path(borrow site.root, borrow "config.toml");
    eng.set_source(borrow path);
    let input = read_file(borrow path);
    if !input.ok {
        let subject = eng.arena.strings.intern(borrow path);
        fail(inout eng, "cannot read the site configuration", subject);
        return false;
    }
    eng.set_source(borrow path);
    let parsed = frontmatter.parse_document(inout eng.arena, borrow input.data);
    site.config = parsed.root;
    if !parsed.ok { return false; }

    let base_url_key = eng.key("base_url");
    let base = eng.arena.map_get(site.config, base_url_key);
    if eng.arena.tag(base) != value.V_STR() {
        fail(inout eng, "the site configuration has no `base_url` string", NONE());
        return false;
    }
    let override = eng.lookup(eng.key("__base_url_override"));
    let base_text = if eng.arena.tag(override) == value.V_STR()
        && eng.arena.length(override) > 0 { eng.arena.scalar(override) }
        else { eng.arena.scalar(base) };
    let base_value = eng.arena.string(borrow base_text);
    if eng.arena.tag(override) == value.V_STR() && eng.arena.length(override) > 0 {
        let mut fields = value.Entries.new();
        let mut i: u64 = 0;
        while i < eng.arena.length(site.config) {
            let mut entry = eng.arena.entry_at(site.config, i);
            if entry.key == base_url_key { entry.value = base_value; }
            fields.push(entry); i += 1;
        }
        site.config = eng.arena.map(borrow fields);
    }
    eng.set_global(site.keys.base_url_global, base_value);
    let root_value = eng.arena.string(borrow site.root);
    eng.set_global(site.keys.site_root_global, root_value);
    eng.set_global(site.keys.config, site.config);
    site.global_feeds = eng.arena.truthy(eng.arena.map_get(site.config, site.keys.generate_feeds));
    site.minify_html = eng.arena.truthy(eng.arena.map_get(site.config, eng.key("minify_html")));
    site.metadata = eng.arena.truthy(eng.arena.map_get_literal(site.config, "generate_metadata"));
    site.content_metadata = eng.arena.truthy(eng.arena.map_get_literal(site.config, "generate_content_metadata"));
    site.search_index = eng.arena.truthy(eng.arena.map_get(site.config, eng.key("build_search_index")));
    let search = eng.arena.map_get_literal(site.config, "search");
    let format = eng.arena.map_get_literal(search, "index_format");
    if site.search_index && format != NONE() && !eng.arena.strings.equals_literal(eng.arena.scalar_id(format), "gazette_json") {
        fail(inout eng, "search index_format must be gazette_json", NONE());
        return false;
    }
    load_highlighting(inout site, inout eng)
}

// Configuration and emission share validated theme values. Generated CSS is
// written after static assets so a previous build's stylesheet cannot win.
fn load_highlighting(inout site: Site, inout eng: ast.Engine) -> bool {
    let config = eng.arena.map_get_literal(site.config, "markdown");
    site.highlight_code = eng.arena.truthy(eng.arena.map_get_literal(config, "highlight_code"));
    eng.set_global(eng.key("__highlight_code"), eng.arena.boolean(site.highlight_code));
    if !site.highlight_code { return true; }
    let theme = eng.arena.map_get_literal(config, "highlight_theme");
    if !eng.arena.strings.equals_literal(eng.arena.scalar_id(theme), "css") {
        fail(inout eng, "highlight_theme must be css", NONE()); return false;
    }
    let definitions = eng.arena.map_get_literal(config, "syntax_definitions");
    let relative = eng.arena.scalar(definitions);
    if relative.len() == 0 || !valid_explicit_route(borrow relative) || relative.starts_with(borrow "/") {
        fail(inout eng, "syntax_definitions must name a site-relative JSON file", NONE()); return false;
    }
    let path = join_path(borrow site.root, borrow relative);
    eng.set_source(borrow path);
    let input = read_file(borrow path);
    if !input.ok { fail(inout eng, "cannot read syntax definitions", eng.key(path)); return false; }
    eng.set_source(borrow path);
    let parsed = frontmatter.parse_json(inout eng.arena, borrow input.data);
    if !parsed.ok || !highlight.validate(inout eng, parsed.root) { return false; }
    eng.set_global(eng.key("__highlight_syntaxes"), parsed.root);
    site.highlight_themes = eng.arena.map_get_literal(config, "highlight_themes_css");
    if eng.arena.tag(site.highlight_themes) != value.V_ARRAY() || eng.arena.length(site.highlight_themes) == 0 {
        fail(inout eng, "highlight_themes_css must contain CSS theme declarations", NONE()); return false;
    }
    let mut i: u64 = 0;
    while i < eng.arena.length(site.highlight_themes) {
        let entry = eng.arena.item(site.highlight_themes, i);
        let name = eng.arena.scalar(eng.arena.map_get_literal(entry, "theme"));
        let file = eng.arena.scalar(eng.arena.map_get_literal(entry, "filename"));
        if highlight.theme_css(borrow name).len() == 0 || file.len() == 0 || !file.ends_with(borrow ".css")
            || file.starts_with(borrow "/") || !valid_explicit_route(borrow file) {
            fail(inout eng, "invalid highlight theme or CSS filename", NONE()); return false;
        }
        i += 1;
    }
    true
}

fn emit_highlighting(inout site: Site, inout eng: ast.Engine) -> bool {
    let mut i: u64 = 0;
    while i < eng.arena.length(site.highlight_themes) {
        let entry = eng.arena.item(site.highlight_themes, i);
        let name = eng.arena.scalar(eng.arena.map_get_literal(entry, "theme"));
        let file = eng.arena.scalar(eng.arena.map_get_literal(entry, "filename"));
        let css = highlight.theme_css(borrow name);
        if !write_output(borrow join_path(borrow site.output_root, borrow file), borrow css) { return false; }
        site.files_written += 1;
        if site.list { site.listing.append_borrowed(borrow file); site.listing.push(10); }
        i += 1;
    }
    true
}

// ---------------------------------------------------------------------------
// Templates
// ---------------------------------------------------------------------------

// Register every template in `templates/` under the name content and other
// templates refer to it by — its path relative to that directory, which is
// exactly Zola's rule. The walk is `std.fs`'s deterministic one, so a template
// set is registered in the same order on every machine.
fn load_templates(inout site: Site, inout eng: ast.Engine) -> bool {
    let root = join_path(borrow site.root, borrow "templates");
    let entries = match std.fs.walk(borrow root) {
        DirRes.Ok(list) => list,
        DirRes.Err(_e) => {
            let subject = eng.arena.strings.intern(borrow root);
            fail(inout eng, "cannot read the template directory", subject);
            return false;
        },
    };
    let prefix = root.len() + 1;
    let mut i: u64 = 0;
    let mut ok = true;
    while i < entries.len() {
        if entries.is_file(i) {
            let path = entries.path(i);
            if path.ends_with(borrow ".html") || path.ends_with(borrow ".xml") {
                let name = text.slice(borrow path, prefix, path.len());
                eng.set_source(borrow path);
                let input = read_file(borrow path);
                if !input.ok {
                    let subject = eng.arena.strings.intern(borrow path);
                    fail(inout eng, "cannot read a template", subject);
                    ok = false;
                } else {
                    eng.set_source(borrow path);
                    let _ = tmpl_parse.parse_template(inout eng, name, borrow input.data);
                }
            }
        }
        i += 1;
    }
    ok
}

// ---------------------------------------------------------------------------
// Discovery
// ---------------------------------------------------------------------------

// Read every `.md` file under `content/`, parse its front matter, and record
// the route it takes. `content_route` is the same function the Markdown link
// renderer uses to resolve a `@/…` destination, so a link to a page and the
// page's own route cannot disagree — including about the slugification it
// applies to a file stem, which is why the route is not computed from the file
// name here.
fn discover(inout site: Site, inout eng: ast.Engine) -> bool {
    let entries = match std.fs.walk(borrow site.content_root) {
        DirRes.Ok(list) => list,
        DirRes.Err(_e) => {
            let subject = eng.arena.strings.intern(borrow site.content_root);
            fail(inout eng, "cannot read the content directory", subject);
            return false;
        },
    };
    let prefix = site.content_root.len() + 1;
    let mut i: u64 = 0;
    let mut ok = true;
    while i < entries.len() {
        if entries.is_file(i) {
            let path = entries.path(i);
            if path.ends_with(borrow ".md") {
                let rel = text.slice(borrow path, prefix, path.len());
                eng.set_source(borrow path);
                let input = read_file(borrow path);
                if !input.ok {
                    let subject = eng.arena.strings.intern(borrow path);
                    fail(inout eng, "cannot read a content file", subject);
                    ok = false;
                } else {
                    eng.set_source(borrow path);
                    if !add_page(inout site, inout eng, borrow rel, borrow input.data) { ok = false; }
                }
            }
        }
        i += 1;
    }
    if site.pages.len() == 0 {
        fail(inout eng, "the content directory holds no Markdown", NONE());
        return false;
    }
    ok
}

fn add_page(inout site: Site, inout eng: ast.Engine, borrow rel: StrBuf, borrow source: StrBuf) -> bool {
    let front = frontmatter.parse(inout eng.arena, borrow source);
    let explicit = eng.arena.map_get(front.root, site.keys.path);
    let mut route_valid = true;
    let route = if eng.arena.tag(explicit) == value.V_STR() {
        let mut chosen = eng.arena.scalar(explicit);
        while chosen.len() > 0 && text.byte_of(borrow chosen, 0) == 47 { chosen = text.slice(borrow chosen, 1, chosen.len()); }
        if chosen.len() == 0 || text.byte_of(borrow chosen, chosen.len() - 1) != 47 { chosen.push(47); }
        if !valid_explicit_route(borrow chosen) {
            fail(inout eng, "explicit content path may not escape the output root", explicit);
            route_valid = false;
        }
        chosen
    } else { tmpl_eval.content_route(inout eng, borrow rel, 0) };
    let permalink = tmpl_eval.join_base(inout eng, borrow route);

    if !route_valid { return false; }
    let rel_id = eng.arena.strings.intern(borrow rel);
    let route_id = eng.arena.strings.intern(borrow route);
    let permalink_id = eng.arena.strings.intern(borrow permalink);
    let source_id = eng.arena.strings.intern(borrow source);

    let mut duplicate = false;
    let mut prior: u64 = 0;
    while prior < site.pages.len() {
        if site.page_at(prior).route == route_id { duplicate = true; }
        prior += 1;
    }
    // A regular page may not claim the root output route. The root section is
    // owned by content/_index.md when it exists; allowing another page to
    // write `/` would otherwise silently overwrite that section's index.
    if (route.len() == 0 || (route.len() == 1 && text.byte_of(borrow route, 0) == 47)) && !is_index_path(borrow rel) { duplicate = true; }
    if duplicate { fail(inout eng, "two content files resolve to the same output route", route_id); }

    let is_index = rel.ends_with(borrow "_index.md");
    let weight_value = eng.arena.map_get(front.root, site.keys.weight);
    let weight = if eng.arena.tag(weight_value) == value.V_INT() {
        eng.arena.at(weight_value).num
    } else {
        // Absent, so it sorts last rather than as a zero that would silently
        // promote the page to the front of a weighted section.
        NONE()
    };

    site.pages.push(Page {
        rel: rel_id,
        route: route_id,
        permalink: permalink_id,
        source: source_id,
        front: front.root,
        body_start: front.body_start,
        body_line: front.body_line,
        section: NONE(),
        is_index: is_index,
        weight: weight,
        template: NONE(),
        path: explicit,
        content: NONE(),
        summary: NONE(),
        entry: NONE(),
        object: NONE(),
        plain_text: NONE(),
        toc: NONE(),
        search_body: NONE(),
    });
    front.ok
}

fn is_index_path(borrow rel: StrBuf) -> bool { rel.ends_with(borrow "_index.md") }

fn valid_explicit_route(borrow route: StrBuf) -> bool {
    let mut start: u64 = 0;
    let mut i: u64 = 0;
    while i <= route.len() {
        if i == route.len() || text.byte_of(borrow route, i) == 47 {
            let part = text.slice(borrow route, start, i);
            if StrBuf.equals_borrowed(borrow part, borrow "..") || StrBuf.equals_borrowed(borrow part, borrow ".") { return false; }
            start = i + 1;
        }
        i += 1;
    }
    true
}

// ---------------------------------------------------------------------------
// The section tree
// ---------------------------------------------------------------------------

fn sort_kind(inout eng: ast.Engine, front: u64, key: u64) -> u64 {
    let v = eng.arena.map_get(front, key);
    if eng.arena.tag(v) != value.V_STR() { return SORT_NONE(); }
    if eng.arena.strings.equals_literal(eng.arena.at(v).num, "weight") { return SORT_WEIGHT(); }
    if eng.arena.strings.equals_literal(eng.arena.at(v).num, "date") { return SORT_DATE(); }
    if eng.arena.strings.equals_literal(eng.arena.at(v).num, "none") { return SORT_NONE(); }
    let subject = eng.arena.at(v).num;
    fail(inout eng, "sort_by is outside the subset (weight, date, none)", subject);
    SORT_NONE()
}

// Build one section per `_index.md`, then link every section and every page to
// its directory. A content directory with no `_index.md` is REFUSED rather
// than turned into an implicit section: gazette's whole discipline is that
// content outside the documented subset breaks the build visibly, and an
// implicit section would silently change a page's ordering and its template.
fn build_sections(inout site: Site, inout eng: ast.Engine) -> bool {
    let mut ok = true;
    let mut i: u64 = 0;
    while i < site.pages.len() {
        let page = site.page_at(i);
        if page.is_index {
            let key = page.rel;
            let dir = page.route;
            let front = page.front;
            let redirect_value = eng.arena.map_get(front, site.keys.redirect_to);
            let redirect = if eng.arena.tag(redirect_value) == value.V_STR() {
                eng.arena.at(redirect_value).num
            } else {
                NONE()
            };
            let feeds_value = eng.arena.map_get(front, site.keys.generate_feeds);
            let feeds = eng.arena.truthy(feeds_value);
            let paginate_value = eng.arena.map_get(front, site.keys.paginate_by);
            let paginate = if eng.arena.tag(paginate_value) == value.V_INT() { eng.arena.at(paginate_value).num } else { NONE() };
            let kind = sort_kind(inout eng, front, site.keys.sort_by);
            site.sections.push(Section {
                page: i,
                key: key,
                dir: dir,
                parent: NONE(),
                sort_by: kind,
                generate_feeds: feeds,
                paginate_by: paginate,
                redirect_to: redirect,
                page_start: 0, page_count: 0, sub_start: 0, sub_count: 0,
                object: NONE(),
            });
        }
        i += 1;
    }

    build_dir_index(inout site);

    // Parents, by the directory one level up. The root section's directory is
    // the empty string and has no parent.
    let mut s: u64 = 0;
    while s < site.sections.len() {
        let mut section = site.section_at(s);
        let dir = eng.arena.strings.copy(section.dir);
        if dir.len() > 0 {
            let above = parent_dir(borrow dir);
            let above_id = eng.arena.strings.intern(borrow above);
            let parent = find_section_for_dir(borrow site, above_id);
            if parent == NONE() {
                fail(inout eng, "a content directory above this section has no `_index.md`", section.dir);
                ok = false;
            }
            section.parent = parent;
            site.sections.set(s, section);
        }
        s += 1;
    }

    // Pages, by their own directory.
    let mut p: u64 = 0;
    while p < site.pages.len() {
        let mut page = site.page_at(p);
        let rel = eng.arena.strings.copy(page.rel);
        let dir = dir_of(borrow rel);
        let dir_id = eng.arena.strings.intern(borrow dir);
        let mut owner = find_section_for_dir(borrow site, dir_id);
        if owner == NONE() && page.path != NONE() { owner = find_nearest_section(borrow site, inout eng, borrow rel); }
        if owner == NONE() {
            fail(inout eng, "this content directory has no `_index.md`", page.rel);
            ok = false;
        }
        page.section = owner;
        site.pages.set(p, page);
        p += 1;
    }
    ok
}

// `spec/03-types/` -> `spec/`; `spec/` -> ``.
fn parent_dir(borrow dir: StrBuf) -> StrBuf {
    if dir.len() == 0 { return StrBuf.new(); }
    let inner = text.slice(borrow dir, 0, dir.len() - 1);
    dir_of(borrow inner)
}

// Sort the section directory ids so the per-page lookup is a binary search.
fn build_dir_index(inout site: Site) {
    let mut ids = value.U64s.new();
    let mut index = value.U64s.new();
    let mut i: u64 = 0;
    while i < site.sections.len() {
        ids.push(site.section_at(i).dir);
        index.push(i);
        i += 1;
    }
    let mut k: u64 = 1;
    while k < ids.len() {
        let id = ids.get_or(k, 0);
        let at = index.get_or(k, 0);
        let mut j = k;
        while j > 0 && ids.get_or(j - 1, 0) > id {
            ids.set(j, ids.get_or(j - 1, 0));
            index.set(j, index.get_or(j - 1, 0));
            j -= 1;
        }
        ids.set(j, id);
        index.set(j, at);
        k += 1;
    }
    site.dir_ids = ids;
    site.dir_index = index;
}

fn find_section_for_dir(borrow site: Site, dir_id: u64) -> u64 {
    let mut low: u64 = 0;
    let mut high = site.dir_ids.len();
    while low < high {
        let mid = low + (high - low) / 2;
        let probe = site.dir_ids.get_or(mid, 0);
        if probe == dir_id { return site.dir_index.get_or(mid, NONE()); }
        if probe < dir_id { low = mid + 1; } else { high = mid; }
    }
    NONE()
}

fn find_nearest_section(borrow site: Site, inout eng: ast.Engine, borrow rel: StrBuf) -> u64 {
    let mut dir = dir_of(borrow rel);
    loop {
        let id = eng.arena.strings.intern(borrow dir);
        let found = find_section_for_dir(borrow site, id);
        if found != NONE() { return found; }
        if dir.len() == 0 { break; }
        dir = parent_dir(borrow dir);
    }
    NONE()
}

// ---------------------------------------------------------------------------
// Ordering
// ---------------------------------------------------------------------------

// Whether page `a` sorts before page `b` under `kind`. Every branch ends in
// the content path, which is unique, so this is a total order and the scale
// variants' ties on weight, title, and date cannot make the result depend on
// discovery order.
fn page_before(borrow site: Site, borrow eng: ast.Engine, a: u64, b: u64, kind: u64) -> bool {
    let pa = site.page_at(a);
    let pb = site.page_at(b);
    if kind == SORT_WEIGHT() {
        if pa.weight != pb.weight { return pa.weight < pb.weight; }
    } else if kind == SORT_DATE() {
        let da = date_id(borrow site, borrow eng, a);
        let db = date_id(borrow site, borrow eng, b);
        let order = eng.arena.strings.compare(da, db);
        // Newest first, and an absent date is the empty string, which compares
        // below every real date and therefore lands last.
        if order != 1 { return order == 2; }
    }
    eng.arena.strings.compare(pa.rel, pb.rel) == 0
}

fn date_id(borrow site: Site, borrow eng: ast.Engine, index: u64) -> u64 {
    let page = site.page_at(index);
    let v = eng.arena.map_get(page.front, site.keys.date);
    if eng.arena.tag(v) != value.V_STR() { return eng.arena.empty_string; }
    eng.arena.at(v).num
}

fn sort_pages(borrow site: Site, borrow eng: ast.Engine, inout list: value.U64s, kind: u64) {
    let mut k: u64 = 1;
    while k < list.len() {
        let current = list.get_or(k, 0);
        let mut j = k;
        while j > 0 {
            let prior = list.get_or(j - 1, 0);
            if !page_before(borrow site, borrow eng, current, prior, kind) { break; }
            list.set(j, prior);
            j -= 1;
        }
        list.set(j, current);
        k += 1;
    }
}

// Bucket a list of owners into contiguous per-owner ranges in ONE pass, by
// counting sort: `owner_of` is already recorded on every element, so a second
// pass over every element per owner is avoidable and must be avoided. Scanning
// all pages once per section is quadratic IN THE CORPUS — fifteen sections over
// ninety-five pages is nothing, but ADR-0072's 100x variant is fifteen hundred
// sections over nine and a half thousand pages, and this program is the thing
// being measured, so a scan that grows with the product of the two would be
// measuring the harness's accident rather than the language.
struct Buckets { starts: value.U64s, items: value.U64s }

fn bucket_by_owner(borrow owners: value.U64s, groups: u64) -> Buckets {
    let mut counts = value.U64s.new();
    let mut i: u64 = 0;
    while i < groups { counts.push(0); i += 1; }
    let mut e: u64 = 0;
    while e < owners.len() {
        let owner = owners.get_or(e, NONE());
        if owner != NONE() { counts.set(owner, counts.get_or(owner, 0) + 1); }
        e += 1;
    }
    let mut starts = value.U64s.new();
    let mut cursors = value.U64s.new();
    let mut running: u64 = 0;
    let mut g: u64 = 0;
    while g < groups {
        starts.push(running);
        cursors.push(running);
        running += counts.get_or(g, 0);
        g += 1;
    }
    starts.push(running);

    let mut items = value.U64s.new();
    let mut k: u64 = 0;
    while k < running { items.push(NONE()); k += 1; }
    let mut f: u64 = 0;
    while f < owners.len() {
        let owner = owners.get_or(f, NONE());
        if owner != NONE() {
            let at = cursors.get_or(owner, 0);
            items.set(at, f);
            cursors.set(owner, at + 1);
        }
        f += 1;
    }
    Buckets { starts: starts, items: items }
}

// Collect and sort each section's direct pages and subsections.
fn order_sections(inout site: Site, inout eng: ast.Engine) {
    let count = site.sections.len();

    let mut page_owner = value.U64s.new();
    let mut p: u64 = 0;
    while p < site.pages.len() {
        let page = site.page_at(p);
        page_owner.push(if page.is_index { NONE() } else { page.section });
        p += 1;
    }
    let by_section = bucket_by_owner(borrow page_owner, count);

    let mut sub_owner = value.U64s.new();
    let mut c: u64 = 0;
    while c < count { sub_owner.push(site.section_at(c).parent); c += 1; }
    let by_parent = bucket_by_owner(borrow sub_owner, count);

    let mut s: u64 = 0;
    while s < count {
        let mut section = site.section_at(s);

        let mut own = value.U64s.new();
        let mut i = by_section.starts.get_or(s, 0);
        let page_end = by_section.starts.get_or(s + 1, 0);
        while i < page_end { own.push(by_section.items.get_or(i, NONE())); i += 1; }
        sort_pages(borrow site, borrow eng, inout own, section.sort_by);
        section.page_start = site.section_pages.len();
        section.page_count = own.len();
        let mut a: u64 = 0;
        while a < own.len() { site.section_pages.push(own.get_or(a, 0)); a += 1; }

        let mut subs = value.U64s.new();
        let mut j = by_parent.starts.get_or(s, 0);
        let sub_end = by_parent.starts.get_or(s + 1, 0);
        while j < sub_end { subs.push(by_parent.items.get_or(j, NONE())); j += 1; }
        sort_subsections(borrow site, borrow eng, inout subs);
        section.sub_start = site.section_subs.len();
        section.sub_count = subs.len();
        let mut b: u64 = 0;
        while b < subs.len() { site.section_subs.push(subs.get_or(b, 0)); b += 1; }

        site.sections.set(s, section);
        s += 1;
    }
}

// Subsections order by their content path, which is what Zola does and what
// the numbered specification chapters rely on.
fn sort_subsections(borrow site: Site, borrow eng: ast.Engine, inout list: value.U64s) {
    let mut k: u64 = 1;
    while k < list.len() {
        let current = list.get_or(k, 0);
        let current_key = site.section_at(current).key;
        let mut j = k;
        while j > 0 {
            let prior = list.get_or(j - 1, 0);
            let prior_key = site.section_at(prior).key;
            if eng.arena.strings.compare(prior_key, current_key) != 2 { break; }
            list.set(j, prior);
            j -= 1;
        }
        list.set(j, current);
        k += 1;
    }
}

// ---------------------------------------------------------------------------
// Markdown
// ---------------------------------------------------------------------------

fn add_toc_heading(inout eng: ast.Engine, borrow heading: metadata.Heading, inout values: value.U64s) {
    let mut fields = value.Entries.new();
    put(inout fields, eng.key("id"), eng.arena.string(borrow heading.id));
    put(inout fields, eng.key("title"), eng.arena.string(borrow heading.title));
    put(inout fields, eng.key("level"), eng.arena.integer(heading.level));
    put(inout fields, eng.key("permalink"), eng.arena.string(borrow heading.permalink));
    values.push(eng.arena.map(borrow fields));
}

fn metadata_toc(inout eng: ast.Engine, borrow doc: metadata.Document) -> u64 {
    let mut values = value.U64s.new();
    let mut i: u64 = 0;
    while i < doc.headings.len() {
        if doc.headings.get_ref(i).id.len() > 0 {
            add_toc_heading(inout eng, borrow doc.headings.get_ref(i), inout values);
        }
        i += 1;
    }
    eng.arena.array(borrow values)
}

// Render every page's body once. Section index templates show their pages'
// summaries, so every body must be rendered before any template runs.
fn render_bodies(inout site: Site, inout eng: ast.Engine) {
    let mut i: u64 = 0;
    while i < site.pages.len() {
        let mut page = site.page_at(i);
        let permalink = eng.arena.strings.copy(page.permalink);
        let url_value = eng.arena.string(borrow permalink);
        eng.set_global(site.keys.page_url_global, url_value);

        let source = eng.arena.strings.copy(page.source);
        let source_path = join_path(borrow site.content_root, borrow eng.arena.strings.copy(page.rel));
        eng.set_source(borrow source_path);
        let expanded = markdown.expand_shortcodes(
            inout eng, borrow source, page.body_start, page.body_line,
        );
        // A shortcode evaluates a template and can leave the evaluator's
        // source set to that template. Markdown diagnostics belong to the
        // content file that contains the shortcode, so restore it at the
        // boundary between the two passes.
        eng.set_source(borrow source_path);
        let doc = markdown.render(inout eng, borrow expanded, page.body_line);
        page.content = eng.arena.string(borrow doc.html);
        if site.content_metadata || site.search_index {
            let rendered_metadata = metadata.scan(borrow doc.html, borrow permalink);
            page.plain_text = eng.arena.string(borrow rendered_metadata.plain_text);
            page.search_body = eng.arena.string(borrow rendered_metadata.page_body);
            page.toc = metadata_toc(inout eng, borrow rendered_metadata);
            site.heading_meta.push(rendered_metadata.headings);
        } else {
            site.heading_meta.push(metadata.Headings.new());
        }
        // Zola's `page.summary` exists only when the body carries a
        // `<!-- more -->` marker; the templates gate on its presence, so a
        // whole-body fallback would print every post in full on the index.
        if doc.summary_end < doc.html.len() {
            let cut = text.slice(borrow doc.html, 0, doc.summary_end);
            page.summary = eng.arena.string(borrow cut);
        } else {
            page.summary = eng.arena.null();
        }
        site.pages.set(i, page);
        i += 1;
    }
}

// ---------------------------------------------------------------------------
// Template-visible objects
// ---------------------------------------------------------------------------

fn copy_front(inout eng: ast.Engine, front: u64, inout fields: value.Entries) {
    let mut i: u64 = 0;
    while i < eng.arena.length(front) {
        fields.push(eng.arena.entry_at(front, i));
        i += 1;
    }
}

fn put(inout fields: value.Entries, key: u64, v: u64) {
    fields.push(value.Entry { key: key, value: v });
}

// The lightweight object a page presents to OTHER pages: what a section index,
// a feed entry, and a prev/next link read. It deliberately carries no `lower`,
// `higher`, or `content`, which is also what keeps the object graph finite —
// a page's neighbour holding the page holding the neighbour has no end.
fn build_entry(inout site: Site, inout eng: ast.Engine, index: u64) -> u64 {
    let page = site.page_at(index);
    let mut fields = value.Entries.new();
    copy_front(inout eng, page.front, inout fields);
    let permalink = eng.arena.string_id(page.permalink);
    put(inout fields, site.keys.permalink, permalink);
    let route = eng.arena.strings.copy(page.route);
    let mut path = StrBuf.new();
    path.push(47);
    path.append_borrowed(borrow route);
    let path_value = eng.arena.string(borrow path);
    put(inout fields, site.keys.path, path_value);
    put(inout fields, site.keys.summary, page.summary);
    if page.plain_text != NONE() {
        put(inout fields, site.keys.plain_text, page.plain_text);
        put(inout fields, site.keys.toc, page.toc);
    }
    eng.arena.map(borrow fields)
}

// The object bound as `page` while its own template renders: everything the
// entry has, plus the rendered body and the ordered neighbours.
fn build_object(inout site: Site, inout eng: ast.Engine, index: u64, lower: u64, higher: u64) -> u64 {
    let page = site.page_at(index);
    let mut fields = value.Entries.new();
    copy_front(inout eng, page.front, inout fields);
    let permalink = eng.arena.string_id(page.permalink);
    put(inout fields, site.keys.permalink, permalink);
    let route = eng.arena.strings.copy(page.route);
    let mut path = StrBuf.new();
    path.push(47);
    path.append_borrowed(borrow route);
    let path_value = eng.arena.string(borrow path);
    put(inout fields, site.keys.path, path_value);
    put(inout fields, site.keys.summary, page.summary);
    put(inout fields, site.keys.content, page.content);
    if page.plain_text != NONE() {
        put(inout fields, site.keys.plain_text, page.plain_text);
        put(inout fields, site.keys.toc, page.toc);
    }
    put(inout fields, site.keys.lower, lower);
    put(inout fields, site.keys.higher, higher);
    eng.arena.map(borrow fields)
}

// Build every page entry, then every page object, then every section object,
// then the `__sections` map `get_section` reads. The order is forced: an entry
// is an input to the section that lists it, and a section object is an input
// to the navigation macro that walks it.
fn build_objects(inout site: Site, inout eng: ast.Engine) {
    let mut i: u64 = 0;
    while i < site.pages.len() {
        let mut page = site.page_at(i);
        page.entry = build_entry(inout site, inout eng, i);
        site.pages.set(i, page);
        i += 1;
    }

    let mut s: u64 = 0;
    while s < site.sections.len() {
        let section = site.section_at(s);
        let mut k: u64 = 0;
        while k < section.page_count {
            let index = site.section_pages.get_or(section.page_start + k, NONE());
            let lower = if k == 0 {
                eng.arena.null()
            } else {
                let before = site.section_pages.get_or(section.page_start + k - 1, NONE());
                site.page_at(before).entry
            };
            let higher = if k + 1 == section.page_count {
                eng.arena.null()
            } else {
                let after = site.section_pages.get_or(section.page_start + k + 1, NONE());
                site.page_at(after).entry
            };
            let mut page = site.page_at(index);
            page.object = build_object(inout site, inout eng, index, lower, higher);
            site.pages.set(index, page);
            k += 1;
        }
        s += 1;
    }

    let mut sections_map = value.Entries.new();
    let mut t: u64 = 0;
    while t < site.sections.len() {
        let mut section = site.section_at(t);
        section.object = build_section_object(borrow site, inout eng, t);
        let key = section.key;
        let object = section.object;
        site.sections.set(t, section);
        put(inout sections_map, key, object);
        t += 1;
    }
    let sections_value = eng.arena.map(borrow sections_map);
    eng.set_global(site.keys.sections_global, sections_value);
}

// Resolve `@/…` links against the routes discovered from front matter before
// Markdown expands them. This map must exist before render_bodies: generated
// error bundles use explicit uppercase routes, and falling back to slugifying
// their source path would produce a different URL.
fn build_routes(inout site: Site, inout eng: ast.Engine) {
    let mut routes_map = value.Entries.new();
    let mut r: u64 = 0;
    while r < site.pages.len() {
        let page = site.page_at(r);
        let key = eng.arena.strings.intern(borrow eng.arena.strings.copy(page.rel));
        routes_map.push(value.Entry { key: key, value: eng.arena.string_id(page.route) });
        r += 1;
    }
    eng.set_global(site.keys.routes_global, eng.arena.map(borrow routes_map));
}

fn build_section_object(borrow site: Site, inout eng: ast.Engine, index: u64) -> u64 {
    let section = site.section_at(index);
    let page = site.page_at(section.page);
    let mut fields = value.Entries.new();
    copy_front(inout eng, page.front, inout fields);
    let permalink = eng.arena.string_id(page.permalink);
    put(inout fields, site.keys.permalink, permalink);
    let route = eng.arena.strings.copy(page.route);
    let mut path = StrBuf.new();
    path.push(47);
    path.append_borrowed(borrow route);
    let path_value = eng.arena.string(borrow path);
    put(inout fields, site.keys.path, path_value);
    put(inout fields, site.keys.content, page.content);
    if page.plain_text != NONE() {
        put(inout fields, site.keys.plain_text, page.plain_text);
        put(inout fields, site.keys.toc, page.toc);
    }

    let mut listed = value.U64s.new();
    let mut k: u64 = 0;
    while k < section.page_count {
        let child = site.section_pages.get_or(section.page_start + k, NONE());
        listed.push(site.page_at(child).entry);
        k += 1;
    }
    let pages_value = eng.arena.array(borrow listed);
    put(inout fields, site.keys.pages, pages_value);

    // Subsections are content PATHS, not objects, exactly as Zola presents
    // them: the production sidebar reads `section.subsections | sort` and
    // resolves each one with `get_section`, and the port keeps that shape so
    // the same lookup work happens in both tools.
    let mut subs = value.U64s.new();
    let mut j: u64 = 0;
    while j < section.sub_count {
        let child = site.section_subs.get_or(section.sub_start + j, NONE());
        let key = site.section_at(child).key;
        subs.push(eng.arena.string_id(key));
        j += 1;
    }
    let subs_value = eng.arena.array(borrow subs);
    put(inout fields, site.keys.subsections, subs_value);
    eng.arena.map(borrow fields)
}

// ---------------------------------------------------------------------------
// Output
// ---------------------------------------------------------------------------

fn output_path(borrow site: Site, borrow eng: ast.Engine, route_id: u64, name: StrBuf) -> StrBuf {
    let route = eng.arena.strings.copy(route_id);
    let mut path = join_path(borrow site.output_root, borrow route);
    if path.len() > 0 && text.byte_of(borrow path, path.len() - 1) != 47 { path.push(47); }
    path.push_str(name);
    path
}

fn render_named(inout site: Site, inout eng: ast.Engine, name: u64, route: u64, file: StrBuf) -> bool {
    // Pagination renders the same section at distinct routes. Expose the
    // actual emitted URL independently of the section's canonical identity.
    let mut current_route = eng.arena.strings.copy(route);
    if !StrBuf.equals_borrowed(borrow file, borrow "index.html") {
        if current_route.len() > 0 && !current_route.ends_with(borrow "/") { current_route.push(47); }
        current_route.append_borrowed(borrow file);
    }
    let current_url = tmpl_eval.join_base(inout eng, borrow current_route);
    eng.set_global(eng.key("current_url"), eng.arena.string(borrow current_url));
    let mut out = StrBuf.new();
    if !tmpl_eval.render(inout eng, name, inout out) { return false; }
    // Only when listing: this runs once per emitted file, and an unconditional
    // copy would be an allocation the measured build pays nine thousand times
    // for a flag it was not given.
    let listed = if site.list { file.clone() } else { StrBuf.new() };
    let final_out = if site.minify_html && file.ends_with(borrow ".html") { minify_html(borrow out) } else { out };
    let path = output_path(borrow site, borrow eng, route, file);
    if !write_output(borrow path, borrow final_out) {
        let subject = eng.arena.strings.intern(borrow path);
        fail(inout eng, "cannot write an output file", subject);
        return false;
    }
    site.files_written += 1;
    if site.list {
        let route_text = eng.arena.strings.copy(route);
        site.listing.append_borrowed(borrow route_text);
        site.listing.push_str(listed);
        site.listing.push_str("\n");
    }
    true
}

// A page's template: its own `template`, else its section's `page_template`,
// else `page.html`. A section's is its own `template`, else `section.html`.
fn template_for(inout site: Site, inout eng: ast.Engine, index: u64) -> u64 {
    let page = site.page_at(index);
    let own = eng.arena.map_get(page.front, site.keys.template);
    if eng.arena.tag(own) == value.V_STR() { return eng.arena.at(own).num; }
    if page.is_index { return eng.key("section.html"); }
    if page.section != NONE() {
        let owner = site.section_at(page.section);
        let owner_page = site.page_at(owner.page);
        let inherited = eng.arena.map_get(owner_page.front, site.keys.page_template);
        if eng.arena.tag(inherited) == value.V_STR() { return eng.arena.at(inherited).num; }
    }
    eng.key("page.html")
}

fn bind_page(inout site: Site, inout eng: ast.Engine, page_value: u64, section_value: u64, url: u64) {
    eng.set_global(site.keys.page, page_value);
    eng.set_global(site.keys.section, section_value);
    eng.set_global(site.keys.page_url_global, url);
}

fn page_route_id(inout eng: ast.Engine, route: u64, number: u64) -> u64 {
    let mut text_route = eng.arena.strings.copy(route);
    if text_route.len() > 0 && text.byte_of(borrow text_route, text_route.len() - 1) != 47 { text_route.push(47); }
    text_route.push_str("page/"); text_route.push_str(text.decimal(number)); text_route.push(47);
    eng.arena.strings.intern(borrow text_route)
}

fn absolute_route(inout eng: ast.Engine, route: u64) -> u64 {
    let relative = eng.arena.strings.copy(route);
    let absolute = tmpl_eval.join_base(inout eng, borrow relative);
    eng.arena.string(borrow absolute)
}

fn build_paginator(inout site: Site, inout eng: ast.Engine, borrow section: Section, number: u64) -> u64 {
    let limit = section.paginate_by;
    let total = if limit == 0 || section.page_count == 0 { 1 } else { (section.page_count + limit - 1) / limit };
    let start = number * limit;
    let stop = if start + limit < section.page_count { start + limit } else { section.page_count };
    let mut listed = value.U64s.new();
    let mut i = start;
    while i < stop { listed.push(site.page_at(site.section_pages.get_or(section.page_start + i, NONE())).entry); i += 1; }
    let mut fields = value.Entries.new();
    fields.push(value.Entry { key: site.keys.pages, value: eng.arena.array(borrow listed) });
    let previous = if number == 0 { eng.arena.null() } else if number == 1 {
        eng.arena.string_id(site.page_at(section.page).permalink)
    } else { absolute_route(inout eng, page_route_id(inout eng, site.page_at(section.page).route, number)) };
    let next = if number + 1 >= total { eng.arena.null() } else {
        absolute_route(inout eng, page_route_id(inout eng, site.page_at(section.page).route, number + 2))
    };
    fields.push(value.Entry { key: site.keys.previous, value: previous });
    fields.push(value.Entry { key: site.keys.next, value: next });
    eng.arena.map(borrow fields)
}

// Render every page and every section index, then every feed.
fn emit(inout site: Site, inout eng: ast.Engine) -> bool {
    let mut ok = true;
    let null = eng.arena.null();

    let mut i: u64 = 0;
    while i < site.pages.len() {
        let page = site.page_at(i);
        if !page.is_index {
            let name = template_for(inout site, inout eng, i);
            if eng.find_template(name) == NONE() {
                fail(inout eng, "a page names a template the site does not have", name);
                ok = false;
            } else {
                let url = eng.arena.string_id(page.permalink);
                bind_page(inout site, inout eng, page.object, null, url);
                if !render_named(inout site, inout eng, name, page.route, "index.html") { ok = false; }
                site.pages_rendered += 1;
            }
        }
        i += 1;
    }

    let mut s: u64 = 0;
    while s < site.sections.len() {
        let section = site.section_at(s);
        let page = site.page_at(section.page);
        let url = eng.arena.string_id(page.permalink);
        if section.redirect_to != NONE() {
            if !emit_redirect(inout site, inout eng, s) { ok = false; }
        } else {
            let name = template_for(inout site, inout eng, section.page);
            if eng.find_template(name) == NONE() {
                fail(inout eng, "a section names a template the site does not have", name);
                ok = false;
            } else if section.paginate_by == NONE() {
                bind_page(inout site, inout eng, null, section.object, url);
                if !render_named(inout site, inout eng, name, page.route, "index.html") { ok = false; }
            } else {
                let limit = section.paginate_by;
                let total = if limit == 0 || section.page_count == 0 { 1 } else { (section.page_count + limit - 1) / limit };
                let mut number: u64 = 0;
                while number < total {
                    let paginator = build_paginator(inout site, inout eng, borrow section, number);
                    eng.push_scope(); eng.bind(site.keys.paginator, paginator);
                    bind_page(inout site, inout eng, null, section.object, url);
                    let route = if number == 0 { page.route } else { page_route_id(inout eng, page.route, number + 1) };
                    if !render_named(inout site, inout eng, name, route, "index.html") { ok = false; }
                    eng.pop_scope();
                    number += 1;
                }
                let target = eng.arena.strings.copy(page.permalink);
                if !emit_page_one_redirect(inout site, inout eng, page.route, borrow target) { ok = false; }
            }
        }
        if section.generate_feeds {
            if !emit_feed(inout site, inout eng, s) { ok = false; }
        }
        s += 1;
    }
    ok
}

fn emit_page_one_redirect(inout site: Site, inout eng: ast.Engine, route: u64, borrow target: StrBuf) -> bool {
    let mut route_text = eng.arena.strings.copy(route);
    if route_text.len() > 0 && text.byte_of(borrow route_text, route_text.len() - 1) != 47 { route_text.push(47); }
    route_text.push_str("page/1/");
    let page_route = eng.arena.strings.intern(borrow route_text);
    let mut body = StrBuf.new();
    body.push_str("<!doctype html><meta http-equiv=\"refresh\" content=\"0; url=");
    text.append_escaped_html(borrow target, inout body);
    body.push_str("\"><link rel=\"canonical\" href=\"");
    text.append_escaped_html(borrow target, inout body); body.push_str("\">");
    let path = output_path(borrow site, borrow eng, page_route, "index.html");
    if !write_output(borrow path, borrow body) { return false; }
    site.files_written += 1;
    if site.list { site.listing.append_borrowed(borrow route_text); site.listing.push_str("index.html\n"); }
    true
}

// A `redirect_to` section emits Zola's redirect stub in place of its own index
// page, and its pages and subsections still render.
//
// ADR-0072 left this undecided and RUE-1483 neither honoured nor rejected it,
// which made `spec/_index.md` the one page the corpus differential had to
// exclude. Honouring it is the choice that keeps the emitted FILE SET equal to
// Zola's, which is Decision 4's cross-tool criterion: refusing the key would
// leave gazette one output file short of every peer, and rendering the section
// normally would put a page at a route Zola serves a redirect from. The stub's
// markup is the port's `redirect.html`, so the decision is visible in a
// template rather than buried in host code, and the URL resolves through the
// same `@/…`-aware join every other link uses.
fn emit_redirect(inout site: Site, inout eng: ast.Engine, index: u64) -> bool {
    let section = site.section_at(index);
    let page = site.page_at(section.page);
    let name = eng.key("redirect.html");
    if eng.find_template(name) == NONE() {
        let target = eng.arena.strings.copy(section.redirect_to);
        let mut resolved = tmpl_eval.join_base(inout eng, borrow target);
        if resolved.len() > 0 && text.byte_of(borrow resolved, resolved.len() - 1) != 47 { resolved.push(47); }
        let mut body = StrBuf.new(); body.push_str("<!doctype html><meta http-equiv=\"refresh\" content=\"0; url=");
        text.append_escaped_html(borrow resolved, inout body); body.push_str("\"><link rel=\"canonical\" href=\"");
        text.append_escaped_html(borrow resolved, inout body); body.push_str("\">");
        let path = output_path(borrow site, borrow eng, page.route, "index.html");
        if !write_output(borrow path, borrow body) { return false; }
        site.files_written += 1;
        if site.list { site.listing.append_borrowed(borrow eng.arena.strings.copy(page.route)); site.listing.push_str("index.html\n"); }
        return true;
    }
    let target = eng.arena.strings.copy(section.redirect_to);
    let mut resolved = tmpl_eval.join_base(inout eng, borrow target);
    if resolved.len() > 0 && text.byte_of(borrow resolved, resolved.len() - 1) != 47 { resolved.push(47); }
    let url_value = eng.arena.string(borrow resolved);
    eng.push_scope();
    eng.bind(site.keys.url, url_value);
    let rendered = render_named(inout site, inout eng, name, page.route, "index.html");
    eng.pop_scope();
    rendered
}

// Root and section feeds share selection, ordering, template context and RSS
// serialization. An optional rss.xml template replaces only presentation.
fn emit_feed(inout site: Site, inout eng: ast.Engine, index: u64) -> bool {
    let mut selected = value.U64s.new();
    let mut i: u64 = 0;
    while i < site.pages.len() {
        let page = site.page_at(i);
        let belongs = index == NONE() || page.section == index;
        let date = eng.arena.map_get(page.front, site.keys.date);
        if belongs && !page.is_index && eng.arena.tag(date) == value.V_STR() {
            selected.push(i);
        }
        i += 1;
    }
    let mut k: u64 = 1;
    while k < selected.len() {
        let current = selected.get_or(k, 0);
        let mut j = k;
        while j > 0 {
            let prior = selected.get_or(j - 1, 0);
            let a = site.page_at(current); let b = site.page_at(prior);
            let da = eng.arena.scalar_id(eng.arena.map_get(a.front, site.keys.date));
            let db = eng.arena.scalar_id(eng.arena.map_get(b.front, site.keys.date));
            let order = eng.arena.strings.compare(da, db);
            if order == 0 || (order == 1 && eng.arena.strings.compare(a.rel, b.rel) != 0) { break; }
            selected.set(j, prior); j -= 1;
        }
        selected.set(j, current); k += 1;
    }
    let root = index == NONE();
    let route = if root { eng.key("") } else { site.page_at(site.section_at(index).page).route };
    let url = absolute_route(inout eng, route);
    let section_value = if root { eng.arena.null() } else { site.section_at(index).object };
    let name = eng.key("rss.xml");
    if eng.find_template(name) != NONE() {
        let mut listed = value.U64s.new(); i = 0;
        while i < selected.len() { listed.push(site.page_at(selected.get_or(i, 0)).entry); i += 1; }
        let pages_value = eng.arena.array(borrow listed);
        let feed_url = output_feed_url(borrow site, inout eng, route);
        bind_page(inout site, inout eng, eng.arena.null(), section_value, url);
        eng.push_scope();
        eng.bind(site.keys.pages, pages_value); eng.bind(site.keys.feed_url, feed_url);
        let rendered = render_named(inout site, inout eng, name, route, "rss.xml");
        eng.pop_scope();
        return rendered;
    }
    let mut out = StrBuf.new();
    out.push_str("<?xml version=\"1.0\" encoding=\"utf-8\"?><rss version=\"2.0\"><channel><title>");
    xml_escape(borrow eng.arena.scalar(eng.arena.map_get(site.config, site.keys.title)), inout out);
    if !root {
        out.push_str(" - ");
        let front = site.page_at(site.section_at(index).page).front;
        xml_escape(borrow eng.arena.scalar(eng.arena.map_get(front, site.keys.title)), inout out);
    }
    out.push_str("</title><description>");
    xml_escape(borrow eng.arena.scalar(eng.arena.map_get(site.config, site.keys.description)), inout out);
    out.push_str("</description><link>"); xml_escape(borrow eng.arena.scalar(url), inout out); out.push_str("</link>");
    i = 0;
    while i < selected.len() {
        let page = site.page_at(selected.get_or(i, 0));
        out.push_str("<item><title>"); xml_escape(borrow eng.arena.scalar(eng.arena.map_get(page.front, site.keys.title)), inout out);
        out.push_str("</title><link>"); xml_escape(borrow eng.arena.strings.copy(page.permalink), inout out);
        out.push_str("</link><guid>"); xml_escape(borrow eng.arena.strings.copy(page.permalink), inout out);
        out.push_str("</guid><pubDate>");
        let date = rss_date(borrow eng.arena.scalar(eng.arena.map_get(page.front, site.keys.date)));
        xml_escape(borrow date, inout out); out.push_str("</pubDate><description>");
        let content = if eng.arena.is_null(page.summary) { page.content } else { page.summary };
        xml_escape(borrow eng.arena.scalar(content), inout out); out.push_str("</description></item>");
        i += 1;
    }
    out.push_str("</channel></rss>");
    if !write_output(borrow output_path(borrow site, borrow eng, route, "rss.xml"), borrow out) { return false; }
    site.files_written += 1;
    if site.list { site.listing.append_borrowed(borrow eng.arena.strings.copy(route)); site.listing.push_str("rss.xml\n"); }
    true
}

fn xml_escape(borrow source: StrBuf, inout out: StrBuf) {
    let mut i: u64 = 0;
    while i < source.len() {
        let b = text.byte_of(borrow source, i);
        if b == 38 { out.push_str("&amp;"); }
        else if b == 60 { out.push_str("&lt;"); }
        else if b == 62 { out.push_str("&gt;"); }
        else { out.push(b); }
        i += 1;
    }
}

// RSS dates use RFC 2822's textual form. Content front matter commonly uses
// the site's ISO date spelling, so normalize that spelling at the feed edge
// while leaving the stored value untouched for sorting and templates.
fn rss_date(borrow source: StrBuf) -> StrBuf {
    if source.len() < 10 { return source.clone(); }
    let mut year: u64 = 0; let mut month: u64 = 0; let mut day: u64 = 0;
    let mut i: u64 = 0;
    while i < 4 { year = year * 10 + @intCast(text.byte_of(borrow source, i) - 48); i += 1; }
    i = 5; while i < 7 { month = month * 10 + @intCast(text.byte_of(borrow source, i) - 48); i += 1; }
    i = 8; while i < 10 { day = day * 10 + @intCast(text.byte_of(borrow source, i) - 48); i += 1; }
    let month_name = if month == 1 { "Jan" } else if month == 2 { "Feb" } else if month == 3 { "Mar" }
        else if month == 4 { "Apr" } else if month == 5 { "May" } else if month == 6 { "Jun" }
        else if month == 7 { "Jul" } else if month == 8 { "Aug" } else if month == 9 { "Sep" }
        else if month == 10 { "Oct" } else if month == 11 { "Nov" } else if month == 12 { "Dec" } else { "Jan" };
    let offset = if month == 1 { 0 } else if month == 2 { 3 } else if month == 3 { 2 }
        else if month == 4 { 5 } else if month == 5 { 0 } else if month == 6 { 3 }
        else if month == 7 { 5 } else if month == 8 { 1 } else if month == 9 { 4 }
        else if month == 10 { 6 } else if month == 11 { 2 } else { 4 };
    let adjusted_year = if month < 3 { year - 1 } else { year };
    let weekday = (adjusted_year + adjusted_year / 4 - adjusted_year / 100 + adjusted_year / 400 + offset + day) % 7;
    let weekday_name = if weekday == 0 { "Sun" } else if weekday == 1 { "Mon" } else if weekday == 2 { "Tue" }
        else if weekday == 3 { "Wed" } else if weekday == 4 { "Thu" } else if weekday == 5 { "Fri" } else { "Sat" };
    let mut out = StrBuf.new(); out.push_str(weekday_name); out.push_str(", ");
    if day < 10 { out.push(48); } out.push_str(text.decimal(day)); out.push(32);
    out.push_str(month_name); out.push(32); out.push_str(text.decimal(year));
    out.push_str(" 00:00:00 +0000"); out
}


fn output_feed_url(borrow site: Site, inout eng: ast.Engine, route_id: u64) -> u64 {
    let route = eng.arena.strings.copy(route_id);
    let mut rel = text.slice(borrow route, 0, route.len());
    rel.push_str("rss.xml");
    let resolved = tmpl_eval.join_base(inout eng, borrow rel);
    eng.arena.string(borrow resolved)
}

// ---------------------------------------------------------------------------
// Static passthrough
// ---------------------------------------------------------------------------

// Copy `static/` into the output root. This is measured work for every tool in
// ADR-0072's comparison and its inputs are part of the recorded fixture
// identity, so it happens inside the build rather than in the harness around
// it.
//
// A site may legitimately have no `static/` directory, so `NotFound` is
// success — but ONLY `NotFound`. An unreadable one is a failure, and the
// distinction matters more here than the shrug it replaced suggests: static
// passthrough is measured work, so a permission or I/O error that returned
// "nothing to copy" would produce a fast build missing a megabyte of output,
// which is precisely the wrong-but-fast result Decision 4 exists to refuse.
fn copy_static(inout site: Site, inout eng: ast.Engine) -> bool {
    let root = join_path(borrow site.root, borrow "static");
    let entries = match std.fs.walk(borrow root) {
        DirRes.Ok(list) => list,
        DirRes.Err(e) => {
            match e {
                std.fs.FileError.NotFound => { return true; },
                _ => {},
            }
            let subject = eng.arena.strings.intern(borrow root);
            fail(inout eng, "the static directory exists but cannot be read", subject);
            return false;
        },
    };
    let prefix = root.len() + 1;
    let mut ok = true;
    let mut i: u64 = 0;
    while i < entries.len() {
        if entries.is_file(i) {
            let path = entries.path(i);
            let rel = text.slice(borrow path, prefix, path.len());
            let target = join_path(borrow site.output_root, borrow rel);
            if !copy_one(borrow path, borrow target) {
                let subject = eng.arena.strings.intern(borrow rel);
                fail(inout eng, "cannot copy a static asset", subject);
                ok = false;
            } else {
                site.files_written += 1;
                if site.list {
                    site.listing.append_borrowed(borrow rel);
                    site.listing.push_str("\n");
                }
            }
        }
        i += 1;
    }
    ok
}

fn emit_heading_search_docs(
    inout documents: std.arraybuf.ArrayBuf(std.json.Json),
    borrow headings: metadata.Headings,
    borrow page_url: StrBuf,
    borrow page_title: StrBuf,
    borrow description: StrBuf,
) {
    // A heading owns its strings, so keep the accessor result borrowed for the
    // whole record construction instead of copying the struct out.
    let mut h: u64 = 0;
    while h < headings.len() {
        emit_one_heading_search_doc(inout documents, borrow headings.get_ref(h), borrow page_url, borrow page_title, borrow description);
        h += 1;
    }
}

fn emit_one_heading_search_doc(
    inout documents: std.arraybuf.ArrayBuf(std.json.Json),
    borrow heading: metadata.Heading,
    borrow page_url: StrBuf,
    borrow page_title: StrBuf,
    borrow description: StrBuf,
) {
        if heading.id.len() > 0 {
            let mut hk = std.arraybuf.ArrayBuf(StrBuf).new();
            let mut hv = std.arraybuf.ArrayBuf(std.json.Json).new();
            hk.push("ref"); hv.push(std.json.Json.String(heading.permalink.clone()));
            hk.push("page_ref"); hv.push(std.json.Json.String(page_url.clone()));
            hk.push("title"); hv.push(std.json.Json.String(page_title.clone()));
            hk.push("heading"); hv.push(std.json.Json.String(heading.title.clone()));
            hk.push("description"); hv.push(std.json.Json.String(description.clone()));
            hk.push("path"); hv.push(std.json.Json.String(heading.permalink.clone()));
            hk.push("body"); hv.push(std.json.Json.String(heading.body.clone()));
            documents.push(std.json.Json.Object(std.json.Object { keys: hk, values: hv }));
        }
}

fn emit_search_index(inout site: Site, inout eng: ast.Engine) -> bool {
    let mut documents = std.arraybuf.ArrayBuf(std.json.Json).new();
    let mut i: u64 = 0;
    while i < site.pages.len() {
        let page = site.page_at(i);
        // Redirects carry no searchable document, matching the rendered site.
        if eng.arena.map_get(page.front, site.keys.redirect_to) == NONE() {
            let mut keys = std.arraybuf.ArrayBuf(StrBuf).new();
            let mut values = std.arraybuf.ArrayBuf(std.json.Json).new();
            keys.push("ref"); values.push(std.json.Json.String(eng.arena.strings.copy(page.permalink)));
            keys.push("page_ref"); values.push(std.json.Json.String(eng.arena.strings.copy(page.permalink)));
            keys.push("title"); values.push(std.json.Json.String(eng.arena.scalar(eng.arena.map_get(page.front, site.keys.title))));
            keys.push("heading"); values.push(std.json.Json.String(StrBuf.new()));
            keys.push("description"); values.push(std.json.Json.String(eng.arena.scalar(eng.arena.map_get(page.front, site.keys.description))));
            keys.push("path"); values.push(std.json.Json.String(eng.arena.strings.copy(page.permalink)));
            keys.push("body"); values.push(std.json.Json.String(eng.arena.scalar(page.search_body)));
            documents.push(std.json.Json.Object(std.json.Object { keys: keys, values: values }));

            let page_url = eng.arena.strings.copy(page.permalink);
            let page_title = eng.arena.scalar(eng.arena.map_get(page.front, site.keys.title));
            let description = eng.arena.scalar(eng.arena.map_get(page.front, site.keys.description));
            emit_heading_search_docs(
                inout documents, borrow site.heading_meta.get_ref(i), borrow page_url,
                borrow page_title, borrow description,
            );
        }
        i += 1;
    }
    let mut keys = std.arraybuf.ArrayBuf(StrBuf).new(); keys.push("format_version"); keys.push("documents");
    let mut values = std.arraybuf.ArrayBuf(std.json.Json).new(); values.push(std.json.Json.Number("2")); values.push(std.json.Json.Array(documents));
    let out = std.json.to_string(std.json.Json.Object(std.json.Object { keys: keys, values: values }));
    if !write_output(borrow join_path(borrow site.output_root, borrow "search_index.en.json"), borrow out) { return false; }
    site.files_written += 1;
    if site.list { site.listing.push_str("search_index.en.json\n"); }
    true
}

fn emit_metadata(inout site: Site, inout eng: ast.Engine) -> bool {
    let mut sitemap = StrBuf.new();
    sitemap.push_str("<?xml version=\"1.0\" encoding=\"UTF-8\"?><urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">");
    let mut i: u64 = 0;
    while i < site.pages.len() {
        let page = site.page_at(i);
        sitemap.push_str("<url><loc>"); xml_escape(borrow eng.arena.strings.copy(page.permalink), inout sitemap); sitemap.push_str("</loc></url>");
        i += 1;
    }
    let mut s: u64 = 0;
    while s < site.sections.len() {
        let section = site.section_at(s);
        if section.paginate_by != NONE() {
            let limit = section.paginate_by;
            let total = if limit == 0 || section.page_count == 0 { 1 } else { (section.page_count + limit - 1) / limit };
            let mut number: u64 = 1;
            while number <= total {
                let route = page_route_id(inout eng, site.page_at(section.page).route, number);
                let url = absolute_route(inout eng, route);
                sitemap.push_str("<url><loc>"); xml_escape(borrow eng.arena.scalar(url), inout sitemap); sitemap.push_str("</loc></url>");
                number += 1;
            }
        }
        s += 1;
    }
    sitemap.push_str("</urlset>");
    let mut ok = write_output(borrow join_path(borrow site.output_root, borrow "sitemap.xml"), borrow sitemap);
    let mut robots = StrBuf.new(); robots.push_str("User-agent: *\nAllow: /\nSitemap: ");
    robots.append_borrowed(borrow tmpl_eval.join_base(inout eng, borrow "sitemap.xml")); robots.push(10);
    if !write_output(borrow join_path(borrow site.output_root, borrow "robots.txt"), borrow robots) { ok = false; }
    let mut notfound = StrBuf.new(); notfound.push_str("<!doctype html><title>Not found</title><h1>Not found</h1>\n");
    if !write_output(borrow join_path(borrow site.output_root, borrow "404.html"), borrow notfound) { ok = false; }
    let empty = StrBuf.new(); if !write_output(borrow join_path(borrow site.output_root, borrow ".nojekyll"), borrow empty) { ok = false; }
    site.files_written += 4;
    if site.list { site.listing.push_str("sitemap.xml\nrobots.txt\n404.html\n.nojekyll\n"); }
    ok
}

fn copy_one(borrow from: StrBuf, borrow to: StrBuf) -> bool {
    let mut raw = Bytes.new();
    let mut source = match std.fs.File.open(borrow from) {
        FileRes.Ok(f) => f,
        FileRes.Err(_e) => { return false; },
    };
    let mut ok = true;
    loop {
        raw.reserve(65536);
        let n = match source.read(inout raw) {
            ReadRes.Ok(k) => k,
            ReadRes.Err(_e) => { ok = false; 0 },
        };
        if n == 0 { break; }
    }
    let _ = source.close();
    if !ok { return false; }

    let parent = dir_of(borrow to);
    if parent.len() > 0 {
        let trimmed = text.slice(borrow parent, 0, parent.len() - 1);
        match std.fs.create_dir_all(borrow trimmed) {
            UnitRes.Ok(_u) => {},
            UnitRes.Err(_e) => { return false; },
        }
    }
    let mut target = match std.fs.File.create(borrow to) {
        FileRes.Ok(f) => f,
        FileRes.Err(_e) => { return false; },
    };
    let wrote = match target.write_all(borrow raw) {
        WriteRes.Ok(_unit) => true,
        WriteRes.Err(_e) => false,
    };
    let _ = target.close();
    wrote
}

// ---------------------------------------------------------------------------
// Driver
// ---------------------------------------------------------------------------

fn source_for_output(borrow site: Site, borrow eng: ast.Engine, borrow path: StrBuf) -> StrBuf {
    let mut i: u64 = 0;
    while i < site.pages.len() {
        let page = site.page_at(i);
        let mut expected = eng.arena.strings.copy(page.route);
        expected.push_str("index.html");
        if StrBuf.equals_borrowed(borrow expected, borrow path) {
            return join_path(borrow site.content_root, borrow eng.arena.strings.copy(page.rel));
        }
        if page.is_index {
            let mut paginated = eng.arena.strings.copy(page.route); paginated.push_str("page/");
            if path.starts_with(borrow paginated) {
                return join_path(borrow site.content_root, borrow eng.arena.strings.copy(page.rel));
            }
        }
        i += 1;
    }
    join_path(borrow site.output_root, borrow path)
}

fn check_output(borrow site: Site, inout eng: ast.Engine, inout report: StrBuf) -> bool {
    let entries = match std.fs.walk(borrow site.output_root) {
        DirRes.Ok(list) => list,
        DirRes.Err(_e) => { fail(inout eng, "cannot inspect generated output", NONE()); return false; },
    };
    let mut files = check.Strings.new();
    let mut documents = check.Documents.new();
    let prefix = site.output_root.len() + if site.output_root.ends_with(borrow "/") { 0 } else { 1 };
    let mut i: u64 = 0;
    while i < entries.len() {
        if entries.is_file(i) {
            let path = entries.path(i);
            let rel = text.slice(borrow path, prefix, path.len());
            files.push(rel.clone());
            if rel.ends_with(borrow ".html") || rel.ends_with(borrow ".svg") {
                let input = read_file(borrow path);
                if !input.ok { fail(inout eng, "cannot read generated output", eng.arena.strings.intern(borrow path)); return false; }
                let doc = metadata.scan(borrow input.data, borrow "");
                let source = source_for_output(borrow site, borrow eng, borrow rel);
                documents.push(check.Document { path: rel, source: source, ids: doc.ids, refs: doc.refs });
            }
        }
        i += 1;
    }
    let base = eng.arena.scalar(eng.lookup(site.keys.base_url_global));
    check.validate(borrow files, borrow documents, borrow base, inout report)
}

// Build the site rooted at `root` into `output`. The stages are ordered by
// their real dependencies and each one refuses to continue past a failure that
// would make the next stage's output meaningless, so a broken site produces
// diagnostics rather than a partial tree that looks like a successful build.
pub fn build(
    inout eng: ast.Engine,
    borrow root: StrBuf,
    borrow output: StrBuf,
    list: bool,
    check_links: bool,
    inout report: StrBuf,
) -> bool {
    let mut site = Site.new();
    site.list = list;
    site.keys = intern_keys(inout eng);
    site.root = text.slice(borrow root, 0, root.len());
    site.content_root = join_path(borrow root, borrow "content");
    site.output_root = text.slice(borrow output, 0, output.len());

    if !load_config(inout site, inout eng) { return false; }
    if !load_templates(inout site, inout eng) { return false; }
    if !discover(inout site, inout eng) || eng.arena.error_count() > 0 { return false; }
    if !build_sections(inout site, inout eng) { return false; }
    order_sections(inout site, inout eng);
    build_routes(inout site, inout eng);
    render_bodies(inout site, inout eng);
    build_objects(inout site, inout eng);
    if eng.arena.error_count() > 0 { return false; }
    let emitted = emit(inout site, inout eng);
    let copied = copy_static(inout site, inout eng);
    let highlighted = emit_highlighting(inout site, inout eng);
    let searched = if site.search_index { emit_search_index(inout site, inout eng) } else { true };
    let global_feed = if site.global_feeds { emit_feed(inout site, inout eng, NONE()) } else { true };
    let metadata = if site.metadata { emit_metadata(inout site, inout eng) } else { true };

    if site.list { report.append_borrowed(borrow site.listing); }
    report.push_str("gazette: ");
    report.push_str(text.decimal(site.pages_rendered));
    report.push_str(" pages, ");
    report.push_str(text.decimal(site.sections.len()));
    report.push_str(" sections, ");
    report.push_str(text.decimal(site.files_written));
    report.push_str(" files written\n");
    let rendered = emitted && copied && highlighted && searched && global_feed && metadata && eng.arena.error_count() == 0;
    if !rendered { return false; }
    if check_links { check_output(borrow site, inout eng, inout report) } else { true }
}
