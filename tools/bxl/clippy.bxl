# tools/bxl/clippy.bxl
# Enhanced clippy BXL script with proper error handling and configurable options

def _collect_rust_targets(ctx, scope_pattern):
    """Collect Rust targets from the given scope pattern."""
    query = "kind('rust_.*', '{}')".format(scope_pattern)
    return ctx.uquery().eval(query)

def _order_targets_by_name(nodes):
    """Order target nodes by their string representation for stable output."""
    by_name = {str(node): node for node in nodes}
    sorted_names = sorted(by_name.keys())
    return [by_name[name] for name in sorted_names]

def _print_target_summary(ctx, nodes, operation):
    """Print a summary of targets being processed."""
    if len(nodes) == 0:
        ctx.output.print("No targets found for {}.".format(operation))
        return False
    
    ctx.output.print("Running {} on {} target(s):".format(operation, len(nodes)))
    for i, node in enumerate(nodes[:5]):  # Show first 5 targets
        ctx.output.print("  {}. {}".format(i + 1, str(node)))
    
    if len(nodes) > 5:
        ctx.output.print("  ... and {} more".format(len(nodes) - 5))
    
    return True

def _find_clippy_targets(ctx, scope):
    """Find clippy targets in the given scope."""
    # Ensure scope has a valid pattern
    if not scope.endswith("...") and not ":" in scope:
        # Add a wildcard to match all targets in the package
        if scope.endswith("/"):
            scope = scope + "..."
        else:
            scope = scope + "/..."
    
    # Simply look for targets named "clippy" in the scope
    all_targets = ctx.uquery().eval(scope)
    clippy_targets = []
    for target in all_targets:
        # Get the target's label and check if it ends with :clippy
        label_str = str(target.label)
        if label_str.endswith(":clippy"):
            clippy_targets.append(target)
    return clippy_targets

def _find_rust_targets_with_clippy(ctx, scope):
    """Find all Rust targets that support clippy in the given scope."""
    rust_targets = _collect_rust_targets(ctx, scope)
    clippy_targets = []
    
    for target in rust_targets:
        # Check if target has a corresponding clippy target
        target_str = str(target)
        clippy_target_str = target_str + ":clippy"
        
        # Use a direct query approach - if it fails, the target doesn't exist
        clippy_result = ctx.uquery().eval(clippy_target_str)
        if clippy_result:
            clippy_targets.extend(clippy_result)
    
    return clippy_targets

def _run_clippy_on_targets(ctx, targets, fail_on_warnings = True):
    """Run clippy on the given targets with error handling."""
    if not targets:
        ctx.output.print("⚠️  No targets to run clippy on.")
        return True
    
    targets = _order_targets_by_name(targets)
    
    ctx.output.print("🔍 Running clippy on {} target(s)...".format(len(targets)))
    
    # Show targets being processed
    for i, target in enumerate(targets[:5]):
        ctx.output.print("  {}. {}".format(i + 1, str(target)))
    if len(targets) > 5:
        ctx.output.print("  ... and {} more".format(len(targets) - 5))
    
    # Build all clippy targets
    result = ctx.build(targets)
    
    # Check for any failures in the build result
    # Note: In real Buck2 BXL, failure handling would be different
    # This is a simplified approach for the example
    
    ctx.output.print("✅ Clippy completed successfully.")
    return True

def _all_impl(ctx):
    """Run clippy on all discovered targets."""
    scope = ctx.cli_args.scope or "//crates/..."
    fail_on_warnings = ctx.cli_args.fail_on_warnings if ctx.cli_args.fail_on_warnings != None else True
    pedantic = ctx.cli_args.pedantic if ctx.cli_args.pedantic != None else False
    
    ctx.output.print("🔍 Discovering clippy targets in scope: {}".format(scope))
    
    if pedantic:
        ctx.output.print("🔍 Running in pedantic mode (additional warnings enabled)")
    
    # Try to find explicit clippy targets first
    clippy_targets = _find_clippy_targets(ctx, scope)
    
    if not clippy_targets:
        ctx.output.print("🔍 No explicit clippy targets found, searching for Rust targets with clippy...")
        clippy_targets = _find_rust_targets_with_clippy(ctx, scope)
    
    if not clippy_targets:
        ctx.output.print("⚠️  No clippy targets found under {}".format(scope))
        ctx.output.print("💡 Make sure your BUCK files define clippy targets for Rust libraries")
        return
    
    success = _run_clippy_on_targets(ctx, clippy_targets, fail_on_warnings)
    
    if not success and fail_on_warnings:
        # Exit with error code
        fail("Clippy found issues that need to be fixed")

def _check_impl(ctx):
    """Check specific targets with clippy."""
    targets = ctx.cli_args.targets
    fail_on_warnings = ctx.cli_args.fail_on_warnings
    
    if not targets:
        ctx.output.print("❌ No targets specified for clippy check")
        ctx.output.print("💡 Usage: buck2 bxl //tools/bxl:clippy.bxl:check --targets //crates/rue:clippy")
        return
    
    # Parse target strings into target nodes
    target_nodes = []
    for target_str in targets:
        nodes = ctx.uquery().eval(target_str)
        if nodes:
            target_nodes.extend(nodes)
        else:
            ctx.output.print("❌ Target not found: '{}'".format(target_str))
    
    success = _run_clippy_on_targets(ctx, target_nodes, fail_on_warnings)
    
    if not success and fail_on_warnings:
        fail("Clippy found issues that need to be fixed")

def _fix_impl(ctx):
    """Run clippy with auto-fix suggestions."""
    ctx.output.print("🔧 Clippy auto-fix mode")
    ctx.output.print("💡 Note: Buck2 clippy targets typically run in check mode.")
    ctx.output.print("💡 For auto-fix, consider running clippy directly with cargo:")
    ctx.output.print("   cargo clippy --fix --allow-dirty --allow-staged")
    
    # Still run the normal clippy check
    scope = ctx.cli_args.scope
    fail_on_warnings = ctx.cli_args.fail_on_warnings
    
    ctx.output.print("🔍 Discovering clippy targets in scope: {}".format(scope))
    
    # Try to find explicit clippy targets first
    clippy_targets = _find_clippy_targets(ctx, scope)
    
    if not clippy_targets:
        ctx.output.print("🔍 No explicit clippy targets found, searching for Rust targets with clippy...")
        clippy_targets = _find_rust_targets_with_clippy(ctx, scope)
    
    if not clippy_targets:
        ctx.output.print("⚠️  No clippy targets found under {}".format(scope))
        ctx.output.print("💡 Make sure your BUCK files define clippy targets for Rust libraries")
        return
    
    success = _run_clippy_on_targets(ctx, clippy_targets, fail_on_warnings)
    
    if not success and fail_on_warnings:
        fail("Clippy found issues that need to be fixed")

# Main entry points
all = bxl_main(
    impl = _all_impl,
    cli_args = {
        "scope": cli_args.option(cli_args.string(), default = "//crates/..."),
        "fail_on_warnings": cli_args.option(cli_args.bool(), default = True),
        "pedantic": cli_args.option(cli_args.bool(), default = False),
    },
)

check = bxl_main(
    impl = _check_impl,
    cli_args = {
        "targets": cli_args.list(cli_args.string()),
        "fail_on_warnings": cli_args.option(cli_args.bool(), default = True),
    },
)

fix = bxl_main(
    impl = _fix_impl,
    cli_args = {
        "scope": cli_args.option(cli_args.string(), default = "//crates/..."),
        "fail_on_warnings": cli_args.option(cli_args.bool(), default = False),
    },
)
