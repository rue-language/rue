load("//crates:defs.bzl", "rue_binary")

rue_binary(
    name = "rue-spec",
    mapped_srcs = {
        "//:spec-route-root": "src/spec-route-root.txt",
        "//:spec-rule-template": "src/spec-rule-template.html",
        "//:website-config": "src/website-config.toml",
    },
    deps = [
        "//crates/rue-error:rue-error",
        "//crates/rue-test-runner:rue-test-runner",
        "//third-party:libtest2-mimic",
        "//third-party:serde",
        "//third-party:serde_json",
        "//third-party:tempfile",
        "//third-party:toml",
    ],
)

# The spec test cases, as an input of the //:spec-tests suite (so a cases/
# edit re-runs exactly that suite under `buck2 test //...`).
filegroup(
    name = "cases",
    srcs = glob(["cases/**"]),
    visibility = ["PUBLIC"],
)

# RUE-1163: the developer entry point. Carrying the corpus's declared inputs as
# `env` here means a filtered run needs no shell to plumb them, and cannot drift
# from what //:spec-tests runs — `./test.sh <pattern>` used to set a different
# (smaller) set by hand.
command_alias(
    name = "spec",
    exe = ":rue-spec",
    env = {
        "RUE_BINARY": "$(exe_target //crates/rue:rue)",
        "RUE_REAL_STD_PATH": "$(location root//:std)/std",
        "RUE_SPEC_CASES": "$(location :cases)/cases",
    },
    visibility = ["PUBLIC"],
)

# Deterministic compiler-error/specification index. All source authorities are
# declared inputs, so Buck cannot serve output produced from a stale corpus.
command_alias(
    name = "machine-index",
    exe = ":rue-spec",
    args = ["--machine-index"],
    env = {
        "RUE_SPEC_CASES": "$(location :cases)/cases",
        "RUE_SPEC_DIR": "$(location root//:spec-docs)/docs/spec/src",
    },
    visibility = ["PUBLIC"],
)
