load("//crates:defs.bzl", "rue_binary")

# tests = False: this binary IS the CLI integration test harness; its sources
# contain no #[test] functions, so a rust_test target would be empty.
rue_binary(
    name = "rue-cli-tests",
    tests = False,
    deps = [
        "//crates/rue-test-runner:rue-test-runner",
        "//third-party:libtest2-mimic",
        "//third-party:serde",
        "//third-party:tempfile",
        "//third-party:toml",
    ],
)

# The CLI integration test cases, as an input of the //:cli-tests suite (so a
# cases/ edit re-runs exactly that suite under `buck2 test //...`).
filegroup(
    name = "cases",
    srcs = glob(["cases/**"]),
    visibility = ["PUBLIC"],
)
