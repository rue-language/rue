load("//crates:defs.bzl", "rue_crate")

# Keep the structural authority guard hermetic while deriving its inventory
# from the same source glob as the crate itself. The manifest is mapped into
# src/ for include_str! in the test binary; it is not a second source list.
genrule(
    name = "rue-air-source-manifest",
    out = "rue_air_source_manifest.txt",
    cmd = "printf '%s\\n' $SRCS > $OUT",
    srcs = glob(["src/**/*.rs"]),
)

rue_crate(
    name = "rue-air",
    mapped_srcs = {
        ":rue-air-source-manifest": "src/rue_air_source_manifest.txt",
    },
    deps = [
        "//third-party:ahash",
        "//crates/rue-builtins:rue-builtins",
        "//crates/rue-error:rue-error",
        "//crates/rue-rir:rue-rir",
        "//crates/rue-runtime-abi:rue-runtime-abi",
        "//crates/rue-span:rue-span",
        "//crates/rue-target:rue-target",
        "//third-party:lasso",
        "//third-party:tracing",
        "//third-party:zmij",
    ],
    test_deps = [
        "//crates/rue-lexer:rue-lexer",
        "//crates/rue-parser:rue-parser",
        "//third-party:syn",
    ],
)

native.rust_library(
    name = "rue-air-fuzz-support",
    crate = "rue_air_fuzz_support",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//third-party:ahash",
        "//crates/rue-builtins:rue-builtins",
        "//crates/rue-error:rue-error",
        "//crates/rue-lexer:rue-lexer",
        "//crates/rue-parser:rue-parser",
        "//crates/rue-rir:rue-rir",
        "//crates/rue-runtime-abi:rue-runtime-abi",
        "//crates/rue-span:rue-span",
        "//crates/rue-target:rue-target",
        "//third-party:lasso",
        "//third-party:rayon",
        "//third-party:tracing",
        "//third-party:zmij",
    ],
    rustc_flags = ["--cfg", "feature=\"fuzz-support\""],

    visibility = ["//crates/rue-compiler:", "//crates/rue-fuzz:"],
)
