load("//crates:defs.bzl", "rue_binary")

_DEPS = [
    "//crates/rue-compiler:rue-compiler",
]

# Timing and peak-memory measurement runner for the RUE-1086 two-dimensional
# scaling corpus. Uses only the public compiler artifact-query API and an
# unmodified global allocator, so its clocks and memory probes never touch the
# counter harness.
rue_binary(
    name = "rue-scaling-bench",
    deps = _DEPS,
    rustc_flags = [
        "--check-cfg=cfg(rue_benchmark_allocations)",
    ],
    tests = False,
)

# Allocation accounting changes the global allocator and is intentionally
# isolated in its own binary, mirroring `//crates/rue:rue-benchmark`.
rue_binary(
    name = "rue-scaling-bench-allocations",
    deps = _DEPS,
    rustc_flags = [
        "--cfg=rue_benchmark_allocations",
        "--check-cfg=cfg(rue_benchmark_allocations)",
    ],
    tests = False,
)
