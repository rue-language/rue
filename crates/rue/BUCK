load("@prelude//rust:cargo_package.bzl", "cargo")
load("//tools/rust:defs.bzl", "clippy_rust_library", "rust_snapshot_tests", "rust_test")

cargo.rust_binary(
    name = "rue",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    edition = "2024",
    env = {
        "RUE_RUNTIME_LIB": "$(location //crates/rue-runtime:rue-runtime-static[staticlib])",
    },
    deps = [
        "//crates/rue-compiler:rue-compiler",
        "//crates/rue-codegen:rue-codegen",
        "//crates/rue-diagnostic:rue-diagnostic",
        "//third-party/rust:anyhow",
        "//third-party/rust:atty",
        "//third-party/rust:bpaf",
        "//third-party/rust:tracing",
    ],
    visibility = ["PUBLIC"],
)

