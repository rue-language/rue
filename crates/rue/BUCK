rust_test(
    name = "snapshot_corpus_tests",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/snapshot_corpus_tests.rs",
    edition = "2024",
    resources = glob([
        "tests/snapshots/corpus/**/*.snap",
    ]),
    deps = [
        "//crates/rue-compiler:rue-compiler",
        "//crates/rue-codegen:rue-codegen",
        "//crates/rue-insta-utils:rue-insta-utils",
        "//crates/rue-parser:rue-parser",
        "//third-party/rust:insta",
        "//third-party/rust:tempfile",
        "//third-party/rust:toml",
        "//third-party/rust:walkdir",
    ],
    env = {
        "CARGO_MANIFEST_DIR": ".",
        "CARGO_BIN_EXE_rue": "$(location :rue)",
        "INSTA_UPDATE": "no",
    },
)

