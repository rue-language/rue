load("//crates:defs.bzl", "rue_binary")

# tests = False: this binary IS the UI test harness; its sources contain no
# #[test] functions, so a rust_test target would be empty.
rue_binary(
    name = "rue-ui-tests",
    tests = False,
    deps = [
        "//crates/rue-test-runner:rue-test-runner",
        "//third-party:libtest2-mimic",
    ],
)
