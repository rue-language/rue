load("//crates:defs.bzl", "rue_crate")
load("//:test_defs.bzl", "rue_rust_test", "rue_sh_test")

# Per-target runtime staticlibs are mapped into src/ so the compiler can embed
# all supported runtimes and select the matching archive at link time.
_RUNTIME_MAPPED_SRCS = {
    "//crates/rue-runtime:rue-runtime-aarch64-apple-darwin": "src/librue_runtime-aarch64-apple-darwin.a",
    "//crates/rue-runtime:rue-runtime-aarch64-unknown-linux-gnu": "src/librue_runtime-aarch64-unknown-linux-gnu.a",
    "//crates/rue-runtime:rue-runtime-x86_64-unknown-linux-gnu": "src/librue_runtime-x86_64-unknown-linux-gnu.a",
}

_DEPS = [
    "//crates/rue-air:rue-air",
    "//crates/rue-builtins:rue-builtins",
    "//crates/rue-cfg:rue-cfg",
    "//crates/rue-codegen:rue-codegen",
    "//crates/rue-error:rue-error",
    "//crates/rue-lexer:rue-lexer",
    "//crates/rue-linker:rue-linker",
    "//crates/rue-parser:rue-parser",
    "//crates/rue-query:rue-query",
    "//crates/rue-rir:rue-rir",
    "//crates/rue-runtime-abi:rue-runtime-abi",
    "//crates/rue-span:rue-span",
    "//crates/rue-target:rue-target",
    "//third-party:ahash",
    "//third-party:annotate-snippets",
    "//third-party:itoa",
    "//third-party:lasso",
    "//third-party:libc",
    "//third-party:sha2",
    "//third-party:serde",
    "//third-party:serde_json",
    "//third-party:tempfile",
    "//third-party:tracing",
]

rue_crate(
    name = "rue-compiler",
    mapped_srcs = _RUNTIME_MAPPED_SRCS,
    deps = _DEPS,
    rustc_flags = [
        "--check-cfg=cfg(test)",
    ],
)

# The compiler's host-only assertions are intentionally a separate scheduled
# unit. It consumes the same compiled test binary but invokes only ignored
# tests whose names carry the platform_native_ filter; the target-independent
# compiler suite therefore remains owned by linux-premerge alone.
rue_sh_test(
    name = "rue-compiler-platform-native-test",
    platform = "native",
    test = ":rue-compiler-test",
    args = ["--ignored", "platform_native_"],
)

# Heavy-matrix scaling targets (Finding 6, RUE-1086). Both wrap the ordinary
# `rue-compiler-test` binary and select the `#[ignore]`d `scaling_matrix_*`
# rows out of it by name.
#
# RUE-1262: this used to be a second `rust_test` compiling the whole crate
# under `--cfg=scaling_matrix`. That made it a strict superset of
# `rue-compiler-test` — 816 tests against 813 — so the premerge lane ran the
# shared 813 twice to gain three, and paid a third full compile of the crate
# to do it. Wrapping one binary is the pattern the stress tier already used,
# and it keeps the matrix rows selectable without a distinct configuration.

# The bounded 100/1k matrix is a required premerge canary.
rue_sh_test(
    name = "scaling-matrix-test",
    args = [
        "--ignored",
        "scaling_matrix",
    ],
    labels = ["rue_dedicated_suite"],
    test = ":rue-compiler-test",
)

# The opt-in 10k-per-axis ladder is intentionally absent from premerge. This
# real stress target uses the same compiler test binary but enables the extreme
# cases explicitly, making their suite ownership visible and reproducible.
rue_sh_test(
    name = "scaling-matrix-stress-test",
    tier = "stress",
    args = [
        "--ignored",
        "scaling_matrix",
        "--nocapture",
    ],
    env = {
        "RUE_SCALING_LARGE": "1",
    },
    labels = ["rue_dedicated_suite"],
    test = ":rue-compiler-test",
)

# Compiles against rue-compiler as an external crate so curated reexports and
# visibility cannot be satisfied accidentally by crate-private test access.
rue_rust_test(
    name = "rue-compiler-public-api-test",
    srcs = ["tests/public_api.rs"],
    crate_root = "tests/public_api.rs",
    deps = [
        ":rue-compiler",
        "//crates/rue-air:rue-air",
        "//crates/rue-error:rue-error",
    ],
)

# Compiler-owned error explanations carry executable examples. This external
# consumer verifies the bounded documented lexer, parser, semantic-foundation,
# struct-foundation, method/item, enum/place, place/borrow, and
# const/item/ownership, single-file destructor/const, slice/string/container,
# and match tranches through the real one-shot compiler path without copying
# the examples into a second fixture. The multi-file E0460 example is validated
# by the compiler unit test.
rue_rust_test(
    name = "error-explanation-examples-test",
    srcs = ["tests/error_explanation_examples.rs"],
    crate_root = "tests/error_explanation_examples.rs",
    deps = [
        ":rue-compiler",
        "//crates/rue-error:rue-error",
    ],
)

# A bounded, deterministic corpus comparing a long-lived session with
# step-matched fresh sessions. Keeping this separate gives local and CI callers
# a focused regression target for incremental correctness.
rue_rust_test(
    name = "rue-compiler-differential-oracle-test",
    srcs = ["tests/differential_oracle.rs"],
    crate_root = "tests/differential_oracle.rs",
    deps = [
        ":rue-compiler",
        "//crates/rue-cfg:rue-cfg",
        "//crates/rue-span:rue-span",
        "//crates/rue-target:rue-target",
        "//third-party:ahash",
        "//third-party:sha2",
    ],
)

# Cross-phase payload-schema verification. This intentionally compiles as an
# external consumer so it can exercise only production publication/query APIs.
rue_rust_test(
    name = "rue-compiler-payload-schema-test",
    srcs = ["tests/payload_schemas.rs"],
    crate_root = "tests/payload_schemas.rs",
    deps = [
        ":rue-compiler",
        "//crates/rue-air:rue-air",
        "//crates/rue-air:rue-air-fuzz-support",
        "//crates/rue-cfg:rue-cfg",
        "//crates/rue-cfg:rue-cfg-fuzz-support",
        "//crates/rue-rir:rue-rir",
        "//crates/rue-rir:rue-rir-fuzz-support",
    ],
)
