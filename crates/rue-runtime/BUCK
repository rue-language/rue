load("@prelude//rust:cargo_package.bzl", "cargo")
load("//tools/rust:defs.bzl", "clippy_rust_library")

# Rust library for runtime functions
cargo.rust_library(
    name = "rue-runtime",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    crate_root = "src/lib.rs",
    preferred_linkage = "static",
    visibility = ["PUBLIC"],
    rustc_flags = [
        "-Cpanic=abort",
        "-Copt-level=2",
        "-Clto=thin",
        "-Ccodegen-units=1",
    ],
)

# Static library version for linking with the Rue compiler
# This builds a staticlib (.a) for linking with Rue executables
cargo.rust_library(
    name = "rue-runtime-static",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    crate_root = "src/lib.rs",
    preferred_linkage = "static",
    visibility = ["PUBLIC"],
    rustc_flags = [
        "-Cpanic=abort",
        "-Copt-level=2",
        "-Clto=thin",
        "-Ccodegen-units=1",
    ],
)

# Clippy version of the library target
clippy_rust_library(
    name = "clippy",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    crate_root = "src/lib.rs",
    preferred_linkage = "static",
    visibility = ["PUBLIC"],
    rustc_flags = [
        "-Cpanic=abort",
        "-Copt-level=2",
        "-Clto=thin",
        "-Ccodegen-units=1",
    ],
)