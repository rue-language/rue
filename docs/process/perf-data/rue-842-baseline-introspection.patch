+    pub fn payload_storage_stats(&self) -> AirPayloadStorageStats {
+        let mut stats = AirPayloadStorageStats {
+            word_store_logical_bytes: self.extra.len() * std::mem::size_of::<u32>(),
+            word_store_capacity_bytes: self.extra.capacity() * std::mem::size_of::<u32>(),
+            projection_store_logical_bytes: self.projections.len() * std::mem::size_of::<AirProjection>(),
+            projection_store_capacity_bytes: self.projections.capacity() * std::mem::size_of::<AirProjection>(),
+            place_store_logical_bytes: self.places.len() * std::mem::size_of::<AirPlace>(),
+            place_store_capacity_bytes: self.places.capacity() * std::mem::size_of::<AirPlace>(),
+            ..AirPayloadStorageStats::default()
+        };
+        let mut account = |family: usize, words: usize| {
+            let bytes = words * std::mem::size_of::<u32>();
+            stats.family_logical_bytes[family] += bytes;
+        };
+        for inst in &self.instructions {
+            match &inst.data {
+                AirInstData::Match { arms_start, arms_len, .. } => {
+                    let words = self.get_match_arms(*arms_start, *arms_len).map(|(pattern, _)| match pattern {
+                        AirPattern::Wildcard => 2,
+                        AirPattern::Bool(_) => 3,
+                        AirPattern::Int(_) | AirPattern::EnumVariant { .. } => 4,
+                    }).sum();
+                    account(0, words);
+                    stats.peak_staging_bytes = stats.peak_staging_bytes.max(words * std::mem::size_of::<u32>());
+                }
+                AirInstData::Call { args_len, .. } => account(1, *args_len as usize * 2),
+                AirInstData::CallGeneric { type_args_len, value_args_len, args_len, .. } => {
+                    account(2, *type_args_len as usize);
+                    account(3, *value_args_len as usize);
+                    stats.peak_staging_bytes = stats.peak_staging_bytes.max(*value_args_len as usize * std::mem::size_of::<u32>());
+                    account(1, *args_len as usize * 2);
+                }
+                AirInstData::Intrinsic { args_len, .. } => account(4, *args_len as usize),
+                AirInstData::Block { stmts_len, .. } => account(5, *stmts_len as usize),
+                AirInstData::StructInit { fields_len, .. } => {
+                    account(6, *fields_len as usize);
+                    account(7, *fields_len as usize);
+                }
+                AirInstData::ArrayInit { elems_len, .. } => account(8, *elems_len as usize),
+                AirInstData::EnumVariant { payload_len, .. } => account(9, *payload_len as usize),
+                _ => {}
+            }
+        }
+        stats.peak_staging_bytes = stats.peak_staging_bytes.max(
+            self.places.iter().map(|place| place.projections_len as usize * std::mem::size_of::<AirProjection>()).max().unwrap_or(0)
+        );
+        stats
+    }
