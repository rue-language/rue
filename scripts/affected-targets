#!/usr/bin/env bash
# Affected-target selection for pull-request CI (RUE-1119, RUE-1130, RUE-1935).
#
# On a pull_request run only the heavy work a change can reach needs to run;
# the merge queue (merge_group) is the only path to trunk and always runs the
# full graph, so under-selection here costs one queue ejection, never a merged
# regression. The decision comes from Meta's Buck Target Determinator (BTD,
# facebookincubator/buck2-change-detector): `buck2 targets` dumps at the
# merge-base and at the head, plus the changed-file list, give an impacted
# closure that this script intersects with what each gated lane executes.
#
# FAIL-OPEN. Every tooling, VCS, Buck, BTD, or parse failure decides `full`, and
# a short out-of-graph list (FORCE_FULL_REGEX) forces a full run for inputs the
# graph cannot see: the dotslash pins, test.sh, the scripts/ci-* runners, this
# script, and the workflow files (RUE-1119).
#
# Subcommands used by ci.yml and the validators:
#   decide                Write the decision to $GITHUB_OUTPUT: `full`,
#                         `selected` (corpus targets), `selected_lanes`,
#                         `narrowed`, and the multiline `impacted` closure.
#   force-full-match      Exit 0 and print the first stdin path forcing a full run.
#   corpus-targets        Corpora owned by a dedicated platform-corpus lane (graph).
#   lanes                 The gated workflow lanes.
#   lane-targets LANE     The targets a gated lane executes.
#   native-targets        Live rue_platform_native targets.
#   clippy-owned-targets  Live rue_ci_clippy_lane targets.
#   scope-targets LANE    A narrowing consumer's unnarrowed live scope.
#   narrow-scope LANE FILE  That scope intersected with an impacted list.
#
# Deliberately not `set -e`: failures are converted into "full" explicitly.
set -uo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
repo_root="$PWD"

_af_cleanup=()
_af_worktrees=()
af_cleanup() {
    local wt path
    for wt in "${_af_worktrees[@]:-}"; do
        [[ -n "$wt" ]] && git worktree remove --force "$wt" >/dev/null 2>&1
    done
    [[ "${#_af_worktrees[@]}" -gt 0 ]] && git worktree prune >/dev/null 2>&1
    for path in "${_af_cleanup[@]:-}"; do
        [[ -n "$path" ]] && rm -rf "$path"
    done
    return 0
}
trap af_cleanup EXIT

# The gated workflow jobs (RUE-1130). `linux-premerge` is absent on purpose: it
# is the broad-discovery lane and the RUE-924 backstop, so it is narrowed to
# the impacted closure rather than skipped wholesale.
SELECTABLE_LANES=(
    clippy
    native-linux-arm64
    native-macos-arm64
    release
    valgrind
    asan
    compiler-reproducibility
    rue-program-digests
)

# Out-of-graph (and belt-and-suspenders in-graph) paths that force a full run.
FORCE_FULL_REGEX='^crates/rue-runtime-asan/|(^|/)BUCK$|\.bzl$|^\.buckconfig|^\.buckroot$|^\.github/workflows/|^toolchains/|^platforms/|^constraints/|^third-party/|^prelude/|^rust-toolchain\.toml$|^buck2$|^buck2-bin$|^reindeer$|^btd$|^test\.sh$|^scripts/ci-|^scripts/affected-targets$|^scripts/install-valgrind$|^scripts/provision-build-cache$|^scripts/with-full-suite-lock$|^scripts/rue$|^scripts/rue-bin$'

# Beyond this many impacted targets a compiler change has reached most of the
# graph, and the `//...` pattern is the better expression of it.
NARROW_LIMIT="${RUE_AFFECTED_NARROW_LIMIT:-600}"

buck2_bin() { printf '%s\n' "${RUE_AFFECTED_BUCK2:-$repo_root/buck2}"; }

# `root//:foo` and `root//:foo (cfg)` are the same target as `//:foo`.
normalize_cell() { sed -E 's|^root//|//|; s| \([^()]*\)$||' | grep . || true; }

# Normalized labels for one uquery; non-zero only when Buck cannot answer.
query_labels() {
    local raw
    raw="$("$(buck2_bin)" uquery "$1")" || return 1
    normalize_cell <<<"$raw"
}

force_full_match() {
    local match
    match="$(grep -E "$FORCE_FULL_REGEX" || true)"
    [[ -n "$match" ]] || return 1
    head -n1 <<<"$match"
}

# `git diff --name-status --no-renames` records to bare paths. A/M/D cover
# every change once renames are disabled; anything else fails open.
status_paths() {
    awk -F '\t' '/^[AMD]\t[^\t]+$/ { print $2; next } { exit 1 }'
}

# The identical command for both dumps, so unconfigured target hashes compare.
buck_targets_dump() {
    "$1" targets root//... --streaming --keep-going --no-cache --json-lines \
        --show-unconfigured-target-hash --imports \
        --output-attribute '^buck\.|^name$|^labels$|^ci_srcs$|^ci_srcs_must_match$|^ci_deps$|^remote_execution$|^tests$' \
        --output "$2"
}

# The one clippy inventory: every crate macro emits a sh_test ending in
# `-clippy`. Returns 2 (distinct from a query failure) when the live query
# succeeds but is empty: that is a broken macro, and stays a hard error.
clippy_targets() {
    local queried
    queried="$(query_labels "kind('sh_test', 'root//crates/...')")" || return 1
    queried="$(grep -- '-clippy$' <<<"$queried" || true)"
    if [[ -z "$queried" ]]; then
        echo "affected-targets: live clippy graph selection is empty" >&2
        return 2
    fi
    printf '%s\n' "$queried"
}

# Compared against clippy_targets by validate-ci-gate.py (RUE-1855).
clippy_owned_targets() {
    local targets
    targets="$(query_labels "attrfilter(labels, 'rue_ci_clippy_lane', //crates/...)")" || return 1
    [[ -n "$targets" ]] || { echo "affected-targets: rue_ci_clippy_lane graph selection is empty" >&2; return 1; }
    printf '%s\n' "$targets"
}

# Native unit membership is graph-owned; an empty answer is an error (RUE-1266).
native_platform_targets() {
    local targets
    targets="$(query_labels "attrfilter(labels, 'rue_platform_native', set(//... toolchains//...))")" || return 1
    [[ -n "$targets" ]] || { echo "affected-targets: rue_platform_native graph selection is empty" >&2; return 1; }
    printf '%s\n' "$targets"
}

# The platform-corpus inventory, from the graph (RUE-1936): every cached corpus
# (`_corpus_action`) that scripts/ci-heavy-suite runs (`rue_heavy_suite`) and
# that required CI owns in a dedicated job (`rue_ci_dedicated_lane`, or a
# `rue_cli_shard` slice). A corpus whose shards carry the label is represented
# by them, not by itself. Prints nothing and fails when Buck cannot answer;
# `decide` then runs everything and the shard planner refuses an empty set.
corpus_targets() {
    local actions owned suite
    actions="$(query_labels "kind('_corpus_action', //...)")" || return 1
    owned="$(query_labels "attrfilter(labels, 'rue_heavy_suite', //...) intersect (attrfilter(labels, 'rue_ci_dedicated_lane', //...) + attrfilter(labels, 'rue_cli_shard', //...))")" || return 1
    while IFS= read -r suite; do
        [[ -n "$suite" ]] || continue
        case $'\n'"$actions"$'\n' in *$'\n'"${suite}-action"$'\n'*) ;; *) continue ;; esac
        case $'\n'"$owned" in *$'\n'"${suite}-shard-"*) continue ;; esac
        printf '%s\n' "$suite"
    done <<<"$owned"
}

# The targets each gated lane executes, mirroring ci.yml. A lane runs when any
# of them is impacted; an unknown lane is an error, which `decide` turns into a
# full run.
lane_targets() {
    case "$1" in
        clippy) clippy_targets ;;
        native-linux-arm64|native-macos-arm64)
            # The corpora stand in for the host-evaluated `only_on` cases the
            # native corpus runner executes.
            native_platform_targets || return 1
            printf '%s\n' //:spec-tests //:cli-tests ;;
        release) echo //:release-smoke ;;
        valgrind) echo //crates/rue:rue //:cli-tests ;;
        asan)
            # Its Cargo sources are outside the graph and force a full run.
            echo //crates/rue-runtime:rue-runtime //crates/rue-allocator:rue-allocator ;;
        compiler-reproducibility) echo //crates/rue:rue ;;
        rue-program-digests) echo //fixtures/rue-program:hello ;;
        *) return 1 ;;
    esac
}

# The premerge test selection test.sh runs under CI: the premerge tier minus
# the sets whose required jobs own them.
premerge_test_targets() {
    local base="set(//... toolchains//...)" targets
    targets="$(query_labels "attrfilter(labels, rue_test_tier_premerge, $base) except (attrfilter(labels, rue_ci_dedicated_lane, $base) + attrfilter(labels, rue_cli_shard, $base) + attrfilter(labels, rue_ci_clippy_lane, $base))")" || return 1
    [[ -n "$targets" ]] || { echo "affected-targets: the premerge test scope came back empty" >&2; return 1; }
    printf '%s\n' "$targets"
}

# The `//crates/...` targets a premerge build must not name (RUE-1511).
#
# `cached_corpus_suite` splits a corpus into a `_corpus_action` that RUNS the
# harness and a thin sh_test asserting its stamp, so `buck2 build` of the
# action executes the corpus. `//crates/rue-oracle-diff:*-action` ran in full
# inside `Build all targets` concurrently with the dedicated lanes that own it.
# The invariant is two graph operations: `_corpus_action` nodes in
# `deps(required selection)` are the owned actions, and `rdeps(//crates/...,
# owned)` is the exact exclusion set, wrappers and carriers included. An action
# no required lane owns stays in the build: a corpus nothing runs is the
# RUE-924 false green. Fails when Buck cannot answer, and the caller builds
# the whole pattern.
deferred_corpus_targets() {
    local covered corpus joined
    covered="$(query_labels "attrfilter(labels, rue_test_tier_premerge, //crates/...) except (attrfilter(labels, rue_ci_dedicated_lane, //crates/...) + attrfilter(labels, rue_cli_shard, //crates/...) + attrfilter(labels, rue_ci_clippy_lane, //crates/...))")" || return 1
    corpus="$(corpus_targets)" || return 1
    covered="$(printf '%s\n%s\n' "$covered" "$corpus" | grep . || true)"
    [[ -n "$covered" ]] || return 0
    joined="${covered//$'\n'/ }"
    # Configured: the rdeps closure is a property of the built configuration.
    covered="$("$(buck2_bin)" cquery "rdeps(//crates/..., kind('_corpus_action', deps(set($joined))))")" || return 1
    normalize_cell <<<"$covered"
}

# The unnarrowed premerge build scope: `//crates/...` expanded and minus the
# deferred closure. `buck2 build` has no kind or label exclusion, so the
# subtraction happens before the pattern reaches it.
build_scope() {
    local deferred joined expr="//crates/..." scope
    deferred="$(deferred_corpus_targets)" || return 1
    # Joined in its own statement: Bash 3.2 mis-parses this expansion inside
    # a double-quoted string (macOS runs this script with /bin/bash).
    joined="${deferred//$'\n'/ }"
    [[ -n "$deferred" ]] && expr="//crates/... except set($joined)"
    scope="$(query_labels "$expr")" || return 1
    [[ -n "$scope" ]] || { echo "affected-targets: the crate build scope came back empty" >&2; return 1; }
    printf '%s\n' "$scope"
}

# The one place a narrowing consumer obtains its unnarrowed scope.
scope_targets() {
    case "$1" in
        clippy) clippy_targets ;;
        linux-premerge-build) build_scope ;;
        linux-premerge-tests) premerge_test_targets ;;
        native-platforms-units) native_platform_targets ;;
        *) echo "affected-targets: unknown narrowing consumer '$1'" >&2; return 1 ;;
    esac
}

# An impacted list is emitted only when at least one live target is impacted,
# so an empty or malformed file is lost output, not "nothing impacted".
valid_impacted_file() {
    [[ -f "$1" && -r "$1" && -s "$1" ]] || return 1
    awk 'NF != 1 || $0 !~ /^\/\/[^[:space:]]*:[^[:space:]]+$/ { bad = 1 } END { exit (NR > 0 && !bad) ? 0 : 1 }' "$1"
}

# `scope ∩ impacted`, in scope order. A scope failure keeps its status (clippy's
# empty inventory is 2) so the caller can keep that a hard error; anything
# else non-zero means "use the full scope".
narrow_scope() {
    local consumer="$1" file="$2" scope status target total=0 kept=0
    valid_impacted_file "$file" || { echo "affected-targets: impacted list for $consumer is unavailable or malformed" >&2; return 1; }
    scope="$(scope_targets "$consumer")" || return $?
    while IFS= read -r target; do
        [[ -n "$target" ]] || continue
        total=$((total + 1))
        if grep -Fxq -- "$target" "$file"; then
            kept=$((kept + 1))
            printf '%s\n' "$target"
        else
            status=$?
            [[ "$status" -eq 1 ]] || return "$status"
        fi
    done <<<"$scope"
    echo "affected-targets: $consumer narrowed to $kept of $total targets" >&2
}

emit_output() {
    [[ -n "${GITHUB_OUTPUT:-}" ]] && printf '%s=%s\n' "$1" "$2" >>"$GITHUB_OUTPUT"
    return 0
}

emit_output_multiline() {
    [[ -n "${GITHUB_OUTPUT:-}" ]] || return 0
    { printf '%s<<RUE_EOF_%s\n' "$1" "$$"; [[ -s "${2:-}" ]] && cat "$2"; printf 'RUE_EOF_%s\n' "$$"; } >>"$GITHUB_OUTPUT"
}

emit_summary() {
    [[ -n "${GITHUB_STEP_SUMMARY:-}" ]] && printf '%s\n' "$@" >>"$GITHUB_STEP_SUMMARY"
    return 0
}

decide_full() {
    echo "affected-targets: FULL run — $1"
    emit_output full true
    emit_output selected ""
    emit_output selected_lanes ""
    emit_output narrowed false
    emit_output_multiline impacted ""
    emit_summary "Affected-target selection: **full** — $1" ""
    exit 0
}

decide_select() {
    local selected="$1" lanes="$2" impacted_file="$3" closure_count="$4" live_count="$5" narrowed=false
    [[ "$NARROW_LIMIT" =~ ^[1-9][0-9]*$ ]] || decide_full "narrow limit '$NARROW_LIMIT' is malformed"
    echo "affected-targets: SELECTIVE run — corpus targets: ${selected:-<none>}; lanes: ${lanes:-<none>}"
    emit_output full false
    emit_output selected "$selected"
    emit_output selected_lanes "$lanes"
    if [[ "$closure_count" -gt 0 && "$closure_count" -le "$NARROW_LIMIT" && "$live_count" -gt 0 ]]; then
        narrowed=true
        echo "affected-targets: narrowing to $live_count live impacted targets ($closure_count in the closure)"
    else
        echo "affected-targets: not narrowing ($closure_count impacted targets; limit $NARROW_LIMIT)"
    fi
    emit_output narrowed "$narrowed"
    if [[ "$narrowed" == true ]]; then emit_output_multiline impacted "$impacted_file"; else emit_output_multiline impacted ""; fi
    emit_summary "Affected-target selection: **selective** — corpus targets: ${selected:-none}; lanes: ${lanes:-none}" \
        "Narrowed: **$narrowed** ($live_count live impacted targets of $closure_count in the closure; limit $NARROW_LIMIT)"
    exit 0
}

cmd_decide() {
    local event="${RUE_AFFECTED_EVENT:-pull_request}"
    [[ "$event" == pull_request ]] || decide_full "authoritative full run for event '$event'"

    local base_ref="${RUE_AFFECTED_BASE_SHA:-}" head_ref="${RUE_AFFECTED_HEAD_SHA:-HEAD}"
    [[ -n "$base_ref" ]] || base_ref="$(git merge-base origin/trunk HEAD 2>/dev/null)" || base_ref=""
    [[ -n "$base_ref" ]] || decide_full "could not resolve a base ref for the diff"

    local work
    work="$(mktemp -d)"
    _af_cleanup+=("$work")
    # Three-dot: unrelated base-branch changes must not inflate the diff. BTD
    # wants status records; renames off so a move is a conservative D+A.
    git diff --name-status --no-renames "${base_ref}...${head_ref}" >"$work/changes" 2>/dev/null \
        || decide_full "git diff against base '$base_ref' failed"
    [[ -s "$work/changes" ]] || decide_full "empty changed-file set (unexpected on a PR)"
    status_paths <"$work/changes" >"$work/paths" && [[ -s "$work/paths" ]] \
        || decide_full "could not derive changed paths from git status records"
    local reason
    reason="$(force_full_match <"$work/paths")" && decide_full "changed path forces a full run: $reason"

    local btd="${RUE_AFFECTED_BTD:-$repo_root/btd}" buck2
    buck2="$(buck2_bin)"
    [[ -x "$btd" ]] || decide_full "pinned btd executable is unavailable"
    buck_targets_dump "$buck2" "$work/head.jsonl" >&2 || decide_full "buck2 targets dump at head failed"
    # The base dump comes from a detached worktree that shares the committed
    # prelude and toolchains, so buck2 can parse it standalone.
    git worktree add --detach "$work/base-tree" "$base_ref" >&2 || decide_full "could not create a base worktree at '$base_ref'"
    _af_worktrees+=("$work/base-tree")
    ( cd "$work/base-tree" && buck_targets_dump "${RUE_AFFECTED_BUCK2:-$work/base-tree/buck2}" "$work/base.jsonl" ) >&2 \
        || decide_full "buck2 targets dump at base failed"
    "$btd" --changes "$work/changes" --base "$work/base.jsonl" --diff "$work/head.jsonl" \
        --universe root//... --vcs git --buck "$buck2" --json-lines >"$work/impacted.jsonl" 2>"$work/btd.err" \
        || { cat "$work/btd.err" >&2; decide_full "btd returned non-zero"; }

    # Two different JSON shapes, and the parser refuses the wrong one: reading
    # the head dump in BTD mode once fell every pull request open to FULL.
    local impacted
    impacted="$(python3 "$repo_root/scripts/parse-btd-impacted.py" <"$work/impacted.jsonl")" || decide_full "could not parse btd output"
    python3 "$repo_root/scripts/parse-btd-impacted.py" --targets-dump <"$work/head.jsonl" >"$work/head-targets" \
        || decide_full "could not parse the head graph"
    [[ -s "$work/head-targets" ]] || decide_full "head graph came back empty"

    local corpus selected="" lanes="" lane inventory target
    corpus="$(corpus_targets)" || decide_full "could not query the platform-corpus inventory"
    while IFS= read -r target; do
        [[ -n "$target" ]] && grep -Fxq -- "$target" <<<"$impacted" && selected+="${selected:+ }$target"
    done <<<"$corpus"
    for lane in "${SELECTABLE_LANES[@]}"; do
        inventory="$(lane_targets "$lane")" || decide_full "could not query $lane live target membership"
        while IFS= read -r target; do
            [[ -n "$target" ]] && grep -Fxq -- "$target" <<<"$impacted" && { lanes+="${lanes:+ }$lane"; break; }
        done <<<"$inventory"
    done

    # BTD's closure may name a target that existed only at the base; publish
    # only the exact intersection with the live head graph to consumers.
    grep -Fxf "$work/head-targets" <<<"$impacted" >"$work/impacted-live"
    local status=$?
    [[ "$status" -le 1 ]] || decide_full "could not intersect the impacted closure with the head graph"
    local closure_count=0 live_count=0
    [[ -n "$impacted" ]] && closure_count="$(grep -c . <<<"$impacted")"
    [[ -s "$work/impacted-live" ]] && live_count="$(grep -c . "$work/impacted-live")"
    decide_select "$selected" "$lanes" "$work/impacted-live" "$closure_count" "$live_count"
}

usage() {
    echo "usage: scripts/affected-targets [decide|force-full-match|corpus-targets|lanes|lane-targets LANE|native-targets|clippy-owned-targets|scope-targets LANE|narrow-scope LANE FILE]" >&2
    exit 2
}

case "${1:-decide}" in
    decide) [[ $# -le 1 ]] || usage; cmd_decide ;;
    force-full-match)
        [[ $# -eq 1 ]] || usage
        if reason="$(force_full_match)"; then printf 'FULL: %s\n' "$reason"; exit 0; fi
        exit 1 ;;
    corpus-targets) [[ $# -eq 1 ]] || usage; corpus_targets ;;
    lanes) [[ $# -eq 1 ]] || usage; printf '%s\n' "${SELECTABLE_LANES[@]}" ;;
    lane-targets) [[ $# -eq 2 ]] || usage; lane_targets "$2" ;;
    native-targets) [[ $# -eq 1 ]] || usage; native_platform_targets ;;
    clippy-owned-targets) [[ $# -eq 1 ]] || usage; clippy_owned_targets ;;
    scope-targets) [[ $# -eq 2 ]] || usage; scope_targets "$2" ;;
    narrow-scope) [[ $# -eq 3 ]] || usage; narrow_scope "$2" "$3" ;;
    *) usage ;;
esac
