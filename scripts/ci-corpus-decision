#!/usr/bin/env bash
# Translate the corpus gate's three-way exit contract into the `run` output
# consumed by the platform-corpus workflow step. Only exit 1 means an
# intentional deselection; a missing, crashing, or malformed gate fails open.
set -uo pipefail

if [[ $# -ne 1 ]]; then
    echo "usage: scripts/ci-corpus-decision //:TARGET" >&2
    exit 2
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
gate="${RUE_AFFECTED_GATE:-$repo_root/scripts/ci-corpus-selected}"
run=true

if "$gate" "$1"; then
    :
else
    status=$?
    if [[ "$status" -eq 1 ]]; then
        run=false
    else
        echo "Corpus selection failed unexpectedly (exit $status); running full corpus." >&2
    fi
fi

if [[ -n "${GITHUB_OUTPUT:-}" ]]; then
    printf 'run=%s\n' "$run" >>"$GITHUB_OUTPUT"
else
    printf 'run=%s\n' "$run"
fi
