#!/usr/bin/env bash
# Run the clippy lane (RUE-1855): the live `-clippy` inventory from
# scripts/affected-targets, narrowed to the determinator's impacted closure
# when NARROW_FILE names a non-empty one.
#
# A successful live query with zero clippy targets means the query or the
# crate macros are broken and stays a hard error; a query that FAILS falls
# open to `//crates/...`, the broad superset.
set -uo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
affected="$repo_root/scripts/affected-targets"
buck2="$repo_root/buck2"

[[ $# -eq 1 && "$1" == run ]] || { echo "usage: scripts/ci-clippy run" >&2; exit 2; }

hard_error() {
    echo "clippy: no live -clippy targets found; the query or crate macros are broken" >&2
    exit 1
}

selection=full
targets_text=""
if [[ -n "${NARROW_FILE:-}" && -s "$NARROW_FILE" ]]; then
    if targets_text="$("$affected" narrow-scope clippy "$NARROW_FILE")"; then
        if [[ -z "$targets_text" ]]; then
            echo "clippy: verified impacted subset is empty; intentional no-op"
            exit 0
        fi
        selection=narrowed
    else
        status=$?
        [[ "$status" -eq 2 ]] && hard_error
        echo "clippy: narrowing unavailable; running the full live inventory" >&2
    fi
fi
if [[ "$selection" == full ]]; then
    if targets_text="$("$affected" scope-targets clippy)"; then
        :
    else
        status=$?
        [[ "$status" -eq 2 ]] && hard_error
        echo "clippy: live scope unavailable; running all crate tests as the fail-open superset" >&2
        exec "$buck2" test //crates/...
    fi
fi

targets=()
while IFS= read -r target; do
    [[ -n "$target" ]] && targets+=("$target")
done <<<"$targets_text"
[[ "${#targets[@]}" -gt 0 ]] || hard_error
echo "Running $selection clippy scope across ${#targets[@]} crates..."
exec "$buck2" test "${targets[@]}"
