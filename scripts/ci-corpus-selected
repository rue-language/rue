#!/usr/bin/env bash
# Decide whether one gated CI job runs its heavy steps (RUE-1119, RUE-1130).
#
# Writes `run=true|false` to $GITHUB_OUTPUT. `run=false` only when the
# determinator explicitly decided a selective run (`RUE_AFFECTED_FULL=false`)
# and this unit is absent from its selected list: corpus targets (`//...`) read
# `RUE_AFFECTED_TARGETS`, workflow lanes read `RUE_AFFECTED_LANES`. Anything
# else — unset, malformed, or a full decision — runs, so a lost job output can
# only ever cost wall time (RUE-924).
set -uo pipefail

[[ $# -eq 1 ]] || { echo "usage: scripts/ci-corpus-selected //:TARGET|LANE" >&2; exit 2; }
unit="$1"
case "$unit" in
    //*) selected="${RUE_AFFECTED_TARGETS:-}" ;;
    *) selected="${RUE_AFFECTED_LANES:-}" ;;
esac

run=true
if [[ "${RUE_AFFECTED_FULL:-}" == "false" && " $selected " != *" $unit "* ]]; then
    run=false
    note="$unit intentionally deselected by scripts/affected-targets: this diff does not reach it, and the merge-queue run executes everything."
    echo "$note"
    [[ -n "${GITHUB_STEP_SUMMARY:-}" ]] && printf '%s\n' "$note" >>"$GITHUB_STEP_SUMMARY"
fi
if [[ -n "${GITHUB_OUTPUT:-}" ]]; then
    printf 'run=%s\n' "$run" >>"$GITHUB_OUTPUT"
else
    printf 'run=%s\n' "$run"
fi
