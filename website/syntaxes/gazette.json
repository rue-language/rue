{
  "rue": {
    "keywords": ["borrow", "break", "checked", "comptime", "const", "continue", "drop", "else", "enum", "extern", "fn", "for", "if", "impl", "in", "inout", "interface", "let", "linear", "loop", "match", "mut", "pub", "return", "struct", "unchecked", "while", "yield"],
    "types": ["Self", "bool", "f32", "f64", "i16", "i32", "i64", "i8", "ptr", "type", "u16", "u32", "u64", "u8"],
    "constants": ["false", "true"],
    "special": ["self"],
    "line_comment": "//",
    "quotes": "\"",
    "intrinsic_prefix": "@",
    "operators": "=<>!+-*/%&|^~",
