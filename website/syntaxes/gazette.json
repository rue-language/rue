    "quotes": "\"'",
    "operators": "=|,.",
    "punctuation": "{}()[];"
  },
  "bash": {
    "keywords": ["case", "do", "done", "elif", "else", "esac", "fi", "for", "function", "if", "in", "then", "until", "while"],
    "types": ["export", "local", "readonly"],
    "line_comment": "#",
