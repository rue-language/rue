# Buck2
buck-out/

# Third-party: Cargo registry cache (redundant with vendored sources)
third-party/.cargo/registry/
third-party/.cargo/.global-cache/

# Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store

# beads (now stored in the beads-metadata branch)
.beads

# Stable symlink to the built rue binary (scripts/rue-bin)
/bin/

# BuildBuddy remote cache local config (RUE-316) — holds the API key, never committed
.buckconfig.local

# Python bytecode from repository tooling scripts.
__pycache__/
*.pyc

# Derived at site build time from the raw records on performance-data-v1
# (ADR-0067). Never committed: a stored derived value would eventually disagree
# with the observations it came from, and the stored copy is the one that would
# be believed.
website/static/performance-data.json
