{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Buck2: Build All Crates",
            "type": "shell",
            "command": "buck2",
            "args": ["build", "//crates/..."],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$rustc"],
            "detail": "Build all crates using Buck2"
        },
        {
            "label": "Buck2: Test All Crates",
            "type": "shell",
            "command": "buck2",
            "args": ["test", "//crates/..."],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$rustc"],
            "detail": "Run all tests using Buck2"
        }
    ]
}