// std.collections — StrMap(V): the `StrBuf`-keyed hash map with `Copy` values
// (RUE-938), now a thin wrapper over `std.hashmap.HashMap(StrBuf, V)`: `StrBuf`
// conforms to `Hashable + Equatable` (std.interfaces), so the generic map is
// the one implementation and this module only adapts its key convention.
//
// The difference from `HashMap` is that every key here is BORROWED: `insert`
// copies a new key into the map and leaves the caller's usable, where
// `HashMap.insert` takes the key by move. That is the API this map has always
// had, and what the interning pools in the examples rely on.
//
// `new(filler)` takes a throwaway `V`, which the map no longer needs (slots
// hold no placeholder values); it is accepted and dropped so the constructor
// keeps its signature. The value type stays `Copy`, as before.
//
//     const std = @import("std");
//     let M = std.strmap.StrMap(u64);
//     let mut m = M.new(0);
//     let k: StrBuf = "hello";
//     m.insert(borrow k, 100);
//     m.get(borrow k);        // Some(100)

const hashmap = @import("hashmap.rue");
const option = @import("option.rue");
const strbuf = @import("strbuf.rue");
const StrBuf = strbuf.StrBuf;

pub fn StrMap(comptime V: type) -> type {
    let Inner = hashmap.HashMap(StrBuf, V);
    struct {
        inner: Inner,

        fn new(filler: V) -> Self {
            let _unused = filler;
            Self { inner: Inner.new() }
        }

        fn len(borrow self) -> u64 {
            self.inner.len()
        }
        fn is_empty(borrow self) -> bool {
            self.inner.is_empty()
        }

        // Insert or overwrite `k -> v`. A present key is updated in place;
        // a new key is copied into the map.
        fn insert(inout self, borrow k: StrBuf, v: V) {
            if !self.inner.update(borrow k, v) {
                self.inner.insert(k.copy(), v);
            }
        }

        // The value for `k`, or `None`.
        fn get(borrow self, borrow k: StrBuf) -> option.Option(V) {
            self.inner.get(borrow k)
        }

        fn contains(borrow self, borrow k: StrBuf) -> bool {
            self.inner.contains(borrow k)
        }

        // Remove `k`; returns whether it was present.
        fn remove(inout self, borrow k: StrBuf) -> bool {
            self.inner.remove(borrow k)
        }
    }
}
