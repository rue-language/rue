// std.env — process arguments and environment access (RUE-935).
//
// argc/argv/envp exist only in the register/stack state the platform loader
// hands the program at entry, so the runtime captures them in its per-target
// `_start`/`_main` code (crates/rue-runtime/src/entry.rs + per-target files) and
// exposes them through the versioned runtime ABI (crates/rue-runtime-abi):
// `__rue_arg_count/ptr/len` and `__rue_env_count/ptr/len`. This module assembles
// owned `StrBuf` copies on top of that surface — second-class borrows cannot be
// stored, so every value is copied out of the loader-owned vectors on access.
// Values are byte strings with no UTF-8 validation (ADR-0035).
//
//     const std = @import("std");
//     const n = std.env.arg_count();     // includes argv[0]
//     match std.env.arg(1) { ... }       // Option(StrBuf)
//     let all = std.env.args();          // ArrayBuf(StrBuf), argv[0] first
//     match std.env.var(name) { ... }    // Option(StrBuf)
//
// COMPILER BRIDGE (out of this change's scope — RUE-935 runtime cluster owns
// crates/rue-runtime + crates/rue-runtime-abi only): the six `@arg_*`/`@env_*`
// intrinsics used below lower to the runtime ABI accessors named above. They
// need the ordinary intrinsic wiring in the parser/sema/codegen, mirroring how
// `@random_u32` (no-arg scalar helper) and `@str_byte_at` (u64 arg, scalar
// result) are dispatched: a `KnownSymbols` entry, an `analyze_*_intrinsic`
// case, an inference row, a `RuntimeCallKind` mapping to the helper id, and a
// `RuntimeCallPlan` in each backend. Until that lands this module type-checks
// only when one of its functions is actually called; nothing in std or the
// existing tests references it, so it stays inert.

const option = @import("option.rue");
const strbuf = @import("strbuf.rue");
const arraybuf = @import("arraybuf.rue");
const StrBuf = strbuf.StrBuf;

// Copy `count` bytes starting at `start` from a loader-owned C string pointer
// into a fresh owned `StrBuf`. The pointer addresses at least `start + count`
// readable bytes (the runtime derived the entry's length from its NUL
// terminator). The raw byte reads live in `checked` per the std
// unchecked-operation convention (spec chapter 9).
fn copy_range(source: ptr mut u8, start: u64, count: u64) -> StrBuf {
    let mut out = StrBuf.with_capacity(count);
    let mut i: u64 = 0;
    while i < count {
        let byte: u8 = checked { @byte_read(source, start + i) };
        out.push(byte);
        i += 1;
    }
    out
}

/// Number of command-line arguments, including `argv[0]`.
pub fn arg_count() -> u64 {
    checked { @arg_count() }
}

/// The `i`th command-line argument as an owned byte string, or `None` when
/// `i >= arg_count()`.
pub fn arg(i: u64) -> option.Option(StrBuf) {
    let O = option.Option(StrBuf);
    if i >= arg_count() {
        return O.None;
    }
    let entry_ptr: ptr mut u8 = checked { @arg_ptr(i) };
    let len: u64 = checked { @arg_len(i) };
    O.Some(copy_range(entry_ptr, 0, len))
}

/// All command-line arguments as owned byte strings, `argv[0]` first. The
/// caller owns the returned `ArrayBuf` and each `StrBuf` element.
pub fn args() -> arraybuf.ArrayBuf(StrBuf) {
    let A = arraybuf.ArrayBuf(StrBuf);
    let count = arg_count();
    let mut out = A.new();
    let mut i: u64 = 0;
    while i < count {
        let entry_ptr: ptr mut u8 = checked { @arg_ptr(i) };
        let len: u64 = checked { @arg_len(i) };
        out.push(copy_range(entry_ptr, 0, len));
        i += 1;
    }
    out
}

/// Number of environment entries (`KEY=VALUE` byte strings).
pub fn env_count() -> u64 {
    checked { @env_count() }
}

// Whether environment entry `[ptr, len)` has key `name` — i.e. the first
// `name_len` bytes equal `name` and byte `name_len` is `'='` (0x3D). Keys never
// contain `'='`, so this is an exact key match.
fn key_matches(entry_ptr: ptr mut u8, len: u64, borrow name: StrBuf, name_len: u64) -> bool {
    // Need room for the key plus the '=' separator.
    if len < name_len + 1 {
        return false;
    }
    let mut i: u64 = 0;
    while i < name_len {
        let entry_byte: u8 = checked { @byte_read(entry_ptr, i) };
        // `name` is a borrow, so read its bytes through the borrow-safe
        // accessor: the trapping `name[i]` index form is a by-copy read that
        // would move out of the borrowed `StrBuf` (E0429).
        let name_byte: u8 = StrBuf.byte_at_borrowed(borrow name, i);
        if entry_byte != name_byte {
            return false;
        }
        i += 1;
    }
    let separator: u8 = checked { @byte_read(entry_ptr, name_len) };
    separator == 61
}

/// Look up environment variable `name`, returning its value as an owned byte
/// string, or `None` when it is absent. Linear scan of the captured environment
/// with byte-equality on the key before `=`.
pub fn var(borrow name: StrBuf) -> option.Option(StrBuf) {
    let O = option.Option(StrBuf);
    let count = env_count();
    let name_len = name.len();
    let mut i: u64 = 0;
    while i < count {
        let entry_ptr: ptr mut u8 = checked { @env_ptr(i) };
        let len: u64 = checked { @env_len(i) };
        if key_matches(entry_ptr, len, borrow name, name_len) {
            // The value is everything after the '=' at index `name_len`.
            let value_start = name_len + 1;
            let value_len = len - value_start;
            return O.Some(copy_range(entry_ptr, value_start, value_len));
        }
        i += 1;
    }
    O.None
}
