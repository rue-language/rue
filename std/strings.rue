// std.strings — byte- and character-oriented text helpers over `StrBuf`.
//
// Byte-oriented helpers use the bounds-checked `s.byte_at(i) -> Option(u8)`
// surface. Character counts use strict or lossy UTF-8 scalar iteration.
// Fallible parses/searches return `option.Option(T)`.
//
//     const std = @import("std");
//     std.strings.parse_int("-42");        // Some(-42)
//     std.strings.find("hello", 108);      // Some(2)  (first 'l')
//     std.strings.trim("  hi  ");          // "hi"
//     std.strings.repeat("ab", 3);         // "ababab"
//     std.strings.count_chars("café");   // 4

const ascii = @import("ascii.rue");
const option = @import("option.rue");
const math = @import("math.rue");
const strbuf = @import("strbuf.rue");
const StrBuf = strbuf.StrBuf;

// Internal callers establish `index < s.len()` before reading. Keep the
// impossible branch in one place while Rue's Option surface has no `expect`
// helper that can express that invariant.
fn bounded_byte_at(borrow s: StrBuf, index: u64) -> u8 {
    let O = option.Option(u8);
    match s.byte_at(index) {
        O.Some(byte) => byte,
        O.None => @panic("index out of bounds"),
    }
}

// Parse a decimal integer with an optional leading '-'. Returns `None` on an
// empty string, a lone '-', any non-digit byte, or arithmetic overflow of
// `i64` (overflow is caught with `std.math.checked_mul`/`checked_add`, so no
// trap). NOTE: because magnitude is accumulated as a positive `i64` before an
// optional negation, `i64::MIN` (-9223372036854775808) is reported as overflow
// (`None`) — its magnitude does not fit a positive `i64`.
pub fn parse_int(s: StrBuf) -> option.Option(i64) {
    let O = option.Option(i64);
    let n = s.len();
    if n == 0 {
        return O.None;
    }
    let mut i: u64 = 0;
    let mut neg = false;
    let first = bounded_byte_at(borrow s, 0);
    if first == 45 {
        neg = true;
        i = 1;
        if n == 1 {
            return O.None;
        }
    }
    let mut acc: i64 = 0;
    let ten: i64 = 10;
    while i < n {
        let byte = bounded_byte_at(borrow s, i);
        if !ascii.is_digit(byte) {
            return O.None;
        }
        let dg: i64 = @intCast(byte - 48);
        match math.checked_mul(acc, ten) {
            O.Some(m) => {
                match math.checked_add(m, dg) {
                    O.Some(sum) => {
                        acc = sum;
                    },
                    O.None => {
                        return O.None;
                    },
                }
            },
            O.None => {
                return O.None;
            },
        }
        i += 1;
    }
    if neg {
        O.Some(-acc)
    } else {
        O.Some(acc)
    }
}

// Index of the first byte equal to `byte`, or `None`.
pub fn find(s: StrBuf, byte: u8) -> option.Option(u64) {
    let O = option.Option(u64);
    let n = s.len();
    let mut i: u64 = 0;
    while i < n {
        let c = bounded_byte_at(borrow s, i);
        if c == byte {
            return O.Some(i);
        }
        i += 1;
    }
    O.None
}

// Index of the last byte equal to `byte`, or `None`.
pub fn rfind(s: StrBuf, byte: u8) -> option.Option(u64) {
    let O = option.Option(u64);
    let mut i = s.len();
    while i > 0 {
        i -= 1;
        let c = bounded_byte_at(borrow s, i);
        if c == byte {
            return O.Some(i);
        }
    }
    O.None
}

// Number of bytes equal to `byte`.
pub fn count(s: StrBuf, byte: u8) -> u64 {
    let mut c: u64 = 0;
    let n = s.len();
    let mut i: u64 = 0;
    while i < n {
        let cur = bounded_byte_at(borrow s, i);
        if cur == byte {
            c += 1;
        }
        i += 1;
    }
    c
}

// Whether the first byte of `s` equals `byte` (false for the empty string).
pub fn starts_with_byte(s: StrBuf, byte: u8) -> bool {
    if s.len() == 0 {
        false
    } else {
        let c = bounded_byte_at(borrow s, 0);
        c == byte
    }
}

// Copy of `s` with leading ASCII whitespace removed.
pub fn trim_start(s: StrBuf) -> StrBuf {
    let n = s.len();
    let mut start: u64 = 0;
    let mut scanning = true;
    while scanning && start < n {
        let c = bounded_byte_at(borrow s, start);
        if ascii.is_whitespace(c) {
            start += 1;
        } else {
            scanning = false;
        }
    }
    let mut out = StrBuf.new();
    let mut i = start;
    while i < n {
        let c = bounded_byte_at(borrow s, i);
        out.push(c);
        i += 1;
    }
    out
}

// Copy of `s` with trailing ASCII whitespace removed.
pub fn trim_end(s: StrBuf) -> StrBuf {
    let n = s.len();
    let mut end = n;
    let mut scanning = true;
    while scanning && end > 0 {
        let c = bounded_byte_at(borrow s, end - 1);
        if ascii.is_whitespace(c) {
            end -= 1;
        } else {
            scanning = false;
        }
    }
    let mut out = StrBuf.new();
    let mut i: u64 = 0;
    while i < end {
        let c = bounded_byte_at(borrow s, i);
        out.push(c);
        i += 1;
    }
    out
}

// Copy of `s` with both leading and trailing ASCII whitespace removed.
pub fn trim(s: StrBuf) -> StrBuf {
    let n = s.len();
    let mut start: u64 = 0;
    let mut sc = true;
    while sc && start < n {
        let c = bounded_byte_at(borrow s, start);
        if ascii.is_whitespace(c) {
            start += 1;
        } else {
            sc = false;
        }
    }
    let mut end = n;
    let mut ec = true;
    while ec && end > start {
        let c = bounded_byte_at(borrow s, end - 1);
        if ascii.is_whitespace(c) {
            end -= 1;
        } else {
            ec = false;
        }
    }
    let mut out = StrBuf.new();
    let mut i = start;
    while i < end {
        let c = bounded_byte_at(borrow s, i);
        out.push(c);
        i += 1;
    }
    out
}

// `s` concatenated `n` times (empty string when `n == 0`).
pub fn repeat(s: StrBuf, n: u64) -> StrBuf {
    let mut out = StrBuf.new();
    let len = s.len();
    let mut k: u64 = 0;
    while k < n {
        let mut i: u64 = 0;
        while i < len {
            let c = bounded_byte_at(borrow s, i);
            out.push(c);
            i += 1;
        }
        k += 1;
    }
    out
}

// Number of Unicode scalar values in valid UTF-8. Traps on malformed UTF-8.
pub fn count_chars(s: StrBuf) -> u64 {
    let mut count: u64 = 0;
    for _scalar in s.chars() {
        count += 1;
    }
    count
}

// Number of Unicode scalar values after malformed UTF-8 is replaced with
// U+FFFD using the canonical lossy decoder.
pub fn count_chars_lossy(s: StrBuf) -> u64 {
    let mut count: u64 = 0;
    for _scalar in s.chars_lossy() {
        count += 1;
    }
    count
}
