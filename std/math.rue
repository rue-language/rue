// std.math — integer and floating-point math utilities.
//
// The legacy `abs`/`min`/`max`/`clamp` remain `i32` for backward compatibility;
// the GENERIC (comptime-`T`) min/max/clamp live in `std.cmp`. The extended
// functions below are generic over a comptime integer type `T` (verified:
// `+ - * / % < &` all work on a type parameter), including `checked_*`, whose
// overflow pre-checks use the integer-bounds intrinsics `@int_max(T)`/
// `@int_min(T)` (RUE-694).
//
// The floating-point section at the end (ADR-0065 §7) is generic over a
// comptime FLOAT type `T` (`f32` or `f64`): the single-instruction operations
// `sqrt`/`floor`/`ceil`/`trunc`/`round`, the `inf`/`nan` values and their
// predicates, the exact remainder `rem` that stands in for the undefined float
// `%`, and the IEEE total order `total_cmp`.
//
// NOTE: calling a generic (`comptime T`) helper here from another module with a
// bare integer literal currently fails to coerce the literal (RUE-693); bind a
// typed local until that lands.

const option = @import("option.rue");

// --- legacy i32 helpers (unchanged; generic forms live in std.cmp) ---

// Absolute value (i32).
pub fn abs(x: i32) -> i32 {
    if x < 0 { -x } else { x }
}

// The lesser of two values (i32).
pub fn min(a: i32, b: i32) -> i32 {
    if a < b { a } else { b }
}

// The greater of two values (i32).
pub fn max(a: i32, b: i32) -> i32 {
    if a > b { a } else { b }
}

// Clamp `x` into the inclusive range `[lo, hi]` (i32).
pub fn clamp(x: i32, lo: i32, hi: i32) -> i32 {
    if x < lo {
        lo
    } else if x > hi {
        hi
    } else {
        x
    }
}

// --- generic integer functions ---

// -1, 0, or 1 by the sign of `x`. SIGNED `T` only.
pub fn sign(comptime T: type, x: T) -> T {
    if x < 0 {
        -1
    } else if x > 0 {
        1
    } else {
        0
    }
}

// Greatest common divisor (Euclid). The result is non-negative for signed `T`;
// `gcd(0, 0) == 0`.
//
// Euclid runs on the SIGNED values and the sign is normalised only at the end
// (RUE-1708). Taking `|a|`/`|b|` up front — the old shape — trapped for a
// `T::MIN` operand, whose negation is not representable, even when the answer
// plainly was: `gcd(i64::MIN, 2) == 2`. Rue's `%` truncates toward zero, so
// the remainder's magnitude still strictly decreases whatever the signs are
// and the loop terminates exactly as before.
//
// PANICS only when the true gcd is `|T::MIN| == 2^(bits-1)`, which no signed
// `T` can hold: that is `gcd(MIN, 0)`, `gcd(0, MIN)` and `gcd(MIN, MIN)`.
pub fn gcd(comptime T: type, a: T, b: T) -> T {
    if @int_min(T) != 0 {
        // Signed `T`. The remainder `T::MIN % -1` traps (its quotient
        // overflows), so answer the magnitude-1 operands up front; their gcd
        // with anything is 1. That is the only pairing the loop below could
        // hit with `T::MIN` as the dividend. `minus_one` is computed rather
        // than written as a literal so this whole (unsigned-unreachable) block
        // still type-checks at unsigned `T`, exactly as in `checked_mul`.
        let zero: T = 0;
        let minus_one: T = zero - 1;
        if a == 1 || b == 1 || a == minus_one || b == minus_one {
            return 1;
        }
    }
    let mut x = a;
    let mut y = b;
    while y != 0 {
        let t = y;
        y = x % y;
        x = t;
    }
    if x < 0 {
        if x == @int_min(T) {
            @panic("gcd: |T::MIN| is not representable in T");
        }
        // `0 - x`, not `-x`: unary `-` is rejected outright on an unsigned
        // type (E0801) even in a branch that unsigned `T` can never reach, so
        // writing it that way would break every unsigned instantiation at
        // COMPILE time — as the pre-RUE-1708 body silently did, despite the
        // doc's claim to work for any `T`.
        let zero: T = 0;
        return zero - x;
    }
    x
}

// Least common multiple. `lcm(0, _) == 0`. SIGNED `T`. Traps on overflow.
//
// PANICS for a non-zero `T::MIN` operand (RUE-1708): `|lcm(T::MIN, x)|` is
// `2^(bits-1)` times an odd factor for every non-zero `x`, so it is never
// representable — unlike `gcd`, there is nothing to rescue here. Rejecting
// `T::MIN` up front is also what makes the closing negation safe: for the
// product to land exactly on `T::MIN`, one operand's magnitude would have to
// be `2^(bits-1)` itself.
pub fn lcm(comptime T: type, a: T, b: T) -> T {
    if a == 0 {
        return 0;
    }
    if b == 0 {
        return 0;
    }
    if a == @int_min(T) || b == @int_min(T) {
        // Unreachable for unsigned `T`: there `@int_min(T)` is 0, already
        // handled above.
        @panic("lcm: a T::MIN operand has no representable lcm");
    }
    let m = a / gcd(T, a, b) * b;
    if m < 0 { -m } else { m }
}

// Integer exponentiation by squaring: `base ** exp`. Traps on overflow.
pub fn pow(comptime T: type, base: T, exp: u64) -> T {
    let mut result: T = 1;
    let mut b = base;
    let mut e = exp;
    while e > 0 {
        if e % 2 == 1 {
            result *= b;
        }
        e /= 2;
        if e > 0 {
            b *= b;
        }
    }
    result
}

// Integer square root: the largest `r` with `r*r <= n`. `n` must be >= 0.
// The comparison is done as `mid <= n / mid` to avoid overflowing `mid*mid`.
pub fn isqrt(comptime T: type, n: T) -> T {
    if n < 2 {
        return n;
    }
    let mut lo: T = 1;
    let mut hi = n;
    let mut ans: T = 1;
    while lo <= hi {
        let mid = lo + (hi - lo) / 2;
        if mid <= n / mid {
            ans = mid;
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    ans
}

// Whether `n` is a positive power of two.
pub fn is_pow_of_two(comptime T: type, n: T) -> bool {
    n > 0 && (n & (n - 1)) == 0
}

// Trial-division primality test.
//
// The loop bound is `i <= n / i`, NOT `i * i <= n`: for a prime near
// `@int_max(T)` the loop only exits once `i` passes `isqrt(n)`, and there the
// square overflows and traps before the comparison can end it — `is_prime(i32,
// 2147483647)` trapped instead of returning `true` (RUE-1708). Dividing is the
// same overflow-free trick `isqrt` above uses, and it fixes every `T` at once.
// `i >= 2` throughout, so the division never divides by zero.
pub fn is_prime(comptime T: type, n: T) -> bool {
    if n < 2 {
        return false;
    }
    let mut i: T = 2;
    while i <= n / i {
        if n % i == 0 {
            return false;
        }
        i += 1;
    }
    true
}

// --- checked arithmetic (None on overflow, no trap) ---
//
// Generic over a comptime integer type `T` (RUE-694): the overflow pre-checks
// are written against `@int_max(T)`/`@int_min(T)`, so signed and unsigned
// types alike work. The signed-only corners (`MIN / -1`) live behind an
// `@int_min(T) == 0` signedness test whose signed arm is unreachable for
// unsigned instantiations and avoids negative literals so it still
// type-checks at unsigned `T`.

// `a + b`, or `None` if it would overflow `T`.
pub fn checked_add(comptime T: type, a: T, b: T) -> option.Option(T) {
    let O = option.Option(T);
    if b > 0 {
        if a > @int_max(T) - b {
            return O.None;
        }
    } else {
        if a < @int_min(T) - b {
            return O.None;
        }
    }
    O.Some(a + b)
}

// `a - b`, or `None` if it would overflow `T`.
pub fn checked_sub(comptime T: type, a: T, b: T) -> option.Option(T) {
    let O = option.Option(T);
    if b < 0 {
        if a > @int_max(T) + b {
            return O.None;
        }
    } else {
        if a < @int_min(T) + b {
            return O.None;
        }
    }
    O.Some(a - b)
}

// `a * b`, or `None` if it would overflow `T`. Pre-checks via division so the
// multiply itself never traps.
pub fn checked_mul(comptime T: type, a: T, b: T) -> option.Option(T) {
    let O = option.Option(T);
    if a == 0 || b == 0 {
        return O.Some(0);
    }
    if @int_min(T) == 0 {
        // Unsigned: a single division pre-check covers every case.
        if a > @int_max(T) / b {
            return O.None;
        }
        return O.Some(a * b);
    }
    // Signed. The MIN/-1 corners trap under the division pre-check, so handle
    // them first; `minus_one` is computed rather than written as a literal so
    // this (unreachable-for-unsigned) path type-checks at unsigned `T`.
    let zero: T = 0;
    let minus_one: T = zero - 1;
    if a == minus_one {
        if b == @int_min(T) {
            return O.None;
        }
        return O.Some(a * b);
    }
    if b == minus_one {
        if a == @int_min(T) {
            return O.None;
        }
        return O.Some(a * b);
    }
    if a > 0 {
        if b > 0 {
            if a > @int_max(T) / b {
                return O.None;
            }
        } else {
            if b < @int_min(T) / a {
                return O.None;
            }
        }
    } else {
        if b > 0 {
            if a < @int_min(T) / b {
                return O.None;
            }
        } else {
            if a < @int_max(T) / b {
                return O.None;
            }
        }
    }
    O.Some(a * b)
}

// --- floating-point functions (ADR-0065 §7; FLOAT `T` only: f32 or f64) ---
//
// Every function here follows IEEE-754 exactly and never traps: an infinity
// or NaN operand flows through the way the hardware operation propagates it.

// Correctly rounded square root. `sqrt(-x)` for `x > 0` is NaN.
pub fn sqrt(comptime T: type, x: T) -> T {
    @sqrt(x)
}

// The largest integral value not greater than `x`.
pub fn floor(comptime T: type, x: T) -> T {
    @floor(x)
}

// The smallest integral value not less than `x`.
pub fn ceil(comptime T: type, x: T) -> T {
    @ceil(x)
}

// `x` with its fractional part discarded (rounded toward zero).
pub fn trunc(comptime T: type, x: T) -> T {
    @trunc(x)
}

// The integral value nearest to `x`, with ties rounded away from zero:
// `round(2.5) == 3.0` and `round(-2.5) == -3.0`.
pub fn round(comptime T: type, x: T) -> T {
    @round(x)
}

// Absolute value. `fabs(-0.0)` is `+0.0`; a NaN stays a NaN.
//
// Written as `0.0 - x` rather than `-x` so that a negative zero comes out
// positive: negation flips the sign bit, subtraction from zero does not keep it.
pub fn fabs(comptime T: type, x: T) -> T {
    if x <= 0.0 {
        let zero: T = 0.0;
        zero - x
    } else {
        x
    }
}

// Positive infinity.
pub fn inf(comptime T: type) -> T {
    let zero: T = 0.0;
    let one: T = 1.0;
    one / zero
}

// A quiet NaN. Its sign bit is target-defined (spec 3.12), so compare NaNs
// with `is_nan`, never with `==`.
pub fn nan(comptime T: type) -> T {
    let zero: T = 0.0;
    zero / zero
}

// Whether `x` is a NaN: the one value that is unequal to itself.
pub fn is_nan(comptime T: type, x: T) -> bool {
    x != x
}

// Whether `x` is positive or negative infinity.
pub fn is_inf(comptime T: type, x: T) -> bool {
    x == inf(T) || x == 0.0 - inf(T)
}

// Whether `x` is neither infinite nor NaN.
pub fn is_finite(comptime T: type, x: T) -> bool {
    !is_nan(T, x) && !is_inf(T, x)
}

// The remainder of `x / y` with the sign of `x`, truncated toward zero: C's
// `fmod`, the explicit path the language points to for the undefined float
// `%` (ADR-0065 §9). The result is EXACT — it is `x - trunc(x / y) * y`
// computed without rounding — and never traps:
//
//   rem(NaN, y) == rem(x, NaN) == rem(inf, y) == rem(x, 0.0) == NaN
//   rem(x, inf) == x            rem(-0.0, y) == -0.0
//
// The exactness comes from the classic shift-and-subtract: each step subtracts
// the largest power-of-two multiple of `|y|` that fits under the running
// remainder. That multiple is a pure exponent change of `|y|` (exact unless it
// overflows to infinity, which only ends the doubling early), and the
// subtraction is exact because the two operands lie within a factor of two of
// each other (Sterbenz). Work is proportional to the exponent gap between
// `x` and `y`, at most a couple of thousand steps for `f64`.
pub fn rem(comptime T: type, x: T, y: T) -> T {
    if is_nan(T, x) || is_nan(T, y) || is_inf(T, x) || y == 0.0 {
        return nan(T);
    }
    if is_inf(T, y) || x == 0.0 {
        return x;
    }
    let ay = fabs(T, y);
    let mut r = fabs(T, x);
    while r >= ay {
        let mut d = ay;
        while d + d <= r {
            d = d + d;
        }
        r = r - d;
    }
    if x < 0.0 {
        let zero: T = 0.0;
        zero - r
    } else {
        r
    }
}

// IEEE-754 `totalOrder` as a three-way result: negative when `a` sorts before
// `b`, zero when they are the same value, positive otherwise. Unlike `<`, this
// is a TOTAL order: `-0.0` sorts before `+0.0`, and a NaN sorts after every
// number (a negative NaN before every number), so float keys can be sorted and
// deduplicated (ADR-0065 §8).
pub fn total_cmp(comptime T: type, a: T, b: T) -> i32 {
    @total_cmp(a, b)
}
