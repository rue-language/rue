// std.cmp — ordering and comparison utilities.
//
// Comparison and the min/max/clamp helpers are generic over any type whose
// values support the built-in relational operators (`<`, `>`, `==`) — every
// integer type today. `Ordering` is the three-way comparison result.
//
//     const std = @import("std");
//     let o = std.cmp.cmp(i64, 3, 7);        // Ordering.Less
//     let m = std.cmp.min(i64, 3, 7);        // 3
//     let c = std.cmp.clamp(i64, 12, 0, 9);  // 9
//
// The interface-bounded counterparts (`equals`, `compare`, `min_by_order`,
// `max_by_order`) take any type conforming to `std.interfaces.Equatable` /
// `Ordered` (spec 6.7) — `StrBuf` today, or a program's own struct under
// `--preview interfaces`. They sit beside the operator versions rather than
// replacing them: an integer type has no methods, so it cannot conform to an
// interface, and a bounded parameter has no operators (spec 6.7:20), so one
// function cannot serve both.
//
//     let a: StrBuf = "apple";
//     let b: StrBuf = "banana";
//     std.cmp.equals(StrBuf, borrow a, borrow b);   // false
//     std.cmp.compare(StrBuf, borrow a, borrow b);  // Ordering.Less

const interfaces = @import("interfaces.rue");

// The result of a three-way comparison.
pub enum Ordering {
    Less,
    Equal,
    Greater,
}

// Three-way compare: `Less` when `a < b`, `Greater` when `a > b`, else `Equal`.
pub fn cmp(comptime T: type, a: T, b: T) -> Ordering {
    if a < b {
        Ordering.Less
    } else if a > b {
        Ordering.Greater
    } else {
        Ordering.Equal
    }
}

// The lesser of two values (returns `a` on a tie).
pub fn min(comptime T: type, a: T, b: T) -> T {
    if a < b { a } else { b }
}

// The greater of two values (returns `a` on a tie).
pub fn max(comptime T: type, a: T, b: T) -> T {
    if a > b { a } else { b }
}

// Clamp `x` into the inclusive range `[lo, hi]`.
pub fn clamp(comptime T: type, x: T, lo: T, hi: T) -> T {
    if x < lo {
        lo
    } else if x > hi {
        hi
    } else {
        x
    }
}

// Whether two values are equal.
pub fn eq(comptime T: type, a: T, b: T) -> bool {
    a == b
}

// Whether two values are equal under `Equatable.equals`.
pub fn equals(comptime T: interfaces.Equatable, borrow a: T, borrow b: T) -> bool {
    a.equals(borrow b)
}

// Three-way compare under `Ordered.less`: `Less` when `a.less(b)`, `Greater`
// when `b.less(a)`, else `Equal`.
pub fn compare(comptime T: interfaces.Ordered, borrow a: T, borrow b: T) -> Ordering {
    if a.less(borrow b) {
        Ordering.Less
    } else if b.less(borrow a) {
        Ordering.Greater
    } else {
        Ordering.Equal
    }
}

// The lesser of two values under `Ordered.less` (returns `a` on a tie). The
// values are moved in and the chosen one is moved out.
pub fn min_by_order(comptime T: interfaces.Ordered, a: T, b: T) -> T {
    if b.less(borrow a) { b } else { a }
}

// The greater of two values under `Ordered.less` (returns `a` on a tie).
pub fn max_by_order(comptime T: interfaces.Ordered, a: T, b: T) -> T {
    if a.less(borrow b) { b } else { a }
}
