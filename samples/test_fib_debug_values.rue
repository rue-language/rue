fn fib_broken(n: i32) -> i32 {
    if n <= 1 {
        n
    } else {
        fib_broken(n - 1) + fib_broken(n - 2)
    }
}

fn fib_working(n: i32) -> i32 {
    if n <= 1 {
        n  
    } else {
        let result = fib_working(n - 1) + fib_working(n - 2);
        result
    }
}

fn main() -> i32 {
    let broken = fib_broken(3);   // Will be 4
    let working = fib_working(3);  // Will be 2
    broken * 100 + working  // 402 if hypothesis is correct
}