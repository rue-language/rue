fn fibonacci(n: i32) -> i32 {
    if n <= 1 {
        n
    } else {
        fibonacci(n - 1) + fibonacci(n - 2)
    }
}

fn main() -> i32 {
    // Test multiple fibonacci values
    println_i32(fibonacci(0));  // 0
    println_i32(fibonacci(1));  // 1
    println_i32(fibonacci(2));  // 1
    println_i32(fibonacci(3));  // 2
    println_i32(fibonacci(4));  // 3
    println_i32(fibonacci(5));  // 5
    println_i32(fibonacci(6));  // 8
    println_i32(fibonacci(7));  // 13
    println_i32(fibonacci(8));  // 21
    println_i32(fibonacci(9));  // 34
    println_i32(fibonacci(10)); // 55
    
    fibonacci(10)  // Return 55
}