fn test_basic_assignment() -> i32 {
    let x: i32 = 10;
    x = 20;
    x
}

fn test_assignment_with_expression() -> i32 {
    let a: i32 = 5;
    let b: i32 = 3;
    a = a + b * 2;
    a
}

fn test_assignment_in_while() -> i32 {
    let counter: i32 = 0;
    let sum: i32 = 0;
    while counter <= 3 {
        sum = sum + counter;
        counter = counter + 1;
    };
    sum
}

fn main() -> i32 {
    test_assignment_in_while()
}