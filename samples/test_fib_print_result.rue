fn print_and_return(label: i32, n: i32) -> i32 {
    // Just return n, but the call itself might cause issues
    n
}

fn fib(n: i32) -> i32 {
    if n <= 1 {
        n
    } else {
        let a = fib(n - 1);
        let b = fib(n - 2);
        print_and_return(n, a + b)
    }
}

fn main() -> i32 {
    fib(3)  // Should be 2
}