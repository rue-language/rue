fn fib_test(n: i32) -> i32 {
    if n <= 1 {
        n
    } else {
        999  // Don't recurse, just return a marker
    }
}

fn main() -> i32 {
    println_i32(fib_test(0));  // Should print 0
    println_i32(fib_test(1));  // Should print 1
    println_i32(fib_test(2));  // Should print 999
    0
}