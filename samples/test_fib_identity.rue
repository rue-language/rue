fn identity(x: i32) -> i32 {
    x
}

fn fib(n: i32) -> i32 {
    if n <= 1 {
        n
    } else {
        let a = fib(n - 1);
        let a_preserved = identity(a);  // Force a function call
        let b = fib(n - 2);
        a_preserved + b
    }
}

fn main() -> i32 {
    fib(5)  // Should return 5
}